 }
 
+void block_manager_readahead_note(block_manager_t *bm, block_manager_readahead_t *ra,
+                                  const uint64_t offset, const uint64_t len)
+{
+    if (!bm || !ra) return;
+
+    /* a read continues the scan when it ends past where the last one ended and starts no further
+     * than the gap beyond it -- overlapping the last read's tail, as a scan re-reading a block that
+     * straddled its buffer does, still moves forward */
+    const int continues = ra->run > 0 && offset + len > ra->next_offset &&
+                          offset <= ra->next_offset + BLOCK_MANAGER_READAHEAD_GAP;
+    if (continues)
+    {
+        ra->run++;
+    }
+    else
+    {
+        ra->run = 1;
+        ra->end = 0;
+        ra->window = 0;
+    }
+    ra->next_offset = offset + len;
+
+    /* one read says nothing about the next, and a lone point read through a scan's API -- a footer,
+     * a seek that stays in its leaf -- should cost no more than it reads */
+    if (ra->run < 2) return;
+
+    /* refill once the scan is half way through what is prefetched, so the next window is on its way
+     * before the scan reaches it */
+    const uint64_t read_end = offset + len;
+    if (ra->window && read_end + ra->window / 2 <= ra->end) return;
+
+    if (ra->window == 0)
+        ra->window = BLOCK_MANAGER_READAHEAD_MIN;
+    else if (ra->window < BLOCK_MANAGER_READAHEAD_MAX)
+        ra->window *= 2;
+
+    const uint64_t from = ra->end > read_end ? ra->end : read_end;
+    uint64_t to = read_end + ra->window;
+    /* nothing past the data is worth fetching -- a file's tail is preallocated zeroes */
+    const uint64_t extent = atomic_load_explicit(&bm->current_file_size, memory_order_relaxed);
+    if (to > extent) to = extent;
+    /* linux reads at most the device's readahead size (max of read_ahead_kb and max_sectors_kb,
+     * 128 KiB by default) per WILLNEED and drops the rest of the range, so a window goes out in
+     * pieces no larger than that */
+    for (uint64_t at = from; at < to; at += BLOCK_MANAGER_READAHEAD_CHUNK)
+    {
+        const uint64_t n =
+            to - at < BLOCK_MANAGER_READAHEAD_CHUNK ? to - at : BLOCK_MANAGER_READAHEAD_CHUNK;
+        (void)set_file_readahead(bm->fd, at, n);
+    }
+    ra->end = to;
+}
+
