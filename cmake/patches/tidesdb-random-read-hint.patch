diff --git a/src/platform/platform_fs_sys.h b/src/platform/platform_fs_sys.h
index a1413b1..caf7cde 100644
--- a/src/platform/platform_fs_sys.h
+++ b/src/platform/platform_fs_sys.h
@@ -98,23 +98,53 @@ static inline int tdb_preallocate_extent(int fd, off_t offset, off_t len)
 }
 
 /*
- * set_file_sequential_hint
- * hints to the OS that file access will be sequential for read-ahead optimization
+ * set_file_random_hint
+ * tells the OS that reads of this descriptor land at unrelated offsets, so a read fetches what it
+ * asks for and nothing after it. the advice belongs to the open file, which every reader of a block
+ * manager shares, and almost every read is a point read -- a value from a value log segment, a node
+ * from a klog -- that kernel readahead would pad with the bytes that follow. a 256 KiB value read
+ * cold cost twice its size in disk reads without it. a sequential scan asks for its readahead
+ * explicitly, per range, with set_file_readahead, which this advice does not disable
  * @param fd the file descriptor
- * @return 0 on success, -1 on failure (non-critical, can be ignored)
+ * @return 0 on success, -1 or an error number on failure (non-critical, can be ignored)
  */
-static inline int set_file_sequential_hint(int fd)
+static inline int set_file_random_hint(int fd)
 {
 #ifdef __linux__
-    return posix_fadvise(fd, 0, 0, POSIX_FADV_SEQUENTIAL);
+    return posix_fadvise(fd, 0, 0, POSIX_FADV_RANDOM);
 #elif defined(__APPLE__)
-    return fcntl(fd, F_RDAHEAD, 1);
-#elif defined(_WIN32)
-    /* _O_SEQUENTIAL flag set at open time via compat.h wrapper */
-    (void)fd; /* unused on Windows */
+    return fcntl(fd, F_RDAHEAD, 0);
+#else
+    /* windows opens every file with _O_SEQUENTIAL (compat.h); other platforms keep their default */
+    (void)fd;
     return 0;
+#endif
+}
+
+/*
+ * set_file_readahead
+ * starts reading [offset, offset + len) into the page cache without waiting for it, for a scan
+ * about to read that range in order. unlike a file-wide sequential hint this leaves the other
+ * readers of the descriptor alone, so a compaction or a recovery scan does not turn on readahead for
+ * the point reads sharing its file
+ * @param fd the file descriptor
+ * @param offset the first byte to fetch
+ * @param len how many bytes to fetch
+ * @return 0 on success, -1 or an error number on failure (non-critical, can be ignored)
+ */
+static inline int set_file_readahead(int fd, uint64_t offset, uint64_t len)
+{
+#ifdef __linux__
+    return posix_fadvise(fd, (off_t)offset, (off_t)len, POSIX_FADV_WILLNEED);
+#elif defined(__APPLE__)
+    struct radvisory ra;
+    ra.ra_offset = (off_t)offset;
+    ra.ra_count = len > 0x7fffffffu ? 0x7fffffff : (int)len;
+    return fcntl(fd, F_RDADVISE, &ra);
 #else
-    (void)fd; /* unused on other platforms */
+    (void)fd;
+    (void)offset;
+    (void)len;
     return 0;
 #endif
 }
