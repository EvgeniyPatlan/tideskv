diff --git a/test/random_read__tests.c b/test/random_read__tests.c
new file mode 100644
index 0000000..44ce5a2
--- /dev/null
+++ b/test/random_read__tests.c
@@ -0,0 +1,399 @@
+/**
+ *
+ * Copyright (c) 2022-2026 TidesDB Corp. and/or its affiliates.
+ *
