+/**
+ * block_manager_readahead_t
+ * the readahead state of one scan over one file. every file is opened with readahead off, since
+ * nearly every read of it is a point read, so a scan reading in order asks for its own: once two
+ * reads in a row move forward through the file, it prefetches a window past the latest one, and
+ * doubles the window each time it refills it, from BLOCK_MANAGER_READAHEAD_MIN up to
+ * BLOCK_MANAGER_READAHEAD_MAX. a read that ends before the last one did, or starts more than
+ * BLOCK_MANAGER_READAHEAD_GAP past its end, starts over. zeroed is the initial state
+ * @param next_offset where the previous read ended, the offset a read continuing it starts at
+ * @param end where the prefetched range ends
+ * @param window bytes the next refill prefetches, 0 before the scan has proven sequential
+ * @param run forward reads in a row so far
+ */
+typedef struct
+{
+    uint64_t next_offset;
+    uint64_t end;
+    uint64_t window;
+    uint32_t run;
+} block_manager_readahead_t;
+
+/* the first readahead window a sequential scan prefetches, and the largest it grows to. the cap
+ * matches RocksDB's compaction_readahead_size default */
+#define BLOCK_MANAGER_READAHEAD_MIN (64u * 1024u)
+#define BLOCK_MANAGER_READAHEAD_MAX (2u * 1024u * 1024u)
+
+/* the most one prefetch request asks for, the kernel's default readahead size, past which linux
+ * silently truncates a WILLNEED */
+#define BLOCK_MANAGER_READAHEAD_CHUNK (128u * 1024u)
+
+/* how far past the end of the previous read a read may start and still count as continuing it, so a
+ * scan skipping the btree's internal nodes between two leaves stays sequential */
+#define BLOCK_MANAGER_READAHEAD_GAP BLOCK_MANAGER_READAHEAD_MAX
+
