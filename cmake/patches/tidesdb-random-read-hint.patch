+
+/* what a cold point read costs in disk reads, and that the scans which read a file in order still
+ * prefetch. a file's residency in the page cache is observable with mincore and resettable with
+ * POSIX_FADV_DONTNEED, so a test drops a file's pages, does one read, and counts what came in. the
+ * residency checks are linux only; elsewhere those tests pass without checking anything */
+
+#include <dirent.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../src/base/encoding/encoding.h"
+#include "../src/base/errors.h"
+#include "../src/io/block_manager.h"
+#include "../src/sstable/vlog.h"
+#include "test_utils.h"
+
+#ifdef __linux__
+#include <sys/mman.h>
+#define RR_RESIDENCY 1
+#else
+#define RR_RESIDENCY 0
+#endif
+
+static int tests_passed = 0;
+static int tests_failed = 0;
+
+#define RR_DIR      "." PATH_SEPARATOR "test_random_read_db"
+#define RR_DIR_MODE 0755
+#define RR_FILE     RR_DIR PATH_SEPARATOR "blocks"
+#define RR_PAGE     4096u
+
+/* a large value, as a separated value or a merge source's run of blocks would be, and enough of them
+ * that a read in the middle has neighbours on both sides for readahead to pull in */
+#define RR_BLOCK_BYTES (256u * 1024u)
+#define RR_BLOCKS      16
+#define RR_MIDDLE      7
+
+/* how long a test waits for a prefetch it issued to land, polling */
+#define RR_PREFETCH_WAIT_US  (5 * 1000 * 1000)
+#define RR_PREFETCH_POLL_US  1000
+
+/* the user codec the value log test stores through, with an id past the built-ins */
+#define RR_CODEC_ID   TDB_ENCODING_ID_USER_MIN
+#define RR_CODEC_NAME "rr-halves"
+
+static void fresh_dir(void)
+{
+    (void)remove_directory(RR_DIR);
+    (void)mkdir(RR_DIR, RR_DIR_MODE);
+}
+
+static void fill(uint8_t *b, size_t n, unsigned seed)
+{
+    uint32_t s = seed * 2654435761u + 1;
+    for (size_t i = 0; i < n; i++)
+    {
+        s ^= s << 13;
+        s ^= s >> 17;
+        s ^= s << 5;
+        b[i] = (uint8_t)(s >> 24);
+    }
+}
+
+static uint64_t pages_spanned(uint64_t offset, uint64_t len)
+{
+    return (offset + len + RR_PAGE - 1) / RR_PAGE - offset / RR_PAGE;
+}
+
+#if RR_RESIDENCY
+/* pages of [from, to) the page cache holds; to == 0 means the whole file */
+static uint64_t resident_pages(const char *path, uint64_t from, uint64_t to)
+{
+    const int fd = open(path, O_RDONLY);
+    ASSERT_TRUE(fd >= 0);
+    struct stat st;
+    ASSERT_TRUE(fstat(fd, &st) == 0);
+    const uint64_t size = (uint64_t)st.st_size;
+    if (to == 0 || to > size) to = size;
+    uint64_t count = 0;
+    if (size > 0 && from < to)
+    {
+        void *map = mmap(NULL, (size_t)size, PROT_READ, MAP_SHARED, fd, 0);
+        ASSERT_TRUE(map != MAP_FAILED);
+        const size_t pages = (size_t)((size + RR_PAGE - 1) / RR_PAGE);
+        unsigned char *vec = malloc(pages);
+        ASSERT_TRUE(vec != NULL);
+        ASSERT_TRUE(mincore(map, (size_t)size, vec) == 0);
+        for (uint64_t p = from / RR_PAGE; p < (to + RR_PAGE - 1) / RR_PAGE; p++) count += vec[p] & 1;
+        free(vec);
+        munmap(map, (size_t)size);
+    }
+    close(fd);
+    return count;
+}
+
+/* drop the file's pages from the page cache; 0 when it could, so a filesystem that keeps them (a
+ * tmpfs) skips the residency checks rather than failing them */
+static int evict(const char *path)
+{
+    const int fd = open(path, O_RDONLY);
+    ASSERT_TRUE(fd >= 0);
+    (void)fdatasync(fd);
+    (void)posix_fadvise(fd, 0, 0, POSIX_FADV_DONTNEED);
+    close(fd);
+    if (resident_pages(path, 0, 0) == 0) return 0;
+    printf("(page cache kept %s, residency not checked) ", path);
+    return -1;
+}
+#endif
+
+/* write RR_BLOCKS blocks of RR_BLOCK_BYTES, recording each block's offset */
+static block_manager_t *write_blocks(int64_t *offsets)
+{
+    fresh_dir();
+    block_manager_t *bm = NULL;
+    ASSERT_TRUE(block_manager_open(&bm, RR_FILE, BLOCK_MANAGER_SYNC_NONE) == 0);
+    uint8_t *data = malloc(RR_BLOCK_BYTES);
+    ASSERT_TRUE(data != NULL);
+    for (int i = 0; i < RR_BLOCKS; i++)
+    {
+        fill(data, RR_BLOCK_BYTES, (unsigned)i + 1);
+        block_manager_block_t *b = block_manager_block_create(RR_BLOCK_BYTES, data);
+        ASSERT_TRUE(b != NULL);
+        offsets[i] = block_manager_block_write(bm, b);
+        ASSERT_TRUE(offsets[i] >= 0);
+        block_manager_block_free(b);
+    }
+    free(data);
+    return bm;
+}
+
+#if RR_RESIDENCY
+/* a cold point read of the middle block brings in that block's pages and nothing past them */
+static void assert_point_read_is_exact(block_manager_t *bm, const int64_t *offsets)
+{
+    if (evict(RR_FILE) != 0) return;
+    uint32_t got = 0;
+    ASSERT_TRUE(block_manager_borrow_block_data_at_offset(bm, (uint64_t)offsets[RR_MIDDLE],
+                                                          RR_BLOCK_BYTES, &got) != NULL);
+    ASSERT_EQ(got, RR_BLOCK_BYTES);
+    const uint64_t frame = block_manager_framed_size(RR_BLOCK_BYTES);
+    ASSERT_TRUE(resident_pages(RR_FILE, 0, 0) <= pages_spanned((uint64_t)offsets[RR_MIDDLE], frame));
+}
+#endif
+
+void test_point_read_fetches_only_its_block(void)
+{
+    int64_t offsets[RR_BLOCKS];
+    block_manager_t *bm = write_blocks(offsets);
+#if RR_RESIDENCY
+    assert_point_read_is_exact(bm, offsets);
+#endif
+    ASSERT_TRUE(block_manager_close(bm) == 0);
+    (void)remove_directory(RR_DIR);
+}
+
+/* the scans that used to switch the shared descriptor to sequential readahead -- a heap cursor, as
+ * the manifest replay uses, and a count over the file -- and a reopen, which revalidates the file,
+ * leave the next point read as cheap as the first */
+void test_point_read_stays_exact_after_scans_and_reopen(void)
+{
+    int64_t offsets[RR_BLOCKS];
+    block_manager_t *bm = write_blocks(offsets);
+
+    block_manager_cursor_t *c = NULL;
+    ASSERT_TRUE(block_manager_cursor_init(&c, bm) == 0);
+    int seen = 0;
+    block_manager_block_t *b;
+    while ((b = block_manager_cursor_read_and_advance(c)) != NULL)
+    {
+        block_manager_block_free(b);
+        seen++;
+    }
+    block_manager_cursor_free(c);
+    ASSERT_EQ(seen, RR_BLOCKS);
+    ASSERT_EQ(block_manager_count_blocks(bm), RR_BLOCKS);
+#if RR_RESIDENCY
+    assert_point_read_is_exact(bm, offsets);
+#endif
+
+    ASSERT_TRUE(block_manager_close(bm) == 0);
+    ASSERT_TRUE(block_manager_open(&bm, RR_FILE, BLOCK_MANAGER_SYNC_NONE) == 0);
+#if RR_RESIDENCY
+    assert_point_read_is_exact(bm, offsets);
+#endif
+    ASSERT_TRUE(block_manager_close(bm) == 0);
+    (void)remove_directory(RR_DIR);
+}
+
+/* a cursor reading the file in order prefetches past what it has read, with readahead off on the
+ * descriptor: two reads in, the bytes after the second block arrive without anyone reading them */
+void test_cursor_scan_prefetches_ahead(void)
+{
+    int64_t offsets[RR_BLOCKS];
+    block_manager_t *bm = write_blocks(offsets);
+#if RR_RESIDENCY
+    if (evict(RR_FILE) == 0)
+    {
+        block_manager_cursor_t c;
+        ASSERT_TRUE(block_manager_cursor_init_stack(&c, bm) == 0);
+        for (int i = 0; i < 2; i++)
+        {
+            block_manager_block_t *b = block_manager_cursor_read_and_advance(&c);
+            ASSERT_TRUE(b != NULL);
+            block_manager_block_free(b);
+        }
+        /* the prefetch is asynchronous; wait for its first window, entirely past the bytes read */
+        const uint64_t from = ((uint64_t)offsets[2] / RR_PAGE + 1) * RR_PAGE;
+        const uint64_t to = from + BLOCK_MANAGER_READAHEAD_MIN / 2;
+        const uint64_t want = (to - from) / RR_PAGE;
+        int waited = 0;
+        while (resident_pages(RR_FILE, from, to) < want && waited < RR_PREFETCH_WAIT_US)
+        {
+            usleep(RR_PREFETCH_POLL_US);
+            waited += RR_PREFETCH_POLL_US;
+        }
+        ASSERT_EQ(resident_pages(RR_FILE, from, to), want);
+    }
+#endif
+    ASSERT_TRUE(block_manager_close(bm) == 0);
+    (void)remove_directory(RR_DIR);
+}
+
+/* the window logic on its own, against a handle whose prefetches go nowhere that matters: a lone
+ * read prefetches nothing, a second read continuing it opens the minimum window, refills double
+ * it up to the cap, and a read going backwards or jumping far ahead starts over */
+void test_readahead_window_grows_and_resets(void)
+{
+    int64_t offsets[RR_BLOCKS];
+    block_manager_t *bm = write_blocks(offsets);
+    block_manager_readahead_t ra = {0};
+    const uint64_t len = 4096;
+
+    block_manager_readahead_note(bm, &ra, 0, len);
+    ASSERT_EQ(ra.run, 1u);
+    ASSERT_EQ(ra.window, 0u);
+    ASSERT_EQ(ra.end, 0u);
+
+    block_manager_readahead_note(bm, &ra, len, len);
+    ASSERT_EQ(ra.run, 2u);
+    ASSERT_EQ(ra.window, (uint64_t)BLOCK_MANAGER_READAHEAD_MIN);
+    ASSERT_EQ(ra.end, 2 * len + BLOCK_MANAGER_READAHEAD_MIN);
+
+    /* well inside the window: no refill */
+    block_manager_readahead_note(bm, &ra, 2 * len, len);
+    ASSERT_EQ(ra.window, (uint64_t)BLOCK_MANAGER_READAHEAD_MIN);
+
+    /* a scan with gaps between its reads (internal nodes between leaves) and re-reads overlapping
+     * the last read's tail both still count as continuing, and the window keeps doubling */
+    uint64_t at = 3 * len;
+    for (int i = 0; i < 512; i++)
+    {
+        block_manager_readahead_note(bm, &ra, at, len);
+        at += (i % 2) ? 2 * len : len / 2;
+    }
+    ASSERT_EQ(ra.window, (uint64_t)BLOCK_MANAGER_READAHEAD_MAX);
+    ASSERT_TRUE(ra.end > at);
+    ASSERT_TRUE(ra.run > 500u);
+
+    /* backwards: the read ends before the last one did */
+    block_manager_readahead_note(bm, &ra, 0, len);
+    ASSERT_EQ(ra.run, 1u);
+    ASSERT_EQ(ra.window, 0u);
+
+    /* far ahead: past the gap */
+    block_manager_readahead_note(bm, &ra, len, len);
+    ASSERT_EQ(ra.run, 2u);
+    block_manager_readahead_note(bm, &ra, 2 * len + BLOCK_MANAGER_READAHEAD_GAP + 1, len);
+    ASSERT_EQ(ra.run, 1u);
+    ASSERT_EQ(ra.window, 0u);
+
+    ASSERT_TRUE(block_manager_close(bm) == 0);
+    (void)remove_directory(RR_DIR);
+}
+
+/* a codec storing a value made of two equal halves as one half: compressible by exactly two without
+ * depending on which compression libraries the build has */
+static int halves_encode(void *ctx, const uint8_t *src, size_t n, uint8_t **dst, size_t *dst_n)
+{
+    (void)ctx;
+    if (n % 2 || memcmp(src, src + n / 2, n / 2) != 0) return TDB_ERR_INVALID_ARGS;
+    *dst = malloc(n / 2);
+    if (!*dst) return TDB_ERR_MEMORY;
+    memcpy(*dst, src, n / 2);
+    *dst_n = n / 2;
+    return TDB_SUCCESS;
+}
+
+static int halves_decode(void *ctx, const uint8_t *src, size_t n, uint8_t **dst, size_t *dst_n)
+{
+    (void)ctx;
+    *dst = malloc(2 * n);
+    if (!*dst) return TDB_ERR_MEMORY;
+    memcpy(*dst, src, n);
+    memcpy(*dst + n, src, n);
+    *dst_n = 2 * n;
+    return TDB_SUCCESS;
+}
+
+#if RR_RESIDENCY
+/* the one segment file the store wrote */
+static void segment_path(char *out, size_t cap)
+{
+    DIR *d = opendir(RR_DIR);
+    ASSERT_TRUE(d != NULL);
+    struct dirent *e;
+    int found = 0;
+    while ((e = readdir(d)) != NULL)
+    {
+        const size_t n = strlen(e->d_name);
+        if (n > 5 && strcmp(e->d_name + n - 5, ".vlog") == 0)
+        {
+            snprintf(out, cap, "%s%s%s", RR_DIR, PATH_SEPARATOR, e->d_name);
+            found++;
+        }
+    }
+    closedir(d);
+    ASSERT_EQ(found, 1);
+}
+#endif
+
+/* a compressed value read cold costs what it occupies on disk, not its decoded length: the read
+ * used to ask for the decoded length and pulled in that much of the values stored after it */
+void test_compressed_value_read_fetches_its_stored_bytes(void)
+{
+    fresh_dir();
+    tidesdb_encoding_registry_t reg;
+    ASSERT_TRUE(tidesdb_encoding_registry_init(&reg) == TDB_SUCCESS);
+    ASSERT_TRUE(tidesdb_encoding_register(&reg, RR_CODEC_NAME, RR_CODEC_ID, halves_encode,
+                                          halves_decode, NULL) == TDB_SUCCESS);
+    const vlog_config_t cfg = {
+        .encodings = &reg, .sync_mode = BLOCK_MANAGER_SYNC_NONE, .segment_target_bytes = 0};
+    vlog_t *v = NULL;
+    ASSERT_TRUE(vlog_open(RR_DIR, &cfg, &v) == VLOG_OK);
+
+    const uint8_t ids[1] = {RR_CODEC_ID};
+    uint8_t *val = malloc(RR_BLOCK_BYTES);
+    ASSERT_TRUE(val != NULL);
+    vlog_id_t vid[RR_BLOCKS];
+    uint64_t disk[RR_BLOCKS];
+    for (int i = 0; i < RR_BLOCKS; i++)
+    {
+        fill(val, RR_BLOCK_BYTES / 2, (unsigned)i + 1);
+        memcpy(val + RR_BLOCK_BYTES / 2, val, RR_BLOCK_BYTES / 2);
+        ASSERT_TRUE(vlog_write(v, val, RR_BLOCK_BYTES, ids, 1, &vid[i], &disk[i]) == VLOG_OK);
+        ASSERT_TRUE(disk[i] < RR_BLOCK_BYTES / 2 + RR_PAGE); /* it really was stored halved */
+    }
+
+#if RR_RESIDENCY
+    char path[1024];
+    segment_path(path, sizeof(path));
+    if (evict(path) == 0)
+    {
+        uint8_t *got = NULL;
+        size_t got_n = 0;
+        ASSERT_TRUE(vlog_read(v, vid[RR_MIDDLE], &got, &got_n) == VLOG_OK);
+        ASSERT_EQ(got_n, RR_BLOCK_BYTES);
+        free(got);
+        /* one extra page for the frame straddling a page boundary at either end */
+        ASSERT_TRUE(resident_pages(path, 0, 0) <= disk[RR_MIDDLE] / RR_PAGE + 2);
+    }
+#endif
+
+    /* and every value still decodes to itself */
+    for (int i = 0; i < RR_BLOCKS; i++)
+    {
+        fill(val, RR_BLOCK_BYTES / 2, (unsigned)i + 1);
+        memcpy(val + RR_BLOCK_BYTES / 2, val, RR_BLOCK_BYTES / 2);
+        uint8_t *got = NULL;
+        size_t got_n = 0;
+        ASSERT_TRUE(vlog_read(v, vid[i], &got, &got_n) == VLOG_OK);
+        ASSERT_EQ(got_n, RR_BLOCK_BYTES);
+        ASSERT_EQ(memcmp(got, val, RR_BLOCK_BYTES), 0);
+        free(got);
+    }
+    free(val);
+    vlog_close(v);
+    (void)remove_directory(RR_DIR);
+}
+
+int main(int argc, char **argv)
+{
+    INIT_TEST_FILTER(argc, argv);
+    RUN_TEST(test_point_read_fetches_only_its_block, tests_passed);
+    RUN_TEST(test_point_read_stays_exact_after_scans_and_reopen, tests_passed);
+    RUN_TEST(test_cursor_scan_prefetches_ahead, tests_passed);
+    RUN_TEST(test_readahead_window_grows_and_resets, tests_passed);
+    RUN_TEST(test_compressed_value_read_fetches_its_stored_bytes, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
