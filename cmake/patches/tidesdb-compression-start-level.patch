+
+/* compression_start_level: the first level whose tables carry the family's encoding pipeline. the
+ * flush tier is level 1, so a start level of 2 writes flushes verbatim and encodes what a merge
+ * writes below them. each table records the pipeline it was written with in its own footer, which is
+ * what the reader decodes by, so tables of both kinds sit in one family and stay readable */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../src/base/errors.h"
+#include "../src/column_family/cf_config.h"
+#include "test_utils.h"
+
+static int tests_passed = 0;
+static int tests_failed = 0;
+
+#define CSL_DIR    "." PATH_SEPARATOR "test_compression_start_level_db"
+#define CSL_BATCH  64
+#define CSL_BATCHES 4
+
+static int lz4_available(void)
+{
+    return tidesdb_compression_available(TDB_COMPRESS_LZ4) != 0;
+}
+
+static tidesdb_t *csl_open(void)
+{
+    static char path[] = CSL_DIR;
+    tidesdb_config_t cfg = tidesdb_default_config();
+    cfg.db_path = path;
+    tidesdb_t *db = NULL;
+    ASSERT_EQ(tidesdb_open(&cfg, &db), TDB_SUCCESS);
+    return db;
+}
+
+static tidesdb_column_family_t *csl_create_cf(tidesdb_t *db, int start_level)
+{
+    tidesdb_column_family_config_t cc = tidesdb_default_column_family_config();
+    cc.encoding_pipeline[0] = TDB_COMPRESS_LZ4;
+    cc.encoding_count = 1;
+    cc.compression_start_level = start_level;
+    cc.l1_file_count_trigger = 100; /* no background merge until the test asks for one */
+    ASSERT_EQ(tidesdb_create_column_family(db, "kv", &cc), TDB_SUCCESS);
+    tidesdb_column_family_t *cf = tidesdb_get_column_family(db, "kv");
+    ASSERT_TRUE(cf != NULL);
+    return cf;
+}
+
+static void csl_key(char *buf, size_t cap, int batch, int i)
+{
+    snprintf(buf, cap, "key-%d-%05d", batch, i);
+}
+
+/* writes one batch of compressible values and flushes it to its own level-1 table */
+static void csl_write_batch(tidesdb_t *db, tidesdb_column_family_t *cf, int batch)
+{
+    char value[200];
+    memset(value, 'v', sizeof(value));
+    for (int i = 0; i < CSL_BATCH; i++)
+    {
+        char key[32];
+        csl_key(key, sizeof(key), batch, i);
+        tidesdb_txn_t *t = NULL;
+        ASSERT_EQ(tidesdb_txn_begin(db, &t), TDB_SUCCESS);
+        ASSERT_EQ(tidesdb_txn_put(t, cf, (const uint8_t *)key, strlen(key), (const uint8_t *)value,
+                                  sizeof(value), -1),
+                  TDB_SUCCESS);
+        ASSERT_EQ(tidesdb_txn_commit(t), TDB_SUCCESS);
+        tidesdb_txn_free(t);
+    }
+    ASSERT_EQ(tidesdb_flush_memtable(db), TDB_SUCCESS);
+}
+
+static void csl_check_all_readable(tidesdb_t *db, tidesdb_column_family_t *cf, int batches)
+{
+    for (int b = 0; b < batches; b++)
+    {
+        for (int i = 0; i < CSL_BATCH; i++)
+        {
+            char key[32];
+            csl_key(key, sizeof(key), b, i);
+            tidesdb_txn_t *t = NULL;
+            ASSERT_EQ(tidesdb_txn_begin(db, &t), TDB_SUCCESS);
+            uint8_t *got = NULL;
+            size_t got_size = 0;
+            ASSERT_EQ(tidesdb_txn_get(t, cf, (const uint8_t *)key, strlen(key), &got, &got_size),
+                      TDB_SUCCESS);
+            ASSERT_EQ((int)got_size, 200);
+            ASSERT_EQ((int)got[0], 'v');
+            tidesdb_free(got);
+            tidesdb_txn_free(t);
+        }
+    }
+}
+
+typedef struct
+{
+    tidesdb_encoding_stats_t chains[TDB_MAX_ENCODING_CHAINS];
+    size_t n;
+} csl_chains_t;
+
+static void csl_chains(tidesdb_t *db, csl_chains_t *out)
+{
+    out->n = 0;
+    ASSERT_EQ(tidesdb_get_klog_encoding_stats(db, out->chains, TDB_MAX_ENCODING_CHAINS, &out->n),
+              TDB_SUCCESS);
+}
+
+/* the number of tables, across every chain, written with the given pipeline length */
+static uint64_t csl_tables_with(const csl_chains_t *c, int id_count, int id)
+{
+    uint64_t n = 0;
+    for (size_t i = 0; i < c->n; i++)
+    {
+        if (c->chains[i].id_count != id_count) continue;
+        if (id_count > 0 && c->chains[i].ids[0] != id) continue;
+        n += c->chains[i].item_count;
+    }
+    return n;
+}
+
+static uint64_t csl_tables(const csl_chains_t *c)
+{
+    uint64_t n = 0;
+    for (size_t i = 0; i < c->n; i++) n += c->chains[i].item_count;
+    return n;
+}
+
+/* start level 2: the level-1 flush outputs have no codec in their footer pipeline, what a merge
+ * writes below them has LZ4, and every key reads back at each step */
+void test_start_level_skips_upper_levels(void)
+{
+    if (!lz4_available())
+    {
+        printf("(skipped: no lz4) ");
+        return;
+    }
+    (void)remove_directory(CSL_DIR);
+    tidesdb_t *db = csl_open();
+    tidesdb_column_family_t *cf = csl_create_cf(db, 2);
+    for (int b = 0; b < CSL_BATCHES; b++) csl_write_batch(db, cf, b);
+
+    csl_chains_t c;
+    csl_chains(db, &c);
+    ASSERT_TRUE(csl_tables(&c) >= 1);
+    ASSERT_EQ(csl_tables_with(&c, 0, 0), csl_tables(&c)); /* every flush output is verbatim */
+    csl_check_all_readable(db, cf, CSL_BATCHES);
+
+    ASSERT_EQ(tidesdb_compact(db, cf), TDB_SUCCESS);
+    csl_chains(db, &c);
+    ASSERT_TRUE(csl_tables(&c) >= 1);
+    ASSERT_EQ(csl_tables_with(&c, 1, TDB_COMPRESS_LZ4), csl_tables(&c)); /* merge outputs are lz4 */
+    csl_check_all_readable(db, cf, CSL_BATCHES);
+
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(CSL_DIR);
+}
+
+/* the default, 0, encodes every level including the flush tier, which is what the field's
+ * absence did before, so the case above is not passing because flushes are never compressed */
+void test_start_level_zero_encodes_every_level(void)
+{
+    if (!lz4_available())
+    {
+        printf("(skipped: no lz4) ");
+        return;
+    }
+    (void)remove_directory(CSL_DIR);
+    tidesdb_t *db = csl_open();
+    tidesdb_column_family_t *cf = csl_create_cf(db, 0);
+    for (int b = 0; b < CSL_BATCHES; b++) csl_write_batch(db, cf, b);
+
+    csl_chains_t c;
+    csl_chains(db, &c);
+    ASSERT_TRUE(csl_tables(&c) >= 1);
+    ASSERT_EQ(csl_tables_with(&c, 1, TDB_COMPRESS_LZ4), csl_tables(&c));
+    csl_check_all_readable(db, cf, CSL_BATCHES);
+
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(CSL_DIR);
+}
+
+/* the setting is stored with the family, so a reopen keeps it, a runtime update changes it and
+ * persists, and a family opened over tables of both kinds reads them all */
+void test_start_level_persists(void)
+{
+    if (!lz4_available())
+    {
+        printf("(skipped: no lz4) ");
+        return;
+    }
+    (void)remove_directory(CSL_DIR);
+    tidesdb_t *db = csl_open();
+    tidesdb_column_family_t *cf = csl_create_cf(db, 2);
+    csl_write_batch(db, cf, 0);
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+
+    db = csl_open();
+    cf = tidesdb_get_column_family(db, "kv");
+    ASSERT_TRUE(cf != NULL);
+    tidesdb_cf_stats_t st;
+    memset(&st, 0, sizeof(st));
+    ASSERT_EQ(tidesdb_get_cf_stats(cf, &st), TDB_SUCCESS);
+    ASSERT_EQ(st.config.compression_start_level, 2);
+
+    /* change it and write a table under the new setting beside the old one */
+    tidesdb_column_family_config_t cc = st.config;
+    cc.compression_start_level = 0;
+    ASSERT_EQ(tidesdb_cf_update_runtime_config(db, cf, &cc, 1), TDB_SUCCESS);
+    csl_write_batch(db, cf, 1);
+    csl_chains_t c;
+    csl_chains(db, &c);
+    ASSERT_EQ(csl_tables_with(&c, 0, 0), 1u);
+    ASSERT_EQ(csl_tables_with(&c, 1, TDB_COMPRESS_LZ4), 1u);
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+
+    db = csl_open();
+    cf = tidesdb_get_column_family(db, "kv");
+    ASSERT_TRUE(cf != NULL);
+    memset(&st, 0, sizeof(st));
+    ASSERT_EQ(tidesdb_get_cf_stats(cf, &st), TDB_SUCCESS);
+    ASSERT_EQ(st.config.compression_start_level, 0);
+    csl_check_all_readable(db, cf, 2);
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(CSL_DIR);
+}
+
+/* a level the tree cannot have is refused, on create and on a runtime update alike */
+void test_start_level_rejects_out_of_range(void)
+{
+    (void)remove_directory(CSL_DIR);
+    tidesdb_t *db = csl_open();
+    tidesdb_column_family_t *cf = csl_create_cf(db, 0);
+    tidesdb_cf_stats_t st;
+    memset(&st, 0, sizeof(st));
+    ASSERT_EQ(tidesdb_get_cf_stats(cf, &st), TDB_SUCCESS);
+    tidesdb_column_family_config_t cc = st.config;
+    cc.compression_start_level = -1;
+    ASSERT_EQ(tidesdb_cf_update_runtime_config(db, cf, &cc, 0), TDB_ERR_INVALID_ARGS);
+    cc.compression_start_level = TDB_MAX_LEVELS + 1;
+    ASSERT_EQ(tidesdb_cf_update_runtime_config(db, cf, &cc, 0), TDB_ERR_INVALID_ARGS);
+    cc.compression_start_level = TDB_MAX_LEVELS;
+    ASSERT_EQ(tidesdb_cf_update_runtime_config(db, cf, &cc, 0), TDB_SUCCESS);
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(CSL_DIR);
+}
+
+/* the manifest blob of a default config is byte for byte what it was before the field existed, and
+ * one that carries a start level adds only a tail after the pipeline, which a decoder that stops at
+ * the pipeline never reads. a blob without the tail decodes as 0 */
+void test_start_level_blob_is_compatible(void)
+{
+    tidesdb_column_family_config_t in = tidesdb_default_column_family_config();
+    snprintf(in.name, sizeof(in.name), "%s", "kv");
+    in.encoding_pipeline[0] = TDB_COMPRESS_LZ4;
+    in.encoding_count = 1;
+
+    uint8_t *plain = NULL;
+    size_t plain_len = 0;
+    ASSERT_EQ(cf_config_serialize(&in, &plain, &plain_len), 0);
+    ASSERT_EQ((int)plain_len, CF_CONFIG_BLOB_FIXED_SIZE + 1);
+
+    tidesdb_column_family_config_t out;
+    memset(&out, 0, sizeof(out));
+    out.compression_start_level = 5; /* decode must overwrite it, not leave it */
+    ASSERT_EQ(cf_config_deserialize(plain, plain_len, &out), 0);
+    ASSERT_EQ(out.compression_start_level, 0);
+
+    in.compression_start_level = 1; /* encodes every level like 0, so it adds no tail either */
+    uint8_t *one = NULL;
+    size_t one_len = 0;
+    ASSERT_EQ(cf_config_serialize(&in, &one, &one_len), 0);
+    ASSERT_EQ(one_len, plain_len);
+    ASSERT_EQ(memcmp(plain, one, plain_len), 0);
+    free(one);
+
+    in.compression_start_level = 3;
+    uint8_t *tailed = NULL;
+    size_t tailed_len = 0;
+    ASSERT_EQ(cf_config_serialize(&in, &tailed, &tailed_len), 0);
+    ASSERT_EQ((int)tailed_len, (int)plain_len + CF_CONFIG_BLOB_START_LEVEL_SIZE);
+    ASSERT_EQ(memcmp(plain, tailed, plain_len), 0); /* the shared prefix is unchanged */
+    memset(&out, 0, sizeof(out));
+    ASSERT_EQ(cf_config_deserialize(tailed, tailed_len, &out), 0);
+    ASSERT_EQ(out.compression_start_level, 3);
+    ASSERT_EQ(cf_config_deserialize(tailed, plain_len, &out), 0); /* old reader's view of it */
+    ASSERT_EQ(out.compression_start_level, 0);
+
+    free(plain);
+    free(tailed);
+}
+
+int main(int argc, char **argv)
+{
+    INIT_TEST_FILTER(argc, argv);
+    RUN_TEST_HANDLE_BALANCED(test_start_level_skips_upper_levels, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_start_level_zero_encodes_every_level, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_start_level_persists, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_start_level_rejects_out_of_range, tests_passed);
+    RUN_TEST(test_start_level_blob_is_compatible, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
