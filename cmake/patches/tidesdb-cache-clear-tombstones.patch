+
+/* lock-free readers racing writers that churn the table hard enough to rebuild it many times, each
+ * rebuild filling the spare table and swapping it in while readers probe the published one, or a
+ * stale one: a hit always carries the requested key's payload, and once the threads are done every
+ * live entry is reachable */
+#define CHURN_STRESS_READERS  4
+#define CHURN_STRESS_WRITERS  2
+#define CHURN_STRESS_KEYSPACE 4096
+#define CHURN_STRESS_PUTS     60000
+#define CHURN_STRESS_GETS     200000
+
+static cache_t *s_churn_cache = NULL;
+static _Atomic(int) s_churn_go = 0;
+static _Atomic(long) s_churn_hits = 0;
+
+static void *churn_stress_writer(void *arg)
+{
+    const uint64_t base = (uint64_t)(intptr_t)arg;
+    while (atomic_load(&s_churn_go) == 0) cpu_pause();
+    for (uint64_t i = 0; i < CHURN_STRESS_PUTS; i++)
+    {
+        const uint64_t k = (base + i * 7) % CHURN_STRESS_KEYSPACE;
+        uint64_t *p = make_payload(churn_value(churn_file(k), k));
+        (void)cache_put(s_churn_cache, churn_file(k), k, p, sizeof(*p), CHURN_COST, reclaim_free,
+                        NULL, NULL);
+    }
+    return NULL;
+}
+
+static void *churn_stress_reader(void *arg)
+{
+    unsigned seed = (unsigned)(intptr_t)arg * 2654435761u + 1u;
+    long hits = 0;
+    while (atomic_load(&s_churn_go) == 0) cpu_pause();
+    for (long i = 0; i < CHURN_STRESS_GETS; i++)
+    {
+        seed = seed * 1103515245u + 12345u;
+        const uint64_t k = (seed >> 8) % CHURN_STRESS_KEYSPACE;
+        void *got = NULL;
+        cache_entry_t *pin = NULL;
+        if (!cache_get(s_churn_cache, churn_file(k), k, &got, NULL, &pin)) continue;
+        ASSERT_EQ(*(uint64_t *)got, churn_value(churn_file(k), k));
+        cache_release(pin);
+        hits++;
+    }
+    atomic_fetch_add(&s_churn_hits, hits);
+    return NULL;
+}
+
+void test_cache_churn_concurrent_never_wrong_hit(void)
+{
+    atomic_store(&g_reclaimed, 0);
+    atomic_store(&g_allocated, 0);
+    atomic_store(&s_churn_go, 0);
+    atomic_store(&s_churn_hits, 0);
+    s_churn_cache = churn_cache_create();
+    ASSERT_TRUE(s_churn_cache != NULL);
+
+    pthread_t readers[CHURN_STRESS_READERS], writers[CHURN_STRESS_WRITERS];
+    for (int i = 0; i < CHURN_STRESS_READERS; i++)
+        pthread_create(&readers[i], NULL, churn_stress_reader, (void *)(intptr_t)(i + 1));
+    for (int i = 0; i < CHURN_STRESS_WRITERS; i++)
+        pthread_create(&writers[i], NULL, churn_stress_writer, (void *)(intptr_t)(i * 1031));
+    atomic_store(&s_churn_go, 1);
+    for (int i = 0; i < CHURN_STRESS_WRITERS; i++) pthread_join(writers[i], NULL);
+    for (int i = 0; i < CHURN_STRESS_READERS; i++) pthread_join(readers[i], NULL);
+
+    cache_stats_t stats;
+    cache_get_stats(s_churn_cache, &stats);
+    printf("(%ld hits, %llu rebuilds) ", atomic_load(&s_churn_hits),
+           (unsigned long long)stats.rebuilds);
+    ASSERT_TRUE(stats.rebuilds > 0); /* the readers raced table rebuilds, not just evictions */
+    ASSERT_TRUE(atomic_load(&s_churn_hits) > 0);
+
+    /* with every thread joined no pin is left, so the live entries are exactly what the stats
+     * count, and each of them is reachable through whichever table the last rebuild published */
+    uint64_t reachable = 0;
+    for (uint64_t k = 0; k < CHURN_STRESS_KEYSPACE; k++)
+    {
+        void *got = NULL;
+        cache_entry_t *pin = NULL;
