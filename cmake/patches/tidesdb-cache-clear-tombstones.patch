+/* ===== eviction churn ===== */
+
+/* a churned shard: one shard of CHURN_SLOTS frames (twice as many buckets) and a budget of
+ * CHURN_SLOTS entries, so once it fills every insert evicts one entry and the bucket table sees a
+ * remove and an insert per put. the keys spread over CHURN_FILES file ids so both key words vary */
+#define CHURN_SLOTS     64
+#define CHURN_BUCKETS   (CHURN_SLOTS * 2)
+#define CHURN_COST      256
+#define CHURN_FILES     8
+#define CHURN_PUTS      40000
+#define CHURN_MISS_KEYS 4096
+#define CHURN_MISS_FILE 0xDEADull
+/* a miss's mean probe at the table's worst steady occupancy -- half its buckets live, a quarter
+ * tombstones -- is about eight buckets under linear probing; with nothing ever turning a tombstone
+ * back into an empty bucket, a miss walks the whole table */
+#define CHURN_MAX_MEAN_PROBE 16
+
+/* the payload a churned key carries: both key words, so a get that returns another key's payload
+ * is caught */
+static uint64_t churn_value(const uint64_t file_id, const uint64_t offset)
+{
+    return (file_id << 40) ^ offset;
+}
+
+/* the file id churned key k lives under */
+static uint64_t churn_file(const uint64_t k)
+{
+    return TEST_CACHE_FILE_ID + (k % CHURN_FILES);
+}
+
+/* put keys [first, first + n), each charged CHURN_COST */
+static void churn_puts(cache_t *cache, const uint64_t first, const uint64_t n)
+{
+    for (uint64_t k = first; k < first + n; k++)
+    {
+        uint64_t *p = make_payload(churn_value(churn_file(k), k));
+        (void)cache_put(cache, churn_file(k), k, p, sizeof(*p), CHURN_COST, reclaim_free, NULL,
+                        NULL);
+    }
+}
+
+static cache_t *churn_cache_create(void)
+{
+    cache_config_t cfg = {0};
+    cfg.capacity_bytes = CHURN_SLOTS * CHURN_COST;
+    cfg.shard_count = 1;
+    cfg.slots_per_shard = CHURN_SLOTS;
+    return cache_create(&cfg);
+}
+
+/* after long eviction churn a miss still ends its probe early: removals do not leave the bucket
+ * table full of tombstones */
+void test_cache_churn_keeps_miss_probes_short(void)
+{
+    atomic_store(&g_reclaimed, 0);
+    atomic_store(&g_allocated, 0);
+    cache_t *cache = churn_cache_create();
+    ASSERT_TRUE(cache != NULL);
+
+    churn_puts(cache, 0, CHURN_PUTS);
+
+    long total = 0;
+    int longest = 0;
+    for (uint64_t off = 0; off < CHURN_MISS_KEYS; off++)
+    {
+        const int probed = cache_probe_length(cache, CHURN_MISS_FILE, off);
+        total += probed;
+        if (probed > longest) longest = probed;
+    }
+    printf("(mean miss probe %.2f, longest %d of %d buckets) ", (double)total / CHURN_MISS_KEYS,
+           longest, CHURN_BUCKETS);
+    fflush(stdout);
+    ASSERT_TRUE(total <= (long)CHURN_MAX_MEAN_PROBE * CHURN_MISS_KEYS);
+    ASSERT_TRUE(longest < CHURN_BUCKETS); /* some bucket is EMPTY again */
+
+    /* tombstones stay under their share of the table, because the shard rebuilds past it */
+    cache_stats_t stats;
+    cache_get_stats(cache, &stats);
+    ASSERT_TRUE(stats.tombstones <= CHURN_BUCKETS / 4);
+    ASSERT_TRUE(stats.rebuilds > 0);
+
+    cache_destroy(cache);
+    ASSERT_EQ(atomic_load(&g_allocated), atomic_load(&g_reclaimed));
+}
+
+/* a sparsely loaded table clears its tombstones as it goes: a removed bucket followed by an empty
+ * one becomes empty, and so does the tombstone run before it, so churn needs no rebuild at all */
+#define SPARSE_SLOTS      1024
+#define SPARSE_LIVE       4
+#define SPARSE_PUTS       20000
+#define SPARSE_TOMBSTONES 8
+void test_cache_sparse_churn_clears_tombstones_without_rebuild(void)
+{
+    atomic_store(&g_reclaimed, 0);
+    atomic_store(&g_allocated, 0);
+    cache_config_t cfg = {0};
+    cfg.capacity_bytes = SPARSE_LIVE * CHURN_COST;
+    cfg.shard_count = 1;
+    cfg.slots_per_shard = SPARSE_SLOTS;
+    cache_t *cache = cache_create(&cfg);
+    ASSERT_TRUE(cache != NULL);
+
+    churn_puts(cache, 0, SPARSE_PUTS);
+
+    cache_stats_t stats;
+    cache_get_stats(cache, &stats);
+    ASSERT_TRUE(stats.evictions >= SPARSE_PUTS - SPARSE_LIVE);
+    ASSERT_TRUE(stats.tombstones <= SPARSE_TOMBSTONES);
+    ASSERT_EQ(stats.rebuilds, 0u);
+
+    cache_destroy(cache);
+    ASSERT_EQ(atomic_load(&g_allocated), atomic_load(&g_reclaimed));
+}
+
+/* after churn every key either misses or returns its own payload, never another key's, and every
+ * entry the cache holds is still reachable through the bucket table */
+void test_cache_churn_returns_own_payload_or_miss(void)
+{
+    atomic_store(&g_reclaimed, 0);
