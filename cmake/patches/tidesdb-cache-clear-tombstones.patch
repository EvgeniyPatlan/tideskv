+        ASSERT_EQ(*(uint64_t *)got, churn_value(churn_file(k), k));
+        cache_release(pin);
+        reachable++;
+    }
+    cache_get_stats(s_churn_cache, &stats);
+    ASSERT_TRUE(stats.entries > 0);
+    ASSERT_EQ(reachable, stats.entries);
+    cache_destroy(s_churn_cache);
+    s_churn_cache = NULL;
+    ASSERT_EQ(atomic_load(&g_allocated), atomic_load(&g_reclaimed));
+}
