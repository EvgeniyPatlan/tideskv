+
+/* the codec modes this build can run: lz4 when it was built with compression, and always none */
+static int ar_init_codecs(void)
+{
+    if (tidesdb_encoding_registry_init(&g_reg) != TDB_SUCCESS) return 0;
+    const uint8_t lz4[1] = {TDB_COMPRESS_LZ4};
+    if (tidesdb_encoding_resolve(&g_reg, lz4, 1, g_lz4, 1) == 1)
+        g_modes[g_mode_count++] = (ar_mode_t){"lz4", g_lz4, 1};
+    else
