+static uint32_t ar_hash(uint64_t i)
+{
+    uint64_t x = i * 0x9E3779B97F4A7C15ULL + 0x1234567ULL;
+    x ^= x >> 29;
+    x *= 0xBF58476D1CE4E5B9ULL;
+    x ^= x >> 32;
