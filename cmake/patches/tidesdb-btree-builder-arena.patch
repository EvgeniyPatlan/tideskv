+
+/* the btree builder keeps a pending leaf's keys and values in one growable byte arena, reuses the
+ * leaf, its arrays and its serialize scratch from leaf to leaf, and copies the table's max key once
+ * per leaf rather than once per entry. these cases check that what comes out is unchanged (every
+ * entry reads back through point gets and both cursors, the table's key range is the first and last
+ * key written) and that the allocator is no longer hit several times per entry. each case runs with
+ * a real codec and with none */
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "../src/base/encoding/compress.h"
+#include "../src/base/encoding/encoding.h"
+#include "../src/base/errors.h"
+#include "../src/io/block_manager.h"
+#include "../src/sstable/btree/btree.h"
+#include "../src/sstable/btree/btree_internal.h"
+#include "test_utils.h"
+
+static int tests_passed = 0;
+static int tests_failed = 0;
+
+#define AR_DIR       "." PATH_SEPARATOR "test_btree_arena"
+#define AR_DIR_MODE  0755
+#define AR_KLOG      AR_DIR PATH_SEPARATOR "1.klog"
+#define AR_KEY_MAX   300
+#define AR_KEY_MIN   8
+#define AR_VALUE_MAX 9000
+
+/* allocation counting: the test binary's own malloc family forwards to glibc and counts while
+ * enabled, so the builder's calls (and anything it calls) are included. a sanitizer supplies its
+ * own allocator, which memory from strdup or stdio reaches through the real free, so the override
+ * and the case that needs it are built only when ARENA_COUNT_ALLOCS is defined, which the build
+ * does when no sanitizer is on */
+#ifdef ARENA_COUNT_ALLOCS
+extern void *__libc_malloc(size_t);
+extern void *__libc_calloc(size_t, size_t);
+extern void *__libc_realloc(void *, size_t);
+extern void __libc_free(void *);
+
+static volatile int g_counting = 0;
+static volatile uint64_t g_allocs = 0;
+
+void *malloc(size_t n)
+{
+    if (g_counting) g_allocs++;
+    return __libc_malloc(n);
+}
+
+void *calloc(size_t a, size_t b)
+{
+    if (g_counting) g_allocs++;
+    return __libc_calloc(a, b);
+}
+
+void *realloc(void *p, size_t n)
+{
+    if (g_counting) g_allocs++;
+    return __libc_realloc(p, n);
+}
+
+void free(void *p)
+{
+    __libc_free(p);
+}
+#endif
+
+static tidesdb_encoding_registry_t g_reg;
+static tidesdb_encoding_stage_t g_lz4[1];
+
+typedef struct
+{
