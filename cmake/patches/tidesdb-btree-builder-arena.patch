+static size_t ar_key(uint8_t *buf, uint64_t i)
+{
+    snprintf((char *)buf, AR_KEY_MAX, "%08" PRIu64, i);
+    const size_t fill = ar_hash(i) % (AR_KEY_MAX - AR_KEY_MIN + 1);
+    for (size_t j = 0; j < fill; j++) buf[AR_KEY_MIN + j] = (uint8_t)('a' + (i + j) % 26);
+    return AR_KEY_MIN + fill;
+}
+
+static size_t ar_value(uint8_t *buf, uint64_t i)
+{
+    const uint32_t h = ar_hash(i ^ 0xABCDEFULL);
+    size_t n = h % 64;
+    if (h % 16 == 0) n = (h >> 8) % 4097;
+    if (i % 5000 == 4999) n = AR_VALUE_MAX;
+    for (size_t j = 0; j < n; j++) buf[j] = (uint8_t)(i * 7 + j * 13);
+    return n;
+}
+
+static void ar_check_entry(const uint8_t *k, size_t ks, const uint8_t *v, size_t vs, uint64_t i)
+{
+    uint8_t wk[AR_KEY_MAX], wv[AR_VALUE_MAX];
+    const size_t wks = ar_key(wk, i);
+    const size_t wvs = ar_value(wv, i);
+    ASSERT_EQ(ks, wks);
+    ASSERT_EQ(memcmp(k, wk, ks), 0);
+    ASSERT_EQ(vs, wvs);
+    if (vs) ASSERT_EQ(memcmp(v, wv, vs), 0);
+}
+
+#define AR_MANY 200000
+
+static void ar_scan(btree_t *tree, int backward)
+{
+    btree_cursor_t *c = NULL;
+    ASSERT_EQ(btree_cursor_init(&c, tree), 0);
+    ASSERT_EQ(backward ? btree_cursor_goto_last(c) : btree_cursor_goto_first(c), 0);
+    uint64_t seen = 0;
+    while (btree_cursor_valid(c))
+    {
+        uint8_t *k = NULL, *v = NULL;
+        size_t ks = 0, vs = 0;
+        uint64_t vlog = 0, seq = 0;
+        int64_t ttl = 0;
+        uint8_t del = 0;
+        ASSERT_EQ(btree_cursor_get(c, &k, &ks, &v, &vs, &vlog, &seq, &ttl, &del), 0);
+        const uint64_t i = backward ? AR_MANY - 1 - seen : seen;
+        ar_check_entry(k, ks, v, vs, i);
+        ASSERT_EQ(seq, i + 1);
+        seen++;
+        if ((backward ? btree_cursor_prev(c) : btree_cursor_next(c)) != 0) break;
+    }
+    ASSERT_EQ(seen, (uint64_t)AR_MANY);
+    ASSERT_EQ(btree_cursor_read_failed(c), 0);
+    btree_cursor_free(c);
+}
+
+static void test_arena_many_leaves_round_trip(void)
+{
+    for (int mi = 0; mi < g_mode_count; mi++)
+    {
+        const ar_mode_t *m = &g_modes[mi];
+        ar_fresh_dir();
+        block_manager_t *bm = NULL;
+        ASSERT_EQ(block_manager_open(&bm, AR_KLOG, BLOCK_MANAGER_SYNC_NONE), 0);
+        const btree_config_t cfg = {
+            .target_node_size = 4096, .codec = m->codec, .codec_count = m->codec_count};
+        btree_builder_t *b = NULL;
+        ASSERT_EQ(btree_builder_new(&b, bm, &cfg), 0);
+
+        uint8_t k[AR_KEY_MAX], v[AR_VALUE_MAX];
+        for (uint64_t i = 0; i < AR_MANY; i++)
+        {
+            const size_t ks = ar_key(k, i);
+            const size_t vs = ar_value(v, i);
+            ASSERT_EQ(btree_builder_add(b, k, ks, vs ? v : NULL, vs, 0, i + 1, 0, 0), 0);
+        }
+        btree_t *tree = NULL;
+        ASSERT_EQ(btree_builder_finish(b, &tree), 0);
+        ASSERT_TRUE(tree->node_count > 1000);
+
+        /* point gets: every 7th key, plus the ends */
+        for (uint64_t i = 0; i < AR_MANY; i += (i % 7 == 0 ? 7 : 1))
+        {
+            const size_t ks = ar_key(k, i);
+            uint8_t *gv = NULL;
+            size_t gvs = 0;
+            uint64_t vlog = 0, seq = 0;
+            int64_t ttl = 0;
+            uint8_t del = 0;
+            ASSERT_EQ(btree_get(tree, k, ks, &gv, &gvs, &vlog, &seq, &ttl, &del), 0);
+            ar_check_entry(k, ks, gv, gvs, i);
+            ASSERT_EQ(seq, i + 1);
+            free(gv);
+        }
+        ar_scan(tree, 0);
+        ar_scan(tree, 1);
+
+        btree_free(tree);
+        btree_builder_free(b);
+        (void)block_manager_close(bm);
+    }
+    (void)remove_directory(AR_DIR);
+}
+
+static void test_min_max_key_match(void)
+{
+    /* node sizes that give a few leaves and many, and one table of a single entry */
+    const size_t sizes[] = {32768, 4096, 512};
+    for (int mi = 0; mi < g_mode_count; mi++)
+    {
+        for (size_t si = 0; si < sizeof(sizes) / sizeof(sizes[0]); si++)
+        {
+            const ar_mode_t *m = &g_modes[mi];
+            ar_fresh_dir();
+            block_manager_t *bm = NULL;
+            ASSERT_EQ(block_manager_open(&bm, AR_KLOG, BLOCK_MANAGER_SYNC_NONE), 0);
+            const btree_config_t cfg = {
+                .target_node_size = sizes[si], .codec = m->codec, .codec_count = m->codec_count};
+            btree_builder_t *b = NULL;
+            ASSERT_EQ(btree_builder_new(&b, bm, &cfg), 0);
+
+            uint8_t k[AR_KEY_MAX], v[AR_VALUE_MAX];
+            uint8_t first[AR_KEY_MAX], last[AR_KEY_MAX];
+            size_t first_size = 0, last_size = 0;
+            const uint64_t n = (si == 0 && mi == 1) ? 1 : 3000 + si; /* one entry, one leaf */
+            for (uint64_t i = 0; i < n; i++)
+            {
+                const size_t ks = ar_key(k, i);
+                const size_t vs = ar_value(v, i);
+                if (i == 0)
+                {
+                    memcpy(first, k, ks);
+                    first_size = ks;
+                }
+                memcpy(last, k, ks);
+                last_size = ks;
+                ASSERT_EQ(btree_builder_add(b, k, ks, vs ? v : NULL, vs, 0, i + 1, 0, 0), 0);
+            }
+            btree_t *tree = NULL;
+            ASSERT_EQ(btree_builder_finish(b, &tree), 0);
+            ASSERT_EQ(tree->min_key_size, first_size);
+            ASSERT_EQ(memcmp(tree->min_key, first, first_size), 0);
+            ASSERT_EQ(tree->max_key_size, last_size);
+            ASSERT_EQ(memcmp(tree->max_key, last, last_size), 0);
+
+            uint8_t *mk = NULL;
+            size_t mks = 0;
+            ASSERT_EQ(btree_get_max_key(tree, &mk, &mks), 0);
+            ASSERT_EQ(mks, last_size);
+            ASSERT_EQ(memcmp(mk, last, mks), 0);
+            free(mk);
+
+            btree_free(tree);
+            btree_builder_free(b);
+            (void)block_manager_close(bm);
+        }
+    }
+    (void)remove_directory(AR_DIR);
+}
+
+#ifdef ARENA_COUNT_ALLOCS
+#define AR_ALLOC_ENTRIES 10000
+
+/* the builder used to allocate a key, a value, a last-key copy and a max-key copy for each entry;
+ * now it allocates for the leaf's arrays and arena as they grow and for each leaf it flushes, so
+ * well under one allocation in sixteen entries */
+static void test_alloc_count_per_entry(void)
+{
+    for (int mi = 0; mi < g_mode_count; mi++)
+    {
+        const ar_mode_t *m = &g_modes[mi];
+        ar_fresh_dir();
+        block_manager_t *bm = NULL;
+        ASSERT_EQ(block_manager_open(&bm, AR_KLOG, BLOCK_MANAGER_SYNC_NONE), 0);
+        const btree_config_t cfg = {.target_node_size = BTREE_DEFAULT_NODE_SIZE,
+                                    .codec = m->codec,
+                                    .codec_count = m->codec_count};
+        btree_builder_t *b = NULL;
+        ASSERT_EQ(btree_builder_new(&b, bm, &cfg), 0);
+
+        uint8_t k[AR_KEY_MAX], v[128];
+        memset(v, 'x', sizeof(v));
+        g_allocs = 0;
+        g_counting = 1;
+        for (uint64_t i = 0; i < AR_ALLOC_ENTRIES; i++)
+        {
+            const size_t ks = (size_t)snprintf((char *)k, sizeof(k), "key%012" PRIu64, i);
+            const int rc = btree_builder_add(b, k, ks, v, sizeof(v), 0, i + 1, 0, 0);
+            if (rc != 0) g_counting = 0;
+            ASSERT_EQ(rc, 0);
+        }
+        g_counting = 0;
+        const uint64_t allocs = g_allocs;
+        printf("\n  %s: %" PRIu64 " allocations for %d adds\n", m->name, allocs, AR_ALLOC_ENTRIES);
+        fflush(stdout);
+        ASSERT_TRUE(allocs <= AR_ALLOC_ENTRIES / 16);
+
+        btree_t *tree = NULL;
+        ASSERT_EQ(btree_builder_finish(b, &tree), 0);
+        ASSERT_EQ(btree_get_entry_count(tree), (uint64_t)AR_ALLOC_ENTRIES);
+        btree_free(tree);
+        btree_builder_free(b);
+        (void)block_manager_close(bm);
+    }
+    (void)remove_directory(AR_DIR);
+}
+#endif
+
+/* a block appended to the klog between two leaves breaks the back-to-back layout the next links
+ * were computed from. the leaf written after it must fail the build rather than publish a chain
+ * whose links point at the stray block's neighbour */
+static void test_stray_block_between_leaves_fails_build(void)
+{
+    for (int mi = 0; mi < g_mode_count; mi++)
+    {
+        const ar_mode_t *m = &g_modes[mi];
+        ar_fresh_dir();
+        block_manager_t *bm = NULL;
+        ASSERT_EQ(block_manager_open(&bm, AR_KLOG, BLOCK_MANAGER_SYNC_NONE), 0);
+        const btree_config_t cfg = {
+            .target_node_size = 512, .codec = m->codec, .codec_count = m->codec_count};
+        btree_builder_t *b = NULL;
+        ASSERT_EQ(btree_builder_new(&b, bm, &cfg), 0);
+
+        uint8_t k[AR_KEY_MAX], v[64];
+        memset(v, 's', sizeof(v));
+        int failed = 0, strayed = 0;
+        for (uint64_t i = 0; i < 5000 && !failed; i++)
+        {
+            /* three leaves built means the first is on disk and the second is held, so the next
+             * write has a previous leaf to be contiguous with */
+            if (!strayed && b->node_count >= 3)
+            {
+                const uint8_t stray[16] = {0};
+                ASSERT_TRUE(block_manager_write_raw(bm, stray, sizeof(stray)) >= 0);
+                strayed = 1;
+            }
+            const size_t ks = (size_t)snprintf((char *)k, sizeof(k), "key%012" PRIu64, i);
+            if (btree_builder_add(b, k, ks, v, sizeof(v), 0, i + 1, 0, 0) != 0) failed = 1;
+        }
+        ASSERT_TRUE(strayed);
+        btree_t *tree = NULL;
+        if (!failed) ASSERT_EQ(btree_builder_finish(b, &tree), -1);
+        ASSERT_TRUE(tree == NULL);
+        btree_builder_free(b);
+        (void)block_manager_close(bm);
+    }
+    (void)remove_directory(AR_DIR);
+}
+
+int main(int argc, char **argv)
+{
+    ASSERT_TRUE(ar_init_codecs());
+    INIT_TEST_FILTER(argc, argv);
+#ifdef ARENA_COUNT_ALLOCS
+    RUN_TEST(test_alloc_count_per_entry, tests_passed);
+#else
+    printf("skipped: test_alloc_count_per_entry (a sanitizer owns the allocator)\n");
+#endif
+    RUN_TEST(test_min_max_key_match, tests_passed);
+    RUN_TEST(test_arena_many_leaves_round_trip, tests_passed);
+    RUN_TEST(test_stray_block_between_leaves_fails_build, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
