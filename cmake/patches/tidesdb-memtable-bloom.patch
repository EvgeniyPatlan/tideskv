+/* the whole-key bloom a memtable keeps in front of its skip list (memtable/memtable_bloom.h). a
+ * point read must skip the skip list of a memtable that cannot hold its key, and must never skip
+ * one that does: not while a writer is committing and rotating under it, not past a point or range
+ * delete, not after the memtable was rebuilt from its log. with the filter off every memtable is
+ * searched, as before */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "../src/base/encoding/serialization.h" /* tdb_build_prefixed_key */
+#include "../src/column_family/column_family.h" /* cf_t, the handle's cf index */
+#include "../src/engine/engine.h"               /* engine_force_rotate */
+#include "../src/engine/engine_types.h"         /* db->l0, db->flush_lock, db->active_wal_gen */
+#include "../src/memtable/l0_internal.h"        /* tidesdb_l0_skiplist_probes */
+#include "../src/memtable/memtable.h"
+#include "../src/memtable/memtable_bloom.h"
+#include "db.h"
+#include "test_utils.h"
+
+static int tests_passed = 0;
+static int tests_failed = 0;
+
+static const char *mb_exe = NULL;
+
+#define MB_DB_DIR     "." PATH_SEPARATOR "test_memtable_bloom_db"
+#define MB_CF         "cf0"
+#define MB_CHILD_FLAG "--memtable-bloom-child"
+#define MB_PHASE_FILL "fill"
+
+/* one memtable large enough to hold every key the absent-key case writes without rotating, so
+ * its filter is a megabyte: about 80 bits a key */
+#define MB_BIG_BUFFER (64u << 20)
+#define MB_KEYS       100000
+#define MB_BATCH      1000
+/* 100k absent gets against 100k keys in one filter; the false positives must stay this low */
+#define MB_ABSENT_PROBE_LIMIT 2000
+
+/* the concurrent case: small memtables so it rotates many times, one key per commit */
+#define MB_SMALL_BUFFER   (256u << 10)
+#define MB_CONC_KEYS      200000
+#define MB_MIN_ROTATIONS  3
+#define MB_LOCKED_RETRIES 1000
+
+/* the recovery case */
+#define MB_RECOVER_KEYS        10000
+#define MB_RECOVER_FP_LIMIT    200
+#define MB_RECOVER_ROUNDS      5
+#define MB_MAX_PINNED          64
+#define MB_RECOVER_SYNC_PERIOD (60ull * 1000 * 1000)
+
+#define MB_VALUE "value-for-the-bloom-tests"
+
+static void mb_key(char *buf, size_t cap, const char *prefix, int i)
+{
+    snprintf(buf, cap, "%s%08d", prefix, i);
+}
+
+static tidesdb_config_t mb_config(const int bloom, const size_t buffer)
+{
+    tidesdb_config_t cfg = tidesdb_default_config();
+    cfg.db_path = MB_DB_DIR;
+    cfg.memtable_sync_mode = TDB_SYNC_NONE;
+    cfg.memtable_write_buffer_size = buffer;
+    cfg.memtable_idle_flush_seconds = 0;
+    cfg.num_flush_threads = 1;
+    cfg.memtable_whole_key_bloom = bloom;
+    return cfg;
+}
+
+static tidesdb_t *mb_open(const tidesdb_config_t *cfg, const int create_cf,
+                          tidesdb_column_family_t **cf)
+{
+    tidesdb_t *db = NULL;
+    ASSERT_EQ(tidesdb_open(cfg, &db), TDB_SUCCESS);
+    if (create_cf)
+    {
+        tidesdb_column_family_config_t cc = tidesdb_default_column_family_config();
+        const int rc = tidesdb_create_column_family(db, MB_CF, &cc);
+        ASSERT_EQ(rc, TDB_SUCCESS);
+    }
+    *cf = tidesdb_get_column_family(db, MB_CF);
+    ASSERT_TRUE(*cf != NULL);
+    return db;
+}
+
+/* commit keys [from, to) under prefix, count per transaction */
+static void mb_fill(tidesdb_t *db, tidesdb_column_family_t *cf, const char *prefix, int from,
+                    int to, int per_txn)
+{
+    for (int i = from; i < to;)
+    {
+        tidesdb_txn_t *txn = NULL;
+        int rc = tidesdb_txn_begin(db, &txn);
+        ASSERT_EQ(rc, TDB_SUCCESS);
+        for (int j = 0; j < per_txn && i < to; j++, i++)
+        {
+            char key[32];
+            mb_key(key, sizeof(key), prefix, i);
+            rc = tidesdb_txn_put(txn, cf, (const uint8_t *)key, strlen(key),
+                                 (const uint8_t *)MB_VALUE, sizeof(MB_VALUE), -1);
+            ASSERT_EQ(rc, TDB_SUCCESS);
+        }
+        rc = tidesdb_txn_commit(txn);
+        ASSERT_EQ(rc, TDB_SUCCESS);
+        tidesdb_txn_free(txn);
+    }
+}
+
+/* one get in its own read-committed transaction, retried while contention reports locked */
+static int mb_get(tidesdb_t *db, tidesdb_column_family_t *cf, const char *key)
+{
+    for (int attempt = 0; attempt < MB_LOCKED_RETRIES; attempt++)
+    {
+        tidesdb_txn_t *txn = NULL;
+        int rc = tidesdb_txn_begin_with_isolation(db, TDB_ISOLATION_READ_COMMITTED, &txn);
+        ASSERT_EQ(rc, TDB_SUCCESS);
+        uint8_t *value = NULL;
+        size_t value_size = 0;
+        rc = tidesdb_txn_get_notrack(txn, cf, (const uint8_t *)key, strlen(key), &value,
+                                     &value_size);
+        if (rc == TDB_SUCCESS)
+        {
+            ASSERT_EQ(value_size, sizeof(MB_VALUE));
+            ASSERT_EQ(memcmp(value, MB_VALUE, sizeof(MB_VALUE)), 0);
+            free(value);
+        }
+        tidesdb_txn_free(txn);
+        if (rc != TDB_ERR_LOCKED) return rc;
+    }
+    return TDB_ERR_LOCKED;
+}
+
+/* how many of keys [from, to) under prefix a get finds */
+static int mb_count_found(tidesdb_t *db, tidesdb_column_family_t *cf, const char *prefix, int from,
+                          int to)
+{
+    int found = 0;
+    for (int i = from; i < to; i++)
+    {
+        char key[32];
+        mb_key(key, sizeof(key), prefix, i);
+        const int rc = mb_get(db, cf, key);
+        ASSERT_TRUE(rc == TDB_SUCCESS || rc == TDB_ERR_NOT_FOUND);
+        if (rc == TDB_SUCCESS) found++;
+    }
+    return found;
+}
+
+/* 100k absent and 100k present gets against one memtable of 100k keys. with the filter the absent
+ * ones reach the skip list only as false positives; without it every get searches it */
+static void mb_absent_and_present(const int bloom)
+{
+    (void)remove_directory(MB_DB_DIR);
+    const tidesdb_config_t cfg = mb_config(bloom, MB_BIG_BUFFER);
+    tidesdb_column_family_t *cf = NULL;
+    tidesdb_t *db = mb_open(&cfg, 1, &cf);
+
+    const uint64_t gen_before = atomic_load(&db->active_wal_gen);
+    mb_fill(db, cf, "k", 0, MB_KEYS, MB_BATCH);
+    /* still the one memtable: nothing rotated, nothing queued */
+    ASSERT_EQ(atomic_load(&db->active_wal_gen), gen_before);
+    ASSERT_EQ(tidesdb_l0_queue_depth(db->l0), 0);
+
+    const uint64_t p0 = tidesdb_l0_skiplist_probes();
+    ASSERT_EQ(mb_count_found(db, cf, "a", 0, MB_KEYS), 0);
+    const uint64_t absent_probes = tidesdb_l0_skiplist_probes() - p0;
+
+    const uint64_t p1 = tidesdb_l0_skiplist_probes();
+    ASSERT_EQ(mb_count_found(db, cf, "k", 0, MB_KEYS), MB_KEYS);
+    const uint64_t present_probes = tidesdb_l0_skiplist_probes() - p1;
+
+    printf("(bloom %d: %llu probes for %d absent gets, %llu for %d present) ", bloom,
+           (unsigned long long)absent_probes, MB_KEYS, (unsigned long long)present_probes, MB_KEYS);
+    fflush(stdout);
+    if (bloom)
+        ASSERT_TRUE(absent_probes <= MB_ABSENT_PROBE_LIMIT);
+    else
+        ASSERT_EQ(absent_probes, (uint64_t)MB_KEYS);
+    ASSERT_EQ(present_probes, (uint64_t)MB_KEYS);
+
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(MB_DB_DIR);
+}
+
+void test_bloom_skips_absent_keys(void)
+{
+    mb_absent_and_present(1);
+}
+
+typedef struct
+{
+    tidesdb_t *db;
+    tidesdb_column_family_t *cf;
+    _Atomic(int) committed; /* keys k_0 .. k_{committed-1} have returned from their commit */
+} mb_conc_t;
+
+static void *mb_conc_writer(void *arg)
+{
+    mb_conc_t *c = (mb_conc_t *)arg;
+    for (int i = 0; i < MB_CONC_KEYS; i++)
+    {
+        mb_fill(c->db, c->cf, "k", i, i + 1, 1);
+        atomic_store_explicit(&c->committed, i + 1, memory_order_release);
+    }
+    return NULL;
+}
+
+/* a reader chasing a writer: the newest key whose commit returned is always found, across
+ * rotations, because a commit's filter bits are set before its sequence is visible */
+static void mb_concurrent_insert(const int bloom)
+{
+    (void)remove_directory(MB_DB_DIR);
+    const tidesdb_config_t cfg = mb_config(bloom, MB_SMALL_BUFFER);
+    mb_conc_t c;
+    c.db = mb_open(&cfg, 1, &c.cf);
+    atomic_init(&c.committed, 0);
+    const uint64_t gen_before = atomic_load(&c.db->active_wal_gen);
+
+    pthread_t writer;
+    ASSERT_EQ(pthread_create(&writer, NULL, mb_conc_writer, &c), 0);
+    uint64_t reads = 0;
+    int last = 0;
+    while (last < MB_CONC_KEYS)
+    {
+        last = atomic_load_explicit(&c.committed, memory_order_acquire);
+        if (last == 0) continue;
+        char key[32];
+        mb_key(key, sizeof(key), "k", last - 1);
+        const int rc = mb_get(c.db, c.cf, key);
+        if (rc != TDB_SUCCESS) printf("(key %s not found: %d) ", key, rc);
+        ASSERT_EQ(rc, TDB_SUCCESS);
+        reads++;
+    }
+    ASSERT_EQ(pthread_join(writer, NULL), 0);
+    const uint64_t rotations = atomic_load(&c.db->active_wal_gen) - gen_before;
+    printf("(bloom %d: %llu chasing reads over %llu rotations) ", bloom, (unsigned long long)reads,
+           (unsigned long long)rotations);
+    fflush(stdout);
+    ASSERT_TRUE(rotations >= MB_MIN_ROTATIONS);
+
+    ASSERT_EQ(tidesdb_close(c.db), TDB_SUCCESS);
+    (void)remove_directory(MB_DB_DIR);
+}
+
+void test_bloom_sees_concurrent_insert(void)
+{
+    mb_concurrent_insert(1);
+}
+
+static void mb_delete(tidesdb_t *db, tidesdb_column_family_t *cf, const char *key)
+{
+    tidesdb_txn_t *txn = NULL;
+    int rc = tidesdb_txn_begin(db, &txn);
+    ASSERT_EQ(rc, TDB_SUCCESS);
+    rc = tidesdb_txn_delete(txn, cf, (const uint8_t *)key, strlen(key));
+    ASSERT_EQ(rc, TDB_SUCCESS);
+    rc = tidesdb_txn_commit(txn);
+    ASSERT_EQ(rc, TDB_SUCCESS);
+    tidesdb_txn_free(txn);
+}
+
+static void mb_delete_range(tidesdb_t *db, tidesdb_column_family_t *cf, const char *lo,
+                            const char *hi)
+{
+    tidesdb_txn_t *txn = NULL;
+    int rc = tidesdb_txn_begin(db, &txn);
+    ASSERT_EQ(rc, TDB_SUCCESS);
+    rc = tidesdb_txn_delete_range(txn, cf, (const uint8_t *)lo, strlen(lo), (const uint8_t *)hi,
+                                  strlen(hi));
+    ASSERT_EQ(rc, TDB_SUCCESS);
+    rc = tidesdb_txn_commit(txn);
+    ASSERT_EQ(rc, TDB_SUCCESS);
+    tidesdb_txn_free(txn);
+}
+
+/* a key in an immutable, deleted in the active one: by a point delete, which is in the active's
+ * filter, and by a range delete, which is not -- the range check runs whatever the filter says */
+static void mb_deletes_win(const int bloom)
+{
+    (void)remove_directory(MB_DB_DIR);
+    const tidesdb_config_t cfg = mb_config(bloom, MB_BIG_BUFFER);
+    tidesdb_column_family_t *cf = NULL;
+    tidesdb_t *db = mb_open(&cfg, 1, &cf);
+
+    /* the flush worker claims under this lock, so holding it keeps the sealed memtable in L0 */
+    pthread_mutex_lock(&db->flush_lock);
+    mb_fill(db, cf, "d", 0, 10, 10);
+    mb_fill(db, cf, "r", 0, 10, 10);
+    ASSERT_EQ(engine_force_rotate(db), TDB_SUCCESS);
+    ASSERT_EQ(tidesdb_l0_queue_depth(db->l0), 1);
+
+    /* the active memtable holds something else, so its filter is not empty */
+    mb_fill(db, cf, "x", 0, 10, 10);
+    char key[32];
+    mb_key(key, sizeof(key), "d", 3);
+    mb_delete(db, cf, key);
+    mb_delete_range(db, cf, "r00000002", "r00000005");
+
+    ASSERT_EQ(mb_get(db, cf, key), TDB_ERR_NOT_FOUND);
+    for (int i = 0; i < 10; i++)
+    {
+        mb_key(key, sizeof(key), "r", i);
+        const int want = i >= 2 && i < 5 ? TDB_ERR_NOT_FOUND : TDB_SUCCESS;
+        ASSERT_EQ(mb_get(db, cf, key), want);
+    }
+    ASSERT_EQ(mb_count_found(db, cf, "d", 0, 10), 9);
+    ASSERT_EQ(mb_count_found(db, cf, "x", 0, 10), 10);
+    ASSERT_EQ(tidesdb_l0_queue_depth(db->l0), 1); /* all of it was read with the immutable in L0 */
+    pthread_mutex_unlock(&db->flush_lock);
+
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(MB_DB_DIR);
+}
+
+void test_deletes_and_range_tombstones_still_win(void)
+{
+    mb_deletes_win(1);
+}
+
+/* the child of the recovery case: commit the keys and die without a close, so the reopen replays
+ * them from the log. interval sync waits for each record to reach the file, which outlives the
+ * process; the long period keeps fsync out of the loop */
+static void mb_child_fill(void)
+{
+    tidesdb_config_t cfg = mb_config(1, MB_BIG_BUFFER);
+    cfg.memtable_sync_mode = TDB_SYNC_INTERVAL;
+    cfg.memtable_sync_interval_us = MB_RECOVER_SYNC_PERIOD;
+    tidesdb_t *db = NULL;
+    if (tidesdb_open(&cfg, &db) != TDB_SUCCESS) _exit(1);
+    tidesdb_column_family_config_t cc = tidesdb_default_column_family_config();
+    if (tidesdb_create_column_family(db, MB_CF, &cc) != TDB_SUCCESS) _exit(1);
+    tidesdb_column_family_t *cf = tidesdb_get_column_family(db, MB_CF);
+    if (!cf) _exit(1);
+    mb_fill(db, cf, "k", 0, MB_RECOVER_KEYS, 100);
+    _exit(0); /* no close: nothing is flushed, the keys live only in the log */
+}
+
+/* whether the reopened database still holds the replayed generation unclaimed by a flush, and if
+ * so that its filter holds every replayed key and few of the absent ones. the caller holds the
+ * flush claim lock, so a generation found unclaimed stays in L0 until it lets go */
+static int mb_check_replayed_filter(tidesdb_t *db, uint32_t cf_index)
+{
+    tidesdb_memtable_t *pinned[MB_MAX_PINNED];
+    int n = 0;
+    ASSERT_EQ(tidesdb_l0_pin_memtables(db->l0, pinned, MB_MAX_PINNED, &n), TDB_SUCCESS);
+    int checked = 0;
+    for (int i = 0; i < n; i++)
+    {
+        tidesdb_memtable_t *mt = pinned[i];
+        ASSERT_TRUE(mt->bloom != NULL); /* the replayed and the fresh active alike */
+        if (skip_list_count_entries(mt->skip_list) == 0 || atomic_load(&mt->claimed)) continue;
+        int present = 0, false_pos = 0;
+        for (int k = 0; k < MB_RECOVER_KEYS; k++)
+        {
+            char key[32];
+            uint8_t pkey[64];
+            mb_key(key, sizeof(key), "k", k);
+            tdb_build_prefixed_key(cf_index, (const uint8_t *)key, strlen(key), pkey);
+            present +=
+                tidesdb_memtable_bloom_may_contain(mt, pkey, TDB_CF_PREFIX_SIZE + strlen(key));
+            mb_key(key, sizeof(key), "a", k);
+            tdb_build_prefixed_key(cf_index, (const uint8_t *)key, strlen(key), pkey);
+            false_pos +=
+                tidesdb_memtable_bloom_may_contain(mt, pkey, TDB_CF_PREFIX_SIZE + strlen(key));
+        }
+        ASSERT_EQ(present, MB_RECOVER_KEYS);
+        ASSERT_TRUE(false_pos <= MB_RECOVER_FP_LIMIT);
+        checked = 1;
+    }
+    tidesdb_l0_unpin_memtables(pinned, n);
+    return checked;
+}
+
+/* keys only the log holds come back after a crash, and the memtable the replay rebuilt has them in
+ * its filter: the gets find every one, and search a skip list once for each present key -- the
+ * replayed memtable's; the fresh active's filter is empty -- and for few of the absent ones */
+void test_recovery_fills_bloom(void)
+{
+    int checked = 0;
+    for (int round = 0; round < MB_RECOVER_ROUNDS && !checked; round++)
+    {
+        (void)remove_directory(MB_DB_DIR);
+        int exit_code = -1;
+        ASSERT_EQ(test_spawn_self(mb_exe, MB_CHILD_FLAG, MB_PHASE_FILL, "0", &exit_code), 0);
+        ASSERT_EQ(exit_code, 0);
+
+        const tidesdb_config_t cfg = mb_config(1, MB_BIG_BUFFER);
+        tidesdb_column_family_t *cf = NULL;
+        tidesdb_t *db = mb_open(&cfg, 0, &cf);
+        /* the open queues the replayed generation for flush at once, so whether a worker claimed it
+         * before this lock was taken is a race a round may lose; a lost round is run again */
+        pthread_mutex_lock(&db->flush_lock);
+        checked = mb_check_replayed_filter(db, (uint32_t)((cf_t *)cf)->cf_id);
+
+        const uint64_t p0 = tidesdb_l0_skiplist_probes();
+        ASSERT_EQ(mb_count_found(db, cf, "a", 0, MB_RECOVER_KEYS), 0);
+        ASSERT_EQ(mb_count_found(db, cf, "k", 0, MB_RECOVER_KEYS), MB_RECOVER_KEYS);
+        const uint64_t probes = tidesdb_l0_skiplist_probes() - p0;
+        pthread_mutex_unlock(&db->flush_lock);
+        printf("(round %d: replayed memtable %s, %llu probes for %d gets) ", round,
+               checked ? "in L0" : "claimed by a flush", (unsigned long long)probes,
+               2 * MB_RECOVER_KEYS);
+        fflush(stdout);
+        ASSERT_TRUE(probes <= (uint64_t)MB_RECOVER_KEYS + MB_RECOVER_FP_LIMIT);
+        if (checked) ASSERT_TRUE(probes >= (uint64_t)MB_RECOVER_KEYS);
+
+        ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    }
+    ASSERT_TRUE(checked);
+    (void)remove_directory(MB_DB_DIR);
+}
+
+/* the filter off: the same workloads give the same answers, and every get searches every memtable
+ */
+void test_bloom_off_matches(void)
+{
+    mb_absent_and_present(0);
+    mb_concurrent_insert(0);
+    mb_deletes_win(0);
+
+    (void)remove_directory(MB_DB_DIR);
+    const tidesdb_config_t cfg = mb_config(0, MB_BIG_BUFFER);
+    tidesdb_column_family_t *cf = NULL;
+    tidesdb_t *db = mb_open(&cfg, 1, &cf);
+    tidesdb_memtable_t *pinned[MB_MAX_PINNED];
+    int n = 0;
+    ASSERT_EQ(tidesdb_l0_pin_memtables(db->l0, pinned, MB_MAX_PINNED, &n), TDB_SUCCESS);
+    for (int i = 0; i < n; i++) ASSERT_TRUE(pinned[i]->bloom == NULL);
+    tidesdb_l0_unpin_memtables(pinned, n);
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(MB_DB_DIR);
+}
+
+/* the filter's sizing: a sixty-fourth of the buffer, never under 64 KiB */
+void test_bloom_sizing(void)
+{
+    ASSERT_EQ(tidesdb_memtable_bloom_bytes(0), (size_t)TDB_MEMTABLE_BLOOM_MIN_BYTES);
+    ASSERT_EQ(tidesdb_memtable_bloom_bytes(1u << 20), (size_t)TDB_MEMTABLE_BLOOM_MIN_BYTES);
+    ASSERT_EQ(tidesdb_memtable_bloom_bytes(64u << 20), (size_t)(1u << 20));
+    tidesdb_memtable_t *mt =
+        tidesdb_memtable_create_with_bloom(NULL, 0, 0, 12, 0.25f, NULL, NULL, 100000);
+    ASSERT_TRUE(mt != NULL);
+    ASSERT_EQ(mt->bloom_blocks, 100000u / TDB_MEMTABLE_BLOOM_BLOCK_BYTES);
+    ASSERT_EQ((uintptr_t)mt->bloom % TDB_MEMTABLE_BLOOM_BLOCK_BYTES, 0u);
+    const uint8_t k[] = "some-key";
+    ASSERT_EQ(tidesdb_memtable_bloom_may_contain(mt, k, sizeof(k)), 0);
+    tidesdb_memtable_bloom_add(mt, k, sizeof(k));
+    ASSERT_EQ(tidesdb_memtable_bloom_may_contain(mt, k, sizeof(k)), 1);
+    tidesdb_memtable_free(mt);
+}
+
+int main(int argc, char **argv)
+{
+    mb_exe = argv[0];
+    if (argc >= 3 && strcmp(argv[1], MB_CHILD_FLAG) == 0)
+    {
+        if (strcmp(argv[2], MB_PHASE_FILL) == 0) mb_child_fill();
+        return 2;
+    }
+    INIT_TEST_FILTER(argc, argv);
+    RUN_TEST(test_bloom_sizing, tests_passed);
+    RUN_TEST(test_bloom_skips_absent_keys, tests_passed);
+    RUN_TEST(test_bloom_sees_concurrent_insert, tests_passed);
+    RUN_TEST(test_deletes_and_range_tombstones_still_win, tests_passed);
+    RUN_TEST(test_recovery_fills_bloom, tests_passed);
+    RUN_TEST(test_bloom_off_matches, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
