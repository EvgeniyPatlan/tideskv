+/**
+ * tidesdb_memtable_bloom_add
+ * set a prefixed key's bits in the memtable's filter; called before the key's skip list insert
+ * @param mt the memtable, which may have no filter
+ * @param pkey the key with its column family prefix
+ * @param pkey_size length of pkey
+ */
+static inline void tidesdb_memtable_bloom_add(tidesdb_memtable_t *mt, const uint8_t *pkey,
+                                              const size_t pkey_size)
+{
+    if (!mt->bloom) return;
+    const uint64_t h = XXH3_64bits(pkey, pkey_size);
+    _Atomic(uint64_t) *block = tdb_memtable_bloom_block(mt, h);
+    uint64_t want[TDB_MEMTABLE_BLOOM_BLOCK_WORDS] = {0};
+    uint64_t g = tdb_memtable_bloom_mix(h);
+    for (int i = 0; i < TDB_MEMTABLE_BLOOM_PROBES; i++, g >>= TDB_MEMTABLE_BLOOM_BIT_BITS)
+    {
+        const unsigned bit = (unsigned)(g & ((1u << TDB_MEMTABLE_BLOOM_BIT_BITS) - 1u));
+        want[bit >> 6] |= 1ULL << (bit & 63u);
+    }
+    /* a word already holding its bits is left alone, so a hot key's line is read, not written */
+    for (unsigned w = 0; w < TDB_MEMTABLE_BLOOM_BLOCK_WORDS; w++)
+    {
+        if (want[w] == 0) continue;
+        const uint64_t cur = atomic_load_explicit(&block[w], memory_order_relaxed);
+        if ((cur & want[w]) != want[w])
+            atomic_fetch_or_explicit(&block[w], want[w], memory_order_relaxed);
+    }
+}
+
+/**
+ * tidesdb_memtable_bloom_may_contain
+ * whether the memtable's skip list may hold a prefixed key
+ * @param mt the memtable
+ * @param pkey the key with its column family prefix
+ * @param pkey_size length of pkey
+ * @return 0 when the filter rules the key out, 1 when it may be there or there is no filter
+ */
+static inline int tidesdb_memtable_bloom_may_contain(const tidesdb_memtable_t *mt,
+                                                     const uint8_t *pkey, const size_t pkey_size)
+{
+    if (!mt->bloom) return 1;
+    const uint64_t h = XXH3_64bits(pkey, pkey_size);
+    _Atomic(uint64_t) *block = tdb_memtable_bloom_block(mt, h);
+    uint64_t g = tdb_memtable_bloom_mix(h);
+    for (int i = 0; i < TDB_MEMTABLE_BLOOM_PROBES; i++, g >>= TDB_MEMTABLE_BLOOM_BIT_BITS)
+    {
+        const unsigned bit = (unsigned)(g & ((1u << TDB_MEMTABLE_BLOOM_BIT_BITS) - 1u));
+        if (!(atomic_load_explicit(&block[bit >> 6], memory_order_relaxed) & (1ULL << (bit & 63u))))
+            return 0;
+    }
+    return 1;
+}
+
+#endif /* __TIDESDB_MEMTABLE_BLOOM_H__ */
