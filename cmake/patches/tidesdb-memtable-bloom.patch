+#include "../internal/types.h"
+#include "xxhash.h"
+
+/* the whole-key bloom a memtable keeps in front of its skip list, so a point read skips a memtable
+ * that cannot hold its key instead of descending the list to learn that. most point reads miss the
+ * memtables -- the key lives in an sstable, or nowhere -- and the descent is a cache miss per
+ * level.
+ *
+ * the filter is blocked: an array of 512-bit blocks, each key hashed to one block and to six bits
+ * inside it, so a probe reads one cache line. the words are atomics written with a relaxed
+ * fetch-or and read with relaxed loads. it is set over the prefixed key, the form the skip list
+ * sorts on, so one filter serves every column family. it is never cleared: the memtable is
+ * write-once and freed whole.
+ *
+ * why a read never misses a key the skip list would have shown it:
+ *  - a write sets the key's bits before the skip list insert, on the same thread, so the bits are
+ *    sequenced before the insert and before everything the commit does after it -- raising the
+ *    memtable's high sequence (release), leaving the commit gate, and marking its sequence decided
+ *    in the clock's ring (release, src/txn/mvcc.c). commits overlap under the gate, but each one's
+ *    bits are sequenced before its own mark, and whichever committer carries the watermark over a
+ *    sequence first loads that sequence's slot with acquire, then moves visible_seq with an acq_rel
+ *    swap -- so the watermark passes a sequence only once every commit at or below it has marked,
+ *    and the chain mark -> slot load -> swap -> a reader's acquire of visible_seq orders the bits
+ *    before the read. a reader that acquires visible sequence S therefore happens-after the bit
+ *    sets of every commit at or below S, and its relaxed loads of
+ *    those words see the bits (read-after-write coherence; the words only ever gain bits). a commit
+ *    above S may or may not show in the filter, and the skip list would hide it at snapshot S
+ *    anyway. a read at the latest sequence (UINT64_MAX) that races a commit is free to see it or
+ *    not, with or without the filter, exactly as a skip list descent racing the insert is.
+ *  - a writer that finds its bits already set by another writer skips the store. the load that
+ *    found them read-from that writer's fetch-or, and coherence carries it to any reader ordered
+ *    after this writer's publication, so the skip changes nothing above.
+ *  - a conflict probe (tidesdb_l0_has_newer) runs on the same footing: it only trusts a memtable's
+ *    answer for commits that raised its high sequence before giving up their claims, and the bits
+ *    are sequenced before that raise.
+ *  - rotation: a commit pins the active memtable and writes the bits and the skip list entry of
+ *    that one memtable, so whichever memtable holds the entry holds its bits. the rotation closes
+ * the commit gate exclusively, so no write is in flight into the old active once it is an
+ * immutable, and every write it took is already in its own filter.
+ *  - recovery: WAL replay applies its records through the same apply as a live commit
+ *    (tidesdb_l0_apply_entries), into memtables the engine created with a filter, so a replayed
+ *    memtable's filter holds every key it replayed.
+ *  - tombstones are skip list entries like any other and set bits; a range tombstone is not, and
+ *    the reader consults the memtable's interval set whatever the filter says.
+ *  - an abandoned commit leaves its bits set. that is a false positive, which costs one descent.
+ */
+
+/* the smallest filter a memtable gets, and the share of the write buffer one gets above it */
+#define TDB_MEMTABLE_BLOOM_MIN_BYTES    (64u * 1024u)
+#define TDB_MEMTABLE_BLOOM_BUFFER_SHARE 64u
+
+/* one block is a cache line of eight words, and a key sets this many of its 512 bits */
+#define TDB_MEMTABLE_BLOOM_BLOCK_BYTES 64u
+#define TDB_MEMTABLE_BLOOM_BLOCK_WORDS 8u
+#define TDB_MEMTABLE_BLOOM_PROBES      6
+#define TDB_MEMTABLE_BLOOM_BIT_BITS    9 /* log2 of the bits in a block */
+
+/* the second hash the in-block bits come from: splitmix64's finalizer over the key's hash, whose
+ * high half already picked the block */
+static inline uint64_t tdb_memtable_bloom_mix(uint64_t z)
+{
+    z ^= z >> 30;
+    z *= 0xbf58476d1ce4e5b9ULL;
+    z ^= z >> 27;
+    z *= 0x94d049bb133111ebULL;
+    z ^= z >> 31;
+    return z;
+}
+
+/* the block a hash lands in, scaled onto the block count rather than masked, so the count need not
+ * be a power of two */
+static inline _Atomic(uint64_t) *tdb_memtable_bloom_block(const tidesdb_memtable_t *mt,
+                                                          const uint64_t h)
+{
+    const uint64_t idx = ((h >> 32) * (uint64_t)mt->bloom_blocks) >> 32;
+    return mt->bloom + idx * TDB_MEMTABLE_BLOOM_BLOCK_WORDS;
+}
