+
+int level_set_range_covering(level_set_t *ls, const uint8_t *key, const size_t key_size,
+                             const uint64_t snapshot, uint64_t *out_seq)
+{
+    if (!ls || !key || !out_seq) return 0;
+
+    tdb_epoch_enter(&ls->epoch);
+    const level_layout_t *lay = atomic_load_explicit(&ls->layout, memory_order_acquire);
+    int covered = 0;
+    if (lay->covering)
+        covered =
+            range_tombstone_max_covering(lay->covering, key, key_size, snapshot, out_seq) == 1;
+    else if (lay->carrying > 0)
+        covered = level_layout_walk_covering(lay, key, key_size, snapshot, out_seq);
+    tdb_epoch_exit(&ls->epoch);
+    return covered;
+}
