+/**
+ * range_tombstone_set_merge
+ * build one set answering for several at once -- every key covered by any input is covered in the
+ * result by the union of the sequences the inputs cover it with, so a query of the result gives the
+ * newest sequence at or below a snapshot across all of them. the inputs are only read, and the
+ * result shares no storage with them. the inputs' fragments are sorted together and swept once with
+ * a heap of the ones covering the sweep position, so the work is the sort of the total fragment
+ * count plus, at every piece, the sequences of the fragments overlapping there. adjacent pieces
+ * covered alike are folded into one fragment
+ * @param sets the sets to merge, any of which may be NULL or empty
+ * @param n how many sets
+ * @param out receives the merged set, owned by the caller, empty when no input covers anything
+ * @return TDB_SUCCESS, TDB_ERR_INVALID_ARGS when out is NULL or sets is NULL with n non-zero, or
+ *         TDB_ERR_MEMORY, in which case *out is left NULL
+ */
+int range_tombstone_set_merge(const range_tombstone_set_t *const *sets, size_t n,
+                              range_tombstone_set_t **out);
