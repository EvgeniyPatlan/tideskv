+ * @param snapshot the inclusive sequence ceiling
+ * @param out_seq receives the newest covering sequence when the call returns 1
+ * @return 1 when covered, 0 otherwise
+ */
+static int level_layout_walk_covering(const level_layout_t *lay, const uint8_t *key,
+                                      const size_t key_size, const uint64_t snapshot,
+                                      uint64_t *out_seq)
+{
+    int covered = 0;
+    uint64_t newest = 0;
+    for (int i = 0; i < LEVEL_SET_MAX_LEVELS; i++)
+        for (int j = 0; j < lay->counts[i]; j++)
+        {
+            const range_tombstone_set_t *rt = lay->levels[i][j].sst->range_tombstones;
+            uint64_t seq = 0;
+            if (rt && range_tombstone_max_covering(rt, key, key_size, snapshot, &seq) == 1 &&
+                (!covered || seq > newest))
+            {
