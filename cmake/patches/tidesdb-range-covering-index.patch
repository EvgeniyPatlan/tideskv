diff --git a/src/range_tombstone/range_tombstone.c b/src/range_tombstone/range_tombstone.c
index 8762870..4385746 100644
--- a/src/range_tombstone/range_tombstone.c
+++ b/src/range_tombstone/range_tombstone.c
@@ -695,3 +695,296 @@ int range_tombstone_prefix_successor(const uint8_t *prefix, const size_t prefix_
     *out_hi_size = n;
     return TDB_SUCCESS;
 }
+
+/**
+ * rt_seq_desc
+ * order two sequences descending, for qsort
+ * @param a the first sequence
+ * @param b the second sequence
+ * @return negative when a is the larger, positive when b is, 0 when equal
+ */
+static int rt_seq_desc(const void *a, const void *b)
+{
+    const uint64_t x = *(const uint64_t *)a;
+    const uint64_t y = *(const uint64_t *)b;
+    return x > y ? -1 : (x < y ? 1 : 0);
+}
+
+/**
+ * rt_frag_lo_cmp
+ * order two borrowed fragments by lower bound, for qsort
+ * @param a pointer to the first fragment pointer
+ * @param b pointer to the second fragment pointer
+ * @return negative, zero, or positive as a's lower bound orders before, with or after b's
+ */
+static int rt_frag_lo_cmp(const void *a, const void *b)
+{
+    const rt_fragment_t *x = *(const rt_fragment_t *const *)a;
+    const rt_fragment_t *y = *(const rt_fragment_t *const *)b;
+    return tdb_key_cmp(x->lo, x->lo_size, y->lo, y->lo_size);
+}
+
+/**
+ * rt_merge_state_t
+ * the sweep a merge runs over every input fragment at once
+ * @param order every input fragment, borrowed, sorted by lower bound
+ * @param total how many there are
+ * @param next the first fragment of order not yet reached by the sweep
+ * @param active the fragments covering the sweep position, a min-heap on upper bound
+ * @param n_active how many fragments active holds
+ * @param seqs scratch the covering sequences of one piece are gathered into
+ * @param seq_cap capacity of seqs
+ */
+typedef struct
+{
+    const rt_fragment_t **order;
+    size_t total;
+    size_t next;
+    const rt_fragment_t **active;
+    size_t n_active;
+    uint64_t *seqs;
+    size_t seq_cap;
+} rt_merge_state_t;
+
+/**
+ * rt_heap_less
+ * whether fragment a ends before fragment b, the heap order of the active fragments
+ * @param a the first fragment
+ * @param b the second fragment
+ * @return 1 when a's upper bound orders before b's
+ */
+static int rt_heap_less(const rt_fragment_t *a, const rt_fragment_t *b)
+{
+    return rt_hi_cmp_hi(a->hi, a->hi_size, b->hi, b->hi_size) < 0;
+}
+
+/**
+ * rt_heap_push
+ * add a fragment to the active heap, which is sized to hold every input fragment
+ * @param st the sweep
+ * @param f the fragment
+ */
+static void rt_heap_push(rt_merge_state_t *st, const rt_fragment_t *f)
+{
+    size_t i = st->n_active++;
+    while (i > 0)
+    {
+        const size_t parent = (i - 1) / 2;
+        if (!rt_heap_less(f, st->active[parent])) break;
+        st->active[i] = st->active[parent];
+        i = parent;
+    }
+    st->active[i] = f;
+}
+
+/**
+ * rt_heap_pop
+ * remove the active fragment that ends first
+ * @param st the sweep, holding at least one active fragment
+ */
+static void rt_heap_pop(rt_merge_state_t *st)
+{
+    const rt_fragment_t *last = st->active[--st->n_active];
+    size_t i = 0;
+    for (;;)
+    {
+        size_t child = 2 * i + 1;
+        if (child >= st->n_active) break;
+        if (child + 1 < st->n_active && rt_heap_less(st->active[child + 1], st->active[child]))
+            child++;
+        if (!rt_heap_less(st->active[child], last)) break;
+        st->active[i] = st->active[child];
+        i = child;
+    }
+    if (st->n_active > 0) st->active[i] = last;
+}
+
+/**
+ * rt_merge_gather
+ * collect, sorted descending without repeats, every sequence of the active fragments -- the ones
+ * covering the piece the sweep is at
+ * @param st the sweep, with at least one active fragment
+ * @param out_count receives how many sequences were gathered
+ * @return TDB_SUCCESS or TDB_ERR_MEMORY
+ */
+static int rt_merge_gather(rt_merge_state_t *st, size_t *out_count)
+{
+    size_t count = 0;
+    for (size_t i = 0; i < st->n_active; i++) count += st->active[i]->seq_count;
+    if (count > st->seq_cap)
+    {
+        size_t grown = st->seq_cap ? st->seq_cap : RT_APPEND_INITIAL_CAPACITY;
+        while (grown < count) grown *= 2;
+        uint64_t *seqs = realloc(st->seqs, grown * sizeof(uint64_t));
+        if (!seqs) return TDB_ERR_MEMORY;
+        st->seqs = seqs;
+        st->seq_cap = grown;
+    }
+    size_t at = 0;
+    for (size_t i = 0; i < st->n_active; i++)
+    {
+        memcpy(st->seqs + at, st->active[i]->seqs, st->active[i]->seq_count * sizeof(uint64_t));
+        at += st->active[i]->seq_count;
+    }
+    /* one fragment's sequences already descend without repeats, which is the common case of
+     * intervals that do not overlap across tables */
+    if (st->n_active > 1)
+    {
+        qsort(st->seqs, count, sizeof(uint64_t), rt_seq_desc);
+        size_t kept = 1;
+        for (size_t i = 1; i < count; i++)
+            if (st->seqs[i] != st->seqs[kept - 1]) st->seqs[kept++] = st->seqs[i];
+        count = kept;
+    }
+    *out_count = count;
+    return TDB_SUCCESS;
+}
+
+/**
+ * rt_merge_emit
+ * append the piece [lo, hi) covered by seqs, or widen the last fragment over it when that one ends
+ * where the piece starts and is covered by exactly the same sequences
+ * @param out the set being built
+ * @param lo inclusive lower bound
+ * @param lo_size length of lo
+ * @param hi exclusive upper bound, NULL when unbounded above
+ * @param hi_size length of hi, RT_UNBOUNDED_ABOVE when unbounded above
+ * @param seqs the covering sequences, strictly descending
+ * @param seq_count how many, never zero
+ * @return TDB_SUCCESS, TDB_ERR_MEMORY, or TDB_ERR_INVALID_ARGS on a piece out of order
+ */
+static int rt_merge_emit(range_tombstone_set_t *out, const uint8_t *lo, const size_t lo_size,
+                         const uint8_t *hi, const size_t hi_size, const uint64_t *seqs,
+                         const size_t seq_count)
+{
+    if (out->count > 0)
+    {
+        rt_fragment_t *last = &out->frags[out->count - 1];
+        if (last->hi_size != RT_UNBOUNDED_ABOVE &&
+            tdb_key_cmp(last->hi, last->hi_size, lo, lo_size) == 0 &&
+            last->seq_count == seq_count &&
+            memcmp(last->seqs, seqs, seq_count * sizeof(uint64_t)) == 0)
+        {
+            uint8_t *widened = NULL;
+            if (hi_size > RT_UNBOUNDED_ABOVE)
+            {
+                widened = malloc(hi_size);
+                if (!widened) return TDB_ERR_MEMORY;
+                memcpy(widened, hi, hi_size);
+            }
+            free(last->hi);
+            last->hi = widened;
+            last->hi_size = hi_size;
+            return TDB_SUCCESS;
+        }
+    }
+    return range_tombstone_set_append_fragment(out, lo, lo_size, hi, hi_size, seqs, seq_count);
+}
+
+/**
+ * rt_merge_sweep
+ * walk every boundary of every input in key order, emitting each piece something covers. at each
+ * position the fragments starting there join the active heap and the ones ending there leave it;
+ * the next position is the nearer of the next fragment's start and the first active end. each
+ * fragment joins and leaves once, so the sweep costs the sort plus a heap step a fragment, plus
+ * the active fragments' sequences at every piece -- one fragment's worth where intervals do not
+ * overlap across tables
+ * @param st the sweep, order sorted, nothing active
+ * @param out the empty set to build into
+ * @return TDB_SUCCESS, TDB_ERR_MEMORY, or TDB_ERR_INVALID_ARGS on an input that is not fragmented
+ */
+static int rt_merge_sweep(rt_merge_state_t *st, range_tombstone_set_t *out)
+{
+    if (st->total == 0) return TDB_SUCCESS;
+    const uint8_t *pos = st->order[0]->lo;
+    size_t pos_size = st->order[0]->lo_size;
+    for (;;)
+    {
+        while (st->next < st->total &&
+               tdb_key_cmp(st->order[st->next]->lo, st->order[st->next]->lo_size, pos, pos_size) <=
+                   0)
+            rt_heap_push(st, st->order[st->next++]);
+        while (st->n_active > 0 &&
+               rt_hi_cmp_key(st->active[0]->hi, st->active[0]->hi_size, pos, pos_size) <= 0)
+            rt_heap_pop(st);
+
+        if (st->n_active == 0)
+        {
+            /* a gap no input covers; the sweep resumes at the next fragment to start */
+            if (st->next == st->total) return TDB_SUCCESS;
+            pos = st->order[st->next]->lo;
+            pos_size = st->order[st->next]->lo_size;
+            continue;
+        }
+
+        const rt_fragment_t *ends = st->active[0];
+        const uint8_t *next = ends->hi;
+        size_t next_size = ends->hi_size;
+        if (st->next < st->total && rt_hi_cmp_key(next, next_size, st->order[st->next]->lo,
+                                                  st->order[st->next]->lo_size) > 0)
+        {
+            next = st->order[st->next]->lo;
+            next_size = st->order[st->next]->lo_size;
+        }
+        else if (next_size == RT_UNBOUNDED_ABOVE)
+            next = NULL;
+
+        size_t seq_count = 0;
+        const int rc = rt_merge_gather(st, &seq_count);
+        if (rc != TDB_SUCCESS) return rc;
+        const int erc = rt_merge_emit(out, pos, pos_size, next, next_size, st->seqs, seq_count);
+        if (erc != TDB_SUCCESS) return erc;
+
+        /* a piece running to the end of the order is the last one there can be */
+        if (next_size == RT_UNBOUNDED_ABOVE) return TDB_SUCCESS;
+        pos = next;
+        pos_size = next_size;
+    }
+}
+
+int range_tombstone_set_merge(const range_tombstone_set_t *const *sets, const size_t n,
+                              range_tombstone_set_t **out)
+{
+    if (!out) return TDB_ERR_INVALID_ARGS;
+    *out = NULL;
+    if (!sets && n > 0) return TDB_ERR_INVALID_ARGS;
+
+    range_tombstone_set_t *merged = range_tombstone_set_new();
+    if (!merged) return TDB_ERR_MEMORY;
+
+    size_t total = 0;
+    for (size_t i = 0; i < n; i++) total += range_tombstone_set_count(sets[i]);
+    if (total == 0)
+    {
+        *out = merged;
+        return TDB_SUCCESS;
+    }
+
+    rt_merge_state_t st = {.order = malloc(total * sizeof(rt_fragment_t *)),
+                           .total = total,
+                           .next = 0,
+                           .active = malloc(total * sizeof(rt_fragment_t *)),
+                           .n_active = 0,
+                           .seqs = NULL,
+                           .seq_cap = 0};
+    int rc = TDB_ERR_MEMORY;
+    if (st.order && st.active)
+    {
+        size_t k = 0;
+        for (size_t i = 0; i < n; i++)
+            for (size_t j = 0; j < range_tombstone_set_count(sets[i]); j++)
+                st.order[k++] = &sets[i]->frags[j];
+        qsort(st.order, total, sizeof(rt_fragment_t *), rt_frag_lo_cmp);
+        rc = rt_merge_sweep(&st, merged);
+    }
+    free(st.order);
+    free(st.active);
+    free(st.seqs);
+    if (rc != TDB_SUCCESS)
+    {
+        range_tombstone_set_free(merged);
+        return rc;
+    }
+    *out = merged;
+    return TDB_SUCCESS;
+}
