+
+/* what covers a key across a family's tables. an interval covers a range the table carrying it need
+ * not hold a single key of, so a family answers from one index merged out of every table's
+ * intervals, built when a layout is published and freed with it. these cases hold that index to the
+ * answer a scan of every table would give -- past any table count, at any snapshot, and while
+ * layouts change under readers */
+
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../src/base/errors.h"
+#include "../src/base/keycmp.h"
+#include "../src/compaction/compaction_exec.h"
+#include "../src/flush/flush.h"
+#include "../src/range_tombstone/range_tombstone.h"
+#include "../src/txn/cf_source.h"
+#include "test_utils.h"
+
+static int tests_passed = 0;
+static int tests_failed = 0;
+
+#define RC_DB_DIR    "." PATH_SEPARATOR "test_range_covering_db"
+#define RC_MAX_LEVEL 12
+#define RC_PROB      0.25f
+
+typedef struct
+{
+    vlog_t *vlog;
+    cache_t *cache;
+    fd_manager_t fdm;
+    tidesdb_manifest_t *manifest;
+    char manifest_path[256];
+    tidesdb_l0_t *l0;
+    cf_t *cf;
+    _Atomic(uint64_t) next_id;
+    uint64_t generation;
+} rc_db_t;
+
+static void rc_db_open(rc_db_t *db)
+{
+    (void)remove_directory(RC_DB_DIR);
+    ASSERT_EQ(mkdir(RC_DB_DIR, 0755), 0);
+    const vlog_config_t vc = {.sync_mode = BLOCK_MANAGER_SYNC_NONE, .segment_target_bytes = 0};
+    ASSERT_EQ(vlog_open(RC_DB_DIR, &vc, &db->vlog), VLOG_OK);
+    db->cache = cache_create(NULL);
+    ASSERT_EQ(fd_manager_init(&db->fdm, 0), 0);
+    snprintf(db->manifest_path, sizeof(db->manifest_path), "%s%sMANIFEST", RC_DB_DIR,
+             PATH_SEPARATOR);
+    db->manifest = tidesdb_manifest_open(db->manifest_path);
+    ASSERT_TRUE(db->manifest != NULL);
+
+    tidesdb_column_family_config_t cfg;
+    memset(&cfg, 0, sizeof(cfg));
+    snprintf(cfg.name, sizeof(cfg.name), "%s", "cf0");
+    cfg.level_size_ratio = 10;
+    cfg.min_levels = 3;
+    cfg.btree_klog_block_size = 4096;
+    ASSERT_EQ(
+        cf_create(RC_DB_DIR, 0, &cfg, NULL, db->vlog, db->cache, &db->fdm, NULL, NULL, &db->cf), 0);
+    ASSERT_EQ(tidesdb_manifest_add_cf(db->manifest, 0, "cf0", NULL, 0), 0);
+
+    db->l0 = tidesdb_l0_create(64 * 1024, 8, RC_MAX_LEVEL, RC_PROB, NULL, NULL);
+    tidesdb_l0_set_active(db->l0,
+                          tidesdb_memtable_create(NULL, 0, 0, RC_MAX_LEVEL, RC_PROB, NULL, NULL));
+    atomic_init(&db->next_id, 100);
+    db->generation = 1;
+}
+
+static void rc_db_close(rc_db_t *db)
+{
+    tidesdb_l0_destroy(db->l0);
+    cf_free(db->cf);
+    tidesdb_manifest_close(db->manifest);
+    fd_manager_destroy(&db->fdm);
+    cache_destroy(db->cache);
+    vlog_close(db->vlog);
+    (void)remove_directory(RC_DB_DIR);
+}
+
+/* write one live version into the active memtable */
+static void rc_put(rc_db_t *db, const char *key, uint64_t seq)
+{
+    ASSERT_EQ(tidesdb_l0_apply(db->l0, 0, (const uint8_t *)key, strlen(key), (const uint8_t *)"v",
+                               1, -1, seq, 0),
+              TDB_SUCCESS);
+}
+
+/* lay [lo, hi) at seq into the active memtable, hi NULL for unbounded above */
+static void rc_range(rc_db_t *db, const char *lo, const char *hi, uint64_t seq)
+{
+    ASSERT_EQ(tidesdb_l0_apply_range_tombstone(db->l0, 0, (const uint8_t *)lo, strlen(lo),
+                                               (const uint8_t *)hi, hi ? strlen(hi) : 0, seq),
+              TDB_SUCCESS);
+}
+
+/* rotate the active memtable and flush it into one L1 table */
+static void rc_flush(rc_db_t *db)
+{
+    db->generation++;
+    ASSERT_EQ(
+        tidesdb_l0_rotate(db->l0, tidesdb_memtable_create(NULL, db->generation, db->generation,
+                                                          RC_MAX_LEVEL, RC_PROB, NULL, NULL)),
+        TDB_SUCCESS);
+    tidesdb_memtable_t *immutable = tidesdb_l0_dequeue_immutable(db->l0);
+    cf_t *cfs[1] = {db->cf};
+    flush_ctx_t fx = {.l0 = db->l0,
+                      .cfs = cfs,
+                      .n_cfs = 1,
+                      .manifest = db->manifest,
+                      .manifest_path = db->manifest_path,
+                      .next_sstable_id = &db->next_id,
+                      .fdm = &db->fdm,
+                      .sync_mode = BLOCK_MANAGER_SYNC_NONE,
+                      .value_threshold = 1u << 20};
+    ASSERT_EQ(flush_immutable(&fx, immutable), TDB_SUCCESS);
+}
+
+/* merge every table of the family into one run at level 2, keeping every interval */
+static void rc_compact_all(rc_db_t *db)
+{
+    const int total = level_set_snapshot(db->cf->levels, NULL, 0);
+    if (total == 0) return;
+    level_set_snapshot_entry_t *all = calloc((size_t)total, sizeof(*all));
+    ASSERT_TRUE(all != NULL);
+    ASSERT_EQ(level_set_snapshot(db->cf->levels, all, total), total);
+    uint64_t *ids = malloc((size_t)total * sizeof(uint64_t));
+    ASSERT_TRUE(ids != NULL);
+    for (int i = 0; i < total; i++) ids[i] = all[i].sst->id;
+    for (int i = 0; i < total; i++)
+        if (sstable_unref(all[i].sst)) sstable_close(all[i].sst);
+    free(all);
+
+    const compaction_job_t job = {.input_ids = ids,
+                                  .n_inputs = total,
+                                  .target_level = 2,
+                                  .is_largest_level = 0,
+                                  .split = COMPACTION_SPLIT_NONE,
+                                  .file_max = 0};
+    const compaction_ctx_t cx = {.cf = db->cf,
+                                 .manifest = db->manifest,
+                                 .manifest_path = db->manifest_path,
+                                 .next_sstable_id = &db->next_id,
+                                 .gc_floor = 0,
+                                 .sync_mode = BLOCK_MANAGER_SYNC_NONE,
+                                 .value_threshold = 1u << 20};
+    ASSERT_EQ(compaction_exec(&cx, &job), TDB_SUCCESS);
+    free(ids);
+}
+
+/* the answer a scan of every table in the family gives -- the reference the index is held to */
+static int rc_brute_cf(cf_t *cf, const uint8_t *key, size_t key_size, uint64_t snapshot,
+                       uint64_t *out_seq)
+{
+    const int total = level_set_collect_all(cf->levels, NULL, 0);
+    sstable_t **tables = calloc((size_t)total + 1, sizeof(*tables));
+    ASSERT_TRUE(tables != NULL);
+    ASSERT_EQ(level_set_collect_all(cf->levels, tables, total), total);
+    int covered = 0;
+    uint64_t newest = 0;
+    for (int i = 0; i < total; i++)
+    {
+        uint64_t seq = 0;
+        if (tables[i]->range_tombstones &&
+            range_tombstone_max_covering(tables[i]->range_tombstones, key, key_size, snapshot,
+                                         &seq) == 1 &&
+            (!covered || seq > newest))
+        {
+            covered = 1;
+            newest = seq;
+        }
+        if (sstable_unref(tables[i])) sstable_close(tables[i]);
+    }
+    free(tables);
+    if (covered) *out_seq = newest;
+    return covered;
+}
+
+/* a point read of key through the family's sstable source; 1 when it reads a live version */
+static int rc_point_live(cf_t *cf, const char *key, uint64_t snapshot)
+{
+    tidesdb_source_t src;
+    cf_source(cf, &src);
+    for (;;)
+    {
+        tidesdb_source_version_t v;
+        memset(&v, 0, sizeof(v));
+        const tidesdb_source_result_t r =
+            src.get(src.ctx, 0, (const uint8_t *)key, strlen(key), snapshot, &v);
+        if (r == TDB_SOURCE_BUSY) continue;
+        if (r != TDB_SOURCE_FOUND) return 0;
+        free(v.value);
+        return v.deleted ? 0 : 1;
+    }
+}
+
+/* more tables than the old 512-table scan would look at, the interval in the oldest of them. a
+ * family past that count answered "covered by nothing" and the deleted key came back */
+#define RC_MANY_TABLES 600
+
+void test_covering_sees_past_table_512(void)
+{
+    rc_db_t db;
+    rc_db_open(&db);
+
+    rc_put(&db, "k00015", 1);
+    rc_range(&db, "k0001", "k0002", 2);
+    rc_flush(&db);
+    for (int i = 1; i < RC_MANY_TABLES; i++)
+    {
+        char key[16];
+        snprintf(key, sizeof(key), "z%05d", i);
+        rc_put(&db, key, (uint64_t)(2 + i));
+        rc_flush(&db);
+    }
+    ASSERT_EQ(level_set_count(db.cf->levels, LEVEL_SET_L1), RC_MANY_TABLES);
+
+    uint64_t seq = 0;
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"k00015", 6, UINT64_MAX, &seq),
+              1);
+    ASSERT_EQ(seq, 2);
+    ASSERT_EQ(rc_point_live(db.cf, "k00015", UINT64_MAX), 0);
+    /* outside the interval, the keys still read */
+    ASSERT_EQ(rc_point_live(db.cf, "z00007", UINT64_MAX), 1);
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"k0002", 5, UINT64_MAX, &seq), 0);
+
+    rc_db_close(&db);
+}
+
+/* ===== the merge against a scan of every set ===== */
+
+#define RC_CASES        2000
+#define RC_MAX_SETS     40
+#define RC_MAX_TOMBS    6
+#define RC_KEY_MAX      3
+#define RC_ALPHABET     3
+#define RC_SEQ_MAX      100
+#define RC_UNBOUNDED_1N 10 /* one in this many intervals runs to the end of the order */
+
+static uint32_t rc_rand(uint32_t *s)
+{
+    *s ^= *s << 13;
+    *s ^= *s >> 17;
+    *s ^= *s << 5;
+    return *s;
+}
+
+/* a random key of 0..RC_KEY_MAX bytes over a small alphabet, so intervals share endpoints often */
+static size_t rc_rand_key(uint32_t *s, uint8_t *out)
+{
+    const size_t n = rc_rand(s) % (RC_KEY_MAX + 1);
+    for (size_t i = 0; i < n; i++) out[i] = (uint8_t)('a' + rc_rand(s) % RC_ALPHABET);
+    return n;
+}
+
+static void rc_fill_set(uint32_t *s, range_tombstone_set_t *set)
+{
+    const int tombs = (int)(rc_rand(s) % (RC_MAX_TOMBS + 1));
+    for (int t = 0; t < tombs; t++)
+    {
+        uint8_t lo[RC_KEY_MAX], hi[RC_KEY_MAX];
+        const size_t lo_size = rc_rand_key(s, lo);
+        const int unbounded = rc_rand(s) % RC_UNBOUNDED_1N == 0;
+        const size_t hi_size = unbounded ? RT_UNBOUNDED_ABOVE : rc_rand_key(s, hi);
+        if (!range_tombstone_interval_valid(lo, lo_size, unbounded ? NULL : hi, hi_size)) continue;
+        const uint64_t seq = 1 + rc_rand(s) % RC_SEQ_MAX;
+        ASSERT_EQ(range_tombstone_set_add(set, lo, lo_size, unbounded ? NULL : hi, hi_size, seq),
+                  TDB_SUCCESS);
+    }
+}
+
+static int rc_brute_sets(range_tombstone_set_t *const *sets, int n, const uint8_t *key,
+                         size_t key_size, uint64_t snapshot, uint64_t *out_seq)
+{
+    int covered = 0;
+    uint64_t newest = 0;
+    for (int i = 0; i < n; i++)
+    {
+        uint64_t seq = 0;
+        if (range_tombstone_max_covering(sets[i], key, key_size, snapshot, &seq) == 1 &&
+            (!covered || seq > newest))
+        {
+            covered = 1;
+            newest = seq;
+        }
+    }
+    if (covered) *out_seq = newest;
+    return covered;
+}
+
+/* every key of 0..RC_KEY_MAX bytes over the alphabet, which includes every interval endpoint */
+static void rc_probe_all(range_tombstone_set_t *const *sets, int n,
+                         const range_tombstone_set_t *merged, uint32_t *s)
+{
+    uint8_t key[RC_KEY_MAX];
+    int digits[RC_KEY_MAX];
+    for (size_t len = 0; len <= RC_KEY_MAX; len++)
+    {
+        for (size_t i = 0; i < len; i++) digits[i] = 0;
+        for (;;)
+        {
+            for (size_t i = 0; i < len; i++) key[i] = (uint8_t)('a' + digits[i]);
+            const uint64_t snaps[3] = {UINT64_MAX, rc_rand(s) % (RC_SEQ_MAX + 2),
+                                       rc_rand(s) % (RC_SEQ_MAX + 2)};
+            for (int k = 0; k < 3; k++)
+            {
+                uint64_t want = 0, got = 0;
+                const int w = rc_brute_sets(sets, n, key, len, snaps[k], &want);
+                const int g = range_tombstone_max_covering(merged, key, len, snaps[k], &got);
+                ASSERT_EQ(g, w);
+                if (w) ASSERT_EQ(got, want);
+            }
+            size_t d = 0;
+            while (d < len && ++digits[d] == RC_ALPHABET) digits[d++] = 0;
+            if (d == len) break;
+        }
+    }
+}
+
+/* the merged fragments ascend without overlap and adjacent equal runs are folded together, so the
+ * index is no larger than the boundaries it has to tell apart */
+static void rc_assert_well_formed(const range_tombstone_set_t *merged)
+{
+    const size_t n = range_tombstone_set_count(merged);
+    for (size_t i = 0; i < n; i++)
+    {
+        const rt_fragment_t *f = NULL;
+        ASSERT_EQ(range_tombstone_set_fragment_at(merged, i, &f), TDB_SUCCESS);
+        ASSERT_TRUE(f->seq_count > 0);
+        for (size_t j = 1; j < f->seq_count; j++) ASSERT_TRUE(f->seqs[j] < f->seqs[j - 1]);
+        if (i == 0) continue;
+        const rt_fragment_t *p = NULL;
+        ASSERT_EQ(range_tombstone_set_fragment_at(merged, i - 1, &p), TDB_SUCCESS);
+        ASSERT_TRUE(p->hi_size != RT_UNBOUNDED_ABOVE);
+        ASSERT_TRUE(tdb_key_cmp(p->hi, p->hi_size, f->lo, f->lo_size) <= 0);
+        const int touching = tdb_key_cmp(p->hi, p->hi_size, f->lo, f->lo_size) == 0;
+        const int same = p->seq_count == f->seq_count &&
+                         memcmp(p->seqs, f->seqs, f->seq_count * sizeof(uint64_t)) == 0;
+        ASSERT_FALSE(touching && same);
+    }
+}
+
+/* cases also run through a real family, the layout's own index against a scan of its tables */
+#define RC_CF_CASES      6
+#define RC_CF_MAX_TABLES 12
+
+static void rc_cf_case(uint32_t *s)
+{
+    rc_db_t db;
+    rc_db_open(&db);
+    const int tables = 1 + (int)(rc_rand(s) % RC_CF_MAX_TABLES);
+    uint64_t seq = 1;
+    for (int t = 0; t < tables; t++)
+    {
+        const int tombs = (int)(rc_rand(s) % (RC_MAX_TOMBS + 1));
+        for (int k = 0; k < tombs; k++)
+        {
+            uint8_t lo[RC_KEY_MAX + 1], hi[RC_KEY_MAX + 1];
+            /* the memtable refuses an empty lower bound, so these start at one byte */
+            size_t lo_size = rc_rand_key(s, lo);
+            if (lo_size == 0) lo[lo_size++] = 'a';
+            const int unbounded = rc_rand(s) % RC_UNBOUNDED_1N == 0;
+            const size_t hi_size = unbounded ? 0 : rc_rand_key(s, hi);
+            if (!unbounded && !range_tombstone_interval_valid(lo, lo_size, hi, hi_size)) continue;
+            ASSERT_EQ(tidesdb_l0_apply_range_tombstone(db.l0, 0, lo, lo_size, unbounded ? NULL : hi,
+                                                       hi_size, seq++),
+                      TDB_SUCCESS);
+        }
+        rc_put(&db, "zz", seq++);
+        rc_flush(&db);
+    }
+
+    uint8_t key[RC_KEY_MAX];
+    for (int p = 0; p < 200; p++)
+    {
+        const size_t len = rc_rand_key(s, key);
+        if (len == 0) continue;
+        const uint64_t snap = rc_rand(s) % 3 == 0 ? UINT64_MAX : rc_rand(s) % (seq + 1);
+        uint64_t want = 0, got = 0;
+        const int w = rc_brute_cf(db.cf, key, len, snap, &want);
+        const int g = cf_range_tombstone_covering(db.cf, key, len, snap, &got);
+        ASSERT_EQ(g, w);
+        if (w) ASSERT_EQ(got, want);
+    }
+    rc_db_close(&db);
+}
+
+void test_covering_matches_brute_force(void)
+{
+    uint32_t s = 0x9e3779b9u;
+    for (int c = 0; c < RC_CASES; c++)
+    {
+        const int n = 1 + (int)(rc_rand(&s) % RC_MAX_SETS);
+        range_tombstone_set_t *sets[RC_MAX_SETS];
+        for (int i = 0; i < n; i++)
+        {
+            sets[i] = range_tombstone_set_new();
+            ASSERT_TRUE(sets[i] != NULL);
+            rc_fill_set(&s, sets[i]);
+        }
+
+        range_tombstone_set_t *merged = NULL;
+        ASSERT_EQ(range_tombstone_set_merge((const range_tombstone_set_t *const *)sets, (size_t)n,
+                                            &merged),
+                  TDB_SUCCESS);
+        ASSERT_TRUE(merged != NULL);
+        rc_assert_well_formed(merged);
+        rc_probe_all(sets, n, merged, &s);
+
+        range_tombstone_set_free(merged);
+        for (int i = 0; i < n; i++) range_tombstone_set_free(sets[i]);
+    }
+
+    /* an empty input merges into an empty set */
+    range_tombstone_set_t *merged = NULL;
+    ASSERT_EQ(range_tombstone_set_merge(NULL, 0, &merged), TDB_SUCCESS);
+    ASSERT_EQ(range_tombstone_set_count(merged), 0);
+    range_tombstone_set_free(merged);
+
+    for (int c = 0; c < RC_CF_CASES; c++) rc_cf_case(&s);
+}
+
+/* a tombstone newer than the reader's snapshot does not hide the key from it, and with several the
+ * newest at or below the snapshot is the one returned */
+void test_covering_respects_snapshot(void)
+{
+    rc_db_t db;
+    rc_db_open(&db);
+    rc_put(&db, "b", 10);
+    rc_flush(&db);
+    rc_range(&db, "a", "c", 50);
+    rc_put(&db, "q", 51);
+    rc_flush(&db);
+
+    uint64_t seq = 0;
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"b", 1, 40, &seq), 0);
+    ASSERT_EQ(rc_point_live(db.cf, "b", 40), 1);
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"b", 1, 60, &seq), 1);
+    ASSERT_EQ(seq, 50);
+    ASSERT_EQ(rc_point_live(db.cf, "b", 60), 0);
+
+    /* a newer one in another table, over part of the first */
+    rc_range(&db, "b", "bb", 70);
+    rc_put(&db, "q", 71);
+    rc_flush(&db);
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"b", 1, 40, &seq), 0);
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"b", 1, 60, &seq), 1);
+    ASSERT_EQ(seq, 50);
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"b", 1, 80, &seq), 1);
+    ASSERT_EQ(seq, 70);
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"bb", 2, 80, &seq), 1);
+    ASSERT_EQ(seq, 50);
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"c", 1, 80, &seq), 0);
+
+    rc_db_close(&db);
+    ASSERT_EQ(level_live_covering_indexes(), 0);
+}
+
+/* a family that never deleted a range carries no index and answers from the count alone */
+void test_no_intervals_no_index(void)
+{
+    rc_db_t db;
+    rc_db_open(&db);
+    for (int i = 0; i < 5; i++)
+    {
+        char key[16];
+        snprintf(key, sizeof(key), "k%03d", i);
+        rc_put(&db, key, (uint64_t)(i + 1));
+        rc_flush(&db);
+    }
+    rc_compact_all(&db);
+    rc_put(&db, "k999", 99);
+    rc_flush(&db);
+
+    ASSERT_EQ(level_set_interval_tables(db.cf->levels), 0);
+    ASSERT_EQ(level_set_covering_fragments(db.cf->levels), 0);
+    ASSERT_EQ(level_live_covering_indexes(), 0);
+    uint64_t seq = 0;
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"k001", 4, UINT64_MAX, &seq), 0);
+
+    /* the first range delete brings an index with it */
+    rc_range(&db, "k0", "k1", 100);
+    rc_flush(&db);
+    ASSERT_TRUE(level_set_covering_fragments(db.cf->levels) > 0);
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"k001", 4, UINT64_MAX, &seq), 1);
+    ASSERT_EQ(seq, 100);
+
+    rc_db_close(&db);
+    ASSERT_EQ(level_live_covering_indexes(), 0);
+}
+
+/* ===== readers against layouts changing under them ===== */
+
+#define RC_READERS 4
+#define RC_CYCLES  50
+#define RC_TOMB    1000000u /* the seq of the interval every reader checks for, above any other */
+
+typedef struct
+{
+    cf_t *cf;
+    _Atomic(int) *stop;
+    uint64_t reads;
+    int wrong;
+} rc_reader_t;
+
+static void *rc_reader(void *arg)
+{
+    rc_reader_t *r = (rc_reader_t *)arg;
+    while (!atomic_load_explicit(r->stop, memory_order_acquire))
+    {
+        uint64_t seq = 0;
+        if (cf_range_tombstone_covering(r->cf, (const uint8_t *)"k00015", 6, UINT64_MAX, &seq) !=
+                1 ||
+            seq != RC_TOMB)
+            r->wrong++;
+        if (cf_range_tombstone_covering(r->cf, (const uint8_t *)"k00015", 6, RC_TOMB - 1, &seq) !=
+            0)
+            r->wrong++;
+        if (cf_range_tombstone_covering(r->cf, (const uint8_t *)"m", 1, UINT64_MAX, &seq) != 0)
+            r->wrong++;
+        r->reads++;
+    }
+    return NULL;
+}
+
+void test_index_survives_layout_change_under_readers(void)
+{
+    rc_db_t db;
+    rc_db_open(&db);
+    rc_put(&db, "k00015", 1);
+    rc_range(&db, "k0001", "k0002", RC_TOMB);
+    rc_flush(&db);
+
+    _Atomic(int) stop;
+    atomic_init(&stop, 0);
+    pthread_t threads[RC_READERS];
+    rc_reader_t readers[RC_READERS];
+    for (int i = 0; i < RC_READERS; i++)
+    {
+        readers[i] = (rc_reader_t){.cf = db.cf, .stop = &stop, .reads = 0, .wrong = 0};
+        ASSERT_EQ(pthread_create(&threads[i], NULL, rc_reader, &readers[i]), 0);
+    }
+
+    uint64_t seq = 2;
+    for (int c = 0; c < RC_CYCLES; c++)
+    {
+        /* new tables with keys and intervals of their own, away from the one readers check */
+        char key[16], lo[16], hi[16];
+        snprintf(key, sizeof(key), "x%05d", c);
+        snprintf(lo, sizeof(lo), "p%03d", c);
+        snprintf(hi, sizeof(hi), "p%03d~", c);
+        rc_put(&db, key, seq++);
+        rc_range(&db, lo, hi, seq++);
+        rc_flush(&db);
+        rc_put(&db, "y", seq++);
+        rc_flush(&db);
+        rc_compact_all(&db);
+        level_set_reclaim_deferred(db.cf->levels);
+    }
+
+    atomic_store_explicit(&stop, 1, memory_order_release);
+    uint64_t reads = 0;
+    for (int i = 0; i < RC_READERS; i++)
+    {
+        ASSERT_EQ(pthread_join(threads[i], NULL), 0);
+        ASSERT_EQ(readers[i].wrong, 0);
+        reads += readers[i].reads;
+    }
+    ASSERT_TRUE(reads > 0);
+    ASSERT_EQ(cf_range_tombstone_covering(db.cf, (const uint8_t *)"p007", 4, UINT64_MAX, &seq), 1);
+
+    rc_db_close(&db);
+    ASSERT_EQ(level_live_covering_indexes(), 0);
+}
+
+int main(int argc, char **argv)
+{
+    INIT_TEST_FILTER(argc, argv);
+    RUN_TEST_HANDLE_BALANCED(test_covering_sees_past_table_512, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_covering_matches_brute_force, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_covering_respects_snapshot, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_no_intervals_no_index, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_index_survives_layout_change_under_readers, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
