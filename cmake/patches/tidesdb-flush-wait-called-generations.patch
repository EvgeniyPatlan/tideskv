+/* the wait a synchronous flush (and a checkpoint through it) does after its rotation. it waits for
+ * every generation queued when it was called, the one it sealed included, and not for an empty
+ * queue: writers that outrun flush keep the queue from ever emptying, and a wait for empty would
+ * then run out its whole bound and report locked although the caller's data had landed */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "../src/engine/engine.h"       /* engine_force_rotate */
+#include "../src/engine/engine_types.h" /* db->l0, db->flush_lock, db->active_wal_gen */
+#include "../src/memtable/l0_internal.h"
+#include "../src/memtable/memtable.h"
+#include "db.h"
+#include "test_utils.h"
+
+static int tests_passed = 0;
+static int tests_failed = 0;
+
+#define FW_DB_DIR     "." PATH_SEPARATOR "test_flush_wait_db"
+#define FW_WRITERS    8
+#define FW_PUTS       16
+#define FW_KEY_SIZE   12
+#define FW_VALUE_SIZE 100
+#define FW_BUFFER     (64u * 1024u)
+/* a small queue limit, so writers block and refill it long before flush can empty it */
+#define FW_QUEUE_LIMIT 8
+/* the throttle holds the claim lock this long, then lets one claim through */
+#define FW_THROTTLE_HOLD_US 50000
+#define FW_THROTTLE_GAP_US  200
+/* how deep the queue must be before the call, so the test is in the regime it is about */
+#define FW_MIN_DEPTH     2
+#define FW_SETTLE_US     500000
+#define FW_DEPTH_WAIT_US 10000000
+#define FW_POLL_US       1000
+/* far below the 60 s backstop a wait for an empty queue runs out */
+#define FW_BOUND_US   (10ull * 1000 * 1000)
+#define FW_MAX_PINNED 4096
+
+typedef struct
+{
+    tidesdb_t *db;
+    tidesdb_column_family_t *cf;
+    int id;
+    _Atomic(int) *stop;
+    _Atomic(uint64_t) acked;
+} fw_arg_t;
+
+static uint64_t fw_now_us(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000ull + (uint64_t)ts.tv_nsec / 1000ull;
+}
+
+static void *fw_writer(void *arg)
+{
+    fw_arg_t *a = (fw_arg_t *)arg;
+    uint8_t value[FW_VALUE_SIZE];
+    memset(value, 'v', sizeof(value));
+    for (uint64_t i = 0; !atomic_load(a->stop); i++)
+    {
+        tidesdb_txn_t *txn = NULL;
+        ASSERT_EQ(tidesdb_txn_begin_with_isolation(a->db, TDB_ISOLATION_READ_COMMITTED, &txn),
+                  TDB_SUCCESS);
+        for (int j = 0; j < FW_PUTS; j++)
+        {
+            char key[FW_KEY_SIZE + 1];
+            snprintf(key, sizeof(key), "%02d%010llu", a->id,
+                     (unsigned long long)(i * FW_PUTS + (uint64_t)j));
+            ASSERT_EQ(tidesdb_txn_put(txn, a->cf, (const uint8_t *)key, FW_KEY_SIZE, value,
+                                      sizeof(value), -1),
+                      TDB_SUCCESS);
+        }
+        ASSERT_EQ(tidesdb_txn_commit(txn), TDB_SUCCESS);
+        tidesdb_txn_free(txn);
+        atomic_fetch_add(&a->acked, 1);
+    }
+    return NULL;
+}
+
+/* slow flush down by holding the lock a flush worker claims an immutable under, so rotations
+ * outrun it and the queue stays near its limit */
+static void *fw_throttle(void *arg)
+{
+    fw_arg_t *a = (fw_arg_t *)arg;
+    while (!atomic_load(a->stop))
+    {
+        pthread_mutex_lock(&a->db->flush_lock);
+        usleep(FW_THROTTLE_HOLD_US);
+        pthread_mutex_unlock(&a->db->flush_lock);
+        usleep(FW_THROTTLE_GAP_US);
+    }
+    return NULL;
+}
+
+/* whether any immutable still queued is of the given generation or older; the active memtable,
+ * which sits in the queue for a moment mid rotation, is not an immutable */
+static int fw_queue_holds_through(tidesdb_t *db, const uint64_t generation, int *depth)
+{
+    tidesdb_memtable_t **pinned = malloc(FW_MAX_PINNED * sizeof(*pinned));
+    ASSERT_TRUE(pinned != NULL);
+    int n = 0;
+    ASSERT_EQ(tidesdb_l0_pin_memtables(db->l0, pinned, FW_MAX_PINNED, &n), TDB_SUCCESS);
+    const tidesdb_memtable_t *active = atomic_load(&db->l0->active);
+    int holds = 0;
+    *depth = 0;
+    for (int i = 0; i < n; i++)
+    {
+        if (pinned[i] == active) continue;
+        (*depth)++;
+        if (pinned[i]->generation <= generation) holds = 1;
+    }
+    tidesdb_l0_unpin_memtables(pinned, n);
+    free(pinned);
+    return holds;
+}
+
+/* writers outrun a throttled flush, so the queue never empties. a checkpoint still returns
+ * promptly, and when it does no generation that was active or queued when it was called is left
+ * unflushed */
+void test_checkpoint_under_flush_bound_writers(void)
+{
+    (void)remove_directory(FW_DB_DIR);
+    tidesdb_config_t cfg = tidesdb_default_config();
+    cfg.db_path = FW_DB_DIR;
+    cfg.memtable_sync_mode = TDB_SYNC_NONE;
+    cfg.memtable_write_buffer_size = FW_BUFFER;
+    cfg.memtable_idle_flush_seconds = 0;
+    cfg.memtable_l0_queue_stall_threshold = FW_QUEUE_LIMIT;
+    cfg.num_flush_threads = 1;
+    tidesdb_t *db = NULL;
+    ASSERT_EQ(tidesdb_open(&cfg, &db), TDB_SUCCESS);
+    tidesdb_column_family_config_t cc = tidesdb_default_column_family_config();
+    ASSERT_EQ(tidesdb_create_column_family(db, "cf0", &cc), TDB_SUCCESS);
+    tidesdb_column_family_t *cf = tidesdb_get_column_family(db, "cf0");
+    ASSERT_TRUE(cf != NULL);
+
+    _Atomic(int) stop;
+    atomic_init(&stop, 0);
+    fw_arg_t args[FW_WRITERS + 1];
+    pthread_t threads[FW_WRITERS + 1];
+    for (int i = 0; i <= FW_WRITERS; i++)
+    {
+        args[i] = (fw_arg_t){.db = db, .cf = cf, .id = i, .stop = &stop};
+        atomic_init(&args[i].acked, 0);
+        ASSERT_EQ(
+            pthread_create(&threads[i], NULL, i < FW_WRITERS ? fw_writer : fw_throttle, &args[i]),
+            0);
+    }
+
+    /* into the regime: the queue is deep and has stayed fed for a while */
+    usleep(FW_SETTLE_US);
+    uint64_t waited = 0;
+    while (tidesdb_l0_queue_depth(db->l0) < FW_MIN_DEPTH && waited < FW_DEPTH_WAIT_US)
+    {
+        usleep(FW_POLL_US);
+        waited += FW_POLL_US;
+    }
+    const size_t depth_before = tidesdb_l0_queue_depth(db->l0);
+    ASSERT_TRUE(depth_before >= FW_MIN_DEPTH);
+
+    /* the active memtable's generation when the call is made; anything at or below it is what the
+     * call must see flushed. the published figure trails a swap by an instant, which only makes
+     * this a lower bound */
+    const uint64_t called_gen = atomic_load_explicit(&db->active_wal_gen, memory_order_acquire);
+    const uint64_t t0 = fw_now_us();
+    const int rc = tidesdb_checkpoint(db);
+    const uint64_t elapsed_us = fw_now_us() - t0;
+    int depth_after = 0;
+    const int holds = fw_queue_holds_through(db, called_gen, &depth_after);
+
+    atomic_store(&stop, 1);
+    uint64_t acked = 0;
+    for (int i = 0; i <= FW_WRITERS; i++)
+    {
+        ASSERT_EQ(pthread_join(threads[i], NULL), 0);
+        acked += atomic_load(&args[i].acked);
+    }
+    printf("(rc %d in %llu us, depth %zu before and %d after, called gen %llu, acked %llu) ", rc,
+           (unsigned long long)elapsed_us, depth_before, depth_after,
+           (unsigned long long)called_gen, (unsigned long long)acked);
+    fflush(stdout); /* the figures are the diagnosis when an assertion below aborts */
+    ASSERT_EQ(rc, TDB_SUCCESS);
+    ASSERT_TRUE(elapsed_us < FW_BOUND_US);
+    ASSERT_FALSE(holds);
+
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(FW_DB_DIR);
+}
+
+typedef struct
+{
+    tidesdb_t *db;
+    _Atomic(int) done;
+    int rc;
+} fw_flush_arg_t;
+
+static void *fw_flush_thread(void *arg)
+{
+    fw_flush_arg_t *a = (fw_flush_arg_t *)arg;
+    a->rc = tidesdb_flush_memtable(a->db);
+    atomic_store(&a->done, 1);
+    return NULL;
+}
+
+/* the sealed generation is not the only one to wait on: one queued by an earlier rotation is still
+ * only in memory, and a flush that finds the active memtable empty seals nothing at all. with the
+ * flush workers held off, a call must not return while such a generation is queued */
+void test_flush_waits_for_generations_queued_before_it(void)
+{
+    (void)remove_directory(FW_DB_DIR);
+    tidesdb_config_t cfg = tidesdb_default_config();
+    cfg.db_path = FW_DB_DIR;
+    cfg.memtable_sync_mode = TDB_SYNC_NONE;
+    cfg.memtable_idle_flush_seconds = 0;
+    cfg.num_flush_threads = 1;
+    tidesdb_t *db = NULL;
+    ASSERT_EQ(tidesdb_open(&cfg, &db), TDB_SUCCESS);
+    tidesdb_column_family_config_t cc = tidesdb_default_column_family_config();
+    ASSERT_EQ(tidesdb_create_column_family(db, "cf0", &cc), TDB_SUCCESS);
+    tidesdb_column_family_t *cf = tidesdb_get_column_family(db, "cf0");
+    ASSERT_TRUE(cf != NULL);
+
+    /* hold off every claim, then queue one generation behind an empty active memtable */
+    pthread_mutex_lock(&db->flush_lock);
+    tidesdb_txn_t *txn = NULL;
+    ASSERT_EQ(tidesdb_txn_begin(db, &txn), TDB_SUCCESS);
+    ASSERT_EQ(tidesdb_txn_put(txn, cf, (const uint8_t *)"k", 1, (const uint8_t *)"v", 1, -1),
+              TDB_SUCCESS);
+    ASSERT_EQ(tidesdb_txn_commit(txn), TDB_SUCCESS);
+    tidesdb_txn_free(txn);
+    ASSERT_EQ(engine_force_rotate(db), TDB_SUCCESS);
+    ASSERT_EQ(tidesdb_l0_active_bytes(db->l0), 0);
+    ASSERT_EQ(tidesdb_l0_queue_depth(db->l0), 1);
+
+    fw_flush_arg_t fa = {.db = db, .rc = -1};
+    atomic_init(&fa.done, 0);
+    pthread_t t;
+    ASSERT_EQ(pthread_create(&t, NULL, fw_flush_thread, &fa), 0);
+    usleep(FW_SETTLE_US / 5);
+    ASSERT_EQ(atomic_load(&fa.done), 0); /* the queued generation is not flushed yet */
+
+    pthread_mutex_unlock(&db->flush_lock);
+    ASSERT_EQ(pthread_join(t, NULL), 0);
+    ASSERT_EQ(fa.rc, TDB_SUCCESS);
+    ASSERT_EQ(tidesdb_l0_queue_depth(db->l0), 0);
+
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(FW_DB_DIR);
+}
+
+int main(int argc, char **argv)
+{
+    INIT_TEST_FILTER(argc, argv);
+    RUN_TEST(test_flush_waits_for_generations_queued_before_it, tests_passed);
+    RUN_TEST(test_checkpoint_under_flush_bound_writers, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
