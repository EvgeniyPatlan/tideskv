+    uint64_t seq[LZ_MODEL_KEYS]; /* 0 when the key was never written */
+    int deleted[LZ_MODEL_KEYS];
+    int range_lo[LZ_MODEL_RANGES];
+    int range_hi[LZ_MODEL_RANGES]; /* -1 for unbounded above */
+    uint64_t range_seq[LZ_MODEL_RANGES];
+    int n_ranges;
+    int visible[LZ_MODEL_KEYS]; /* the visible keys in order, filled by lz_model_settle */
+    int n_visible;
+} lz_model_t;
+
+static int lz4_available(void)
+{
+    return tidesdb_compression_available(TDB_COMPRESS_LZ4) != 0;
+}
+
+static void lz_db_open(lz_db_t *db, int lz4)
+{
+    memset(db, 0, sizeof(*db));
+    db->lz4 = lz4;
+    (void)remove_directory(LZ_DB_DIR);
+    ASSERT_EQ(mkdir(LZ_DB_DIR, 0755), 0);
+    ASSERT_EQ(tidesdb_encoding_registry_init(&db->reg), 0);
+    const vlog_config_t vc = {.sync_mode = BLOCK_MANAGER_SYNC_NONE, .segment_target_bytes = 0};
+    ASSERT_EQ(vlog_open(LZ_DB_DIR, &vc, &db->vlog), VLOG_OK);
+    db->cache = cache_create(NULL);
+    ASSERT_EQ(fd_manager_init(&db->fdm, 0), 0);
+    snprintf(db->manifest_path, sizeof(db->manifest_path), "%s%sMANIFEST", LZ_DB_DIR,
+             PATH_SEPARATOR);
+    db->manifest = tidesdb_manifest_open(db->manifest_path);
+    ASSERT_TRUE(db->manifest != NULL);
+
+    tidesdb_column_family_config_t cfg;
+    memset(&cfg, 0, sizeof(cfg));
+    snprintf(cfg.name, sizeof(cfg.name), "%s", "cf0");
+    cfg.level_size_ratio = 10;
+    cfg.min_levels = 3;
+    cfg.btree_klog_block_size = 4096;
+    if (lz4)
+    {
+        cfg.encoding_pipeline[0] = TDB_COMPRESS_LZ4;
+        cfg.encoding_count = 1;
+    }
+    ASSERT_EQ(
+        cf_create(LZ_DB_DIR, 0, &cfg, &db->reg, db->vlog, db->cache, &db->fdm, NULL, NULL, &db->cf),
+        0);
+    ASSERT_EQ(tidesdb_manifest_add_cf(db->manifest, 0, "cf0", NULL, 0), 0);
+
+    db->l0 = tidesdb_l0_create(64 * 1024, 8, LZ_MAX_LEVEL, LZ_PROB, NULL, NULL);
+    tidesdb_l0_set_active(db->l0,
+                          tidesdb_memtable_create(NULL, 0, 0, LZ_MAX_LEVEL, LZ_PROB, NULL, NULL));
+    atomic_init(&db->next_id, 100);
+    db->generation = 1;
+}
+
+static void lz_db_close(lz_db_t *db)
+{
+    tidesdb_l0_destroy(db->l0);
+    cf_free(db->cf);
+    tidesdb_manifest_close(db->manifest);
+    fd_manager_destroy(&db->fdm);
+    cache_destroy(db->cache);
+    vlog_close(db->vlog);
+    (void)remove_directory(LZ_DB_DIR);
+}
+
+static void lz_key(char *buf, size_t cap, int key)
+{
+    snprintf(buf, cap, "k%05d", key);
+}
+
+static void lz_value(char *buf, size_t cap, uint64_t seq)
+{
+    snprintf(buf, cap, "v%llu", (unsigned long long)seq);
+}
+
+/* write one version of key into the active memtable, a tombstone when deleted */
+static void lz_put(lz_db_t *db, lz_model_t *m, int key, uint64_t seq, int deleted)
+{
+    char k[16], v[32];
+    lz_key(k, sizeof(k), key);
+    lz_value(v, sizeof(v), seq);
+    ASSERT_EQ(tidesdb_l0_apply(db->l0, 0, (const uint8_t *)k, strlen(k),
+                               deleted ? NULL : (const uint8_t *)v, deleted ? 0 : strlen(v), -1,
+                               seq, deleted ? SKIP_LIST_FLAG_DELETED : 0),
+              TDB_SUCCESS);
+    if (m && key < LZ_MODEL_KEYS && seq > m->seq[key])
+    {
+        m->seq[key] = seq;
+        m->deleted[key] = deleted;
+    }
+}
+
+/* lay [lo, hi) at seq into the active memtable, hi -1 for unbounded above */
+static void lz_range(lz_db_t *db, lz_model_t *m, int lo, int hi, uint64_t seq)
+{
+    char l[16], h[16];
+    lz_key(l, sizeof(l), lo);
+    lz_key(h, sizeof(h), hi);
+    ASSERT_EQ(tidesdb_l0_apply_range_tombstone(db->l0, 0, (const uint8_t *)l, strlen(l),
+                                               hi < 0 ? NULL : (const uint8_t *)h,
+                                               hi < 0 ? 0 : strlen(h), seq),
+              TDB_SUCCESS);
+    if (m)
+    {
+        ASSERT_TRUE(m->n_ranges < LZ_MODEL_RANGES);
+        m->range_lo[m->n_ranges] = lo;
+        m->range_hi[m->n_ranges] = hi;
+        m->range_seq[m->n_ranges] = seq;
+        m->n_ranges++;
+    }
+}
+
+/* rotate the active memtable and flush it into one L1 table, returning its id */
+static uint64_t lz_flush(lz_db_t *db)
+{
+    db->generation++;
+    ASSERT_EQ(
+        tidesdb_l0_rotate(db->l0, tidesdb_memtable_create(NULL, db->generation, db->generation,
+                                                          LZ_MAX_LEVEL, LZ_PROB, NULL, NULL)),
+        TDB_SUCCESS);
+    tidesdb_memtable_t *immutable = tidesdb_l0_dequeue_immutable(db->l0);
+    const uint64_t id = atomic_load(&db->next_id);
+    cf_t *cfs[1] = {db->cf};
+    flush_ctx_t fx = {.l0 = db->l0,
+                      .cfs = cfs,
+                      .n_cfs = 1,
+                      .manifest = db->manifest,
+                      .manifest_path = db->manifest_path,
+                      .next_sstable_id = &db->next_id,
+                      .fdm = &db->fdm,
+                      .sync_mode = BLOCK_MANAGER_SYNC_NONE,
+                      .value_threshold = 1u << 20};
+    ASSERT_EQ(flush_immutable(&fx, immutable), TDB_SUCCESS);
+    return id;
+}
+
+/* move the given L1 tables down to level as they are, the way the planner deepens a family, so
+ * they form one run there */
+static void lz_move(lz_db_t *db, const uint64_t *ids, int n, int level)
+{
+    const compaction_job_t move = {.input_ids = ids,
+                                   .n_inputs = n,
+                                   .target_level = level,
+                                   .is_largest_level = 1,
+                                   .split = COMPACTION_SPLIT_NONE,
+                                   .is_move = 1};
+    const compaction_ctx_t cx = {.cf = db->cf,
+                                 .manifest = db->manifest,
+                                 .manifest_path = db->manifest_path,
+                                 .next_sstable_id = &db->next_id,
+                                 .gc_floor = UINT64_MAX,
+                                 .sync_mode = BLOCK_MANAGER_SYNC_NONE,
+                                 .value_threshold = 1u << 20};
+    ASSERT_EQ(compaction_exec(&cx, &move), TDB_SUCCESS);
+    ASSERT_EQ(level_set_count(db->cf->levels, level), n);
+}
+
+/* the run's tables at level, referenced in key order; the caller drops them with lz_unref_all */
+static int lz_level_tables(lz_db_t *db, int level, sstable_t **out, int cap)
+{
+    const int total = level_set_snapshot(db->cf->levels, NULL, 0);
+    level_set_snapshot_entry_t *all = calloc((size_t)total + 1, sizeof(*all));
+    ASSERT_TRUE(all != NULL);
+    ASSERT_EQ(level_set_snapshot(db->cf->levels, all, total), total);
+    int n = 0;
+    for (int i = 0; i < total; i++)
+    {
+        if (all[i].level == level && n < cap)
+            out[n++] = all[i].sst;
+        else if (sstable_unref(all[i].sst))
+            sstable_close(all[i].sst);
+    }
+    free(all);
+    return n;
+}
+
+static void lz_unref_all(sstable_t **t, int n)
+{
+    for (int i = 0; i < n; i++)
+        if (sstable_unref(t[i])) sstable_close(t[i]);
+}
+
+/* every table the run holds was written with the family's codec, so the lz4 case reads lz4 */
+static void lz_assert_codec(lz_db_t *db, int level)
+{
+    sstable_t *t[64];
+    const int n = lz_level_tables(db, level, t, 64);
+    ASSERT_TRUE(n > 0);
+    for (int i = 0; i < n; i++) ASSERT_EQ(t[i]->codec_count > 0, db->lz4 != 0);
+    lz_unref_all(t, n);
+}
+
+/* a run of n tables at the run level, table f holding keys [f * per, f * per + per) stepped by
+ * stride, every version at seq base + key, none deleted. returns nothing; the model learns each */
+static void lz_build_run(lz_db_t *db, lz_model_t *m, int n, int per, int stride, uint64_t base)
+{
+    uint64_t ids[64];
+    ASSERT_TRUE(n <= 64);
+    for (int f = 0; f < n; f++)
+    {
+        for (int i = 0; i < per; i++)
+        {
+            const int key = (f * per + i) * stride;
+            lz_put(db, m, key, base + (uint64_t)key, 0);
+        }
+        ids[f] = lz_flush(db);
+    }
+    lz_move(db, ids, n, LZ_RUN_LEVEL);
+}
+
+/* the key the iterator sits on, as the integer it names */
+static int lz_current(cf_iter_t *it)
+{
+    const uint8_t *key = NULL, *value = NULL;
+    size_t key_size = 0, value_size = 0;
+    uint64_t seq = 0, vlog = 0;
+    int64_t ttl = 0;
+    uint8_t deleted = 0;
+    ASSERT_EQ(cf_iter_get(it, &key, &key_size, &seq, &value, &value_size, &vlog, &ttl, &deleted),
+              TDB_SUCCESS);
+    ASSERT_EQ(deleted, 0);
+    ASSERT_TRUE(key_size == 6 && key[0] == 'k');
+    char buf[8];
+    memcpy(buf, key + 1, 5);
+    buf[5] = '\0';
+    const int k = atoi(buf);
+    /* the value names the version that won, which is the newest the model holds for the key */
+    char want[32];
+    lz_value(want, sizeof(want), seq);
+    ASSERT_EQ(value_size, strlen(want));
+    ASSERT_EQ(memcmp(value, want, value_size), 0);
+    return k;
+}
+
+static int lz_seek(cf_iter_t *it, int key)
+{
+    char k[16];
+    lz_key(k, sizeof(k), key);
+    return cf_iter_seek(it, (const uint8_t *)k, strlen(k));
+}
+
+static int lz_seek_for_prev(cf_iter_t *it, int key)
+{
+    char k[16];
+    lz_key(k, sizeof(k), key);
+    return cf_iter_seek_for_prev(it, (const uint8_t *)k, strlen(k));
+}
+
+/* list the visible keys in order: the newest version is live and no newer interval covers it */
+static void lz_model_settle(lz_model_t *m)
+{
+    m->n_visible = 0;
+    for (int k = 0; k < LZ_MODEL_KEYS; k++)
+    {
+        if (m->seq[k] == 0 || m->deleted[k]) continue;
+        int covered = 0;
+        for (int r = 0; r < m->n_ranges && !covered; r++)
+            covered = k >= m->range_lo[r] && (m->range_hi[r] < 0 || k < m->range_hi[r]) &&
+                      m->range_seq[r] > m->seq[k];
+        if (!covered) m->visible[m->n_visible++] = k;
+    }
+}
+
+/* the model's position after a seek to key: the first visible key at or after it */
+static int lz_model_seek(const lz_model_t *m, int key)
+{
+    int lo = 0, hi = m->n_visible;
+    while (lo < hi)
+    {
+        const int mid = lo + (hi - lo) / 2;
+        if (m->visible[mid] < key)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    return lo;
+}
+
+/* the iterator is where the model says, n_visible or -1 meaning off either end */
+static void lz_assert_at(cf_iter_t *it, int rc, const lz_model_t *m, int pos)
+{
+    if (pos < 0 || pos >= m->n_visible)
+    {
+        ASSERT_EQ(rc, TDB_ERR_NOT_FOUND);
+        ASSERT_FALSE(cf_iter_valid(it));
+        return;
+    }
+    ASSERT_EQ(rc, TDB_SUCCESS);
+    ASSERT_TRUE(cf_iter_valid(it));
+    ASSERT_EQ(lz_current(it), m->visible[pos]);
+}
+
+/* ---- LazyCursorsOpenOnlyTouchedTables ---- */
+
+#define LZ_TOUCH_TABLES 40
+#define LZ_TOUCH_PER    20
+#define LZ_TOUCH_TABLE  17
+#define LZ_TOUCH_STEPS  5
+
+/* a seek into one table of a 40-table run and a few steps along it open that table's cursor and at
+ * most its neighbour's, never the other 38 */
+static void lz_open_only_touched(int lz4)
+{
+    lz_db_t db;
+    lz_db_open(&db, lz4);
+    lz_build_run(&db, NULL, LZ_TOUCH_TABLES, LZ_TOUCH_PER, 1, 1000);
+    lz_assert_codec(&db, LZ_RUN_LEVEL);
+
+    const int64_t before = sstable_iters_opened();
+    cf_iter_t *it = NULL;
+    ASSERT_EQ(cf_iter_new(db.cf, db.l0, UINT64_MAX, NULL, &it), TDB_SUCCESS);
+    const int target = LZ_TOUCH_TABLE * LZ_TOUCH_PER + 5;
+    ASSERT_EQ(lz_seek(it, target), TDB_SUCCESS);
+    ASSERT_EQ(lz_current(it), target);
+    for (int s = 1; s <= LZ_TOUCH_STEPS; s++)
+    {
+        ASSERT_EQ(cf_iter_next(it), TDB_SUCCESS);
+        ASSERT_EQ(lz_current(it), target + s);
+    }
+    const int64_t opened = sstable_iters_opened() - before;
+    printf("(opened %lld of %d) ", (long long)opened, LZ_TOUCH_TABLES);
+    ASSERT_TRUE(opened >= 1 && opened <= 2);
+    cf_iter_free(it);
+    lz_db_close(&db);
+}
+
+static void test_lazy_cursors_open_only_touched_tables(void)
+{
+    lz_open_only_touched(0);
+}
+
+static void test_lazy_cursors_open_only_touched_tables_lz4(void)
+{
+    if (!lz4_available()) return;
+    lz_open_only_touched(1);
+}
+
+/* ---- LazyMatchesModel ---- */
+
+#define LZ_MODEL_TABLES 30
+#define LZ_MODEL_PER    20
+#define LZ_MODEL_STRIDE 2 /* the run holds even keys, so a seek to an odd one falls between */
+#define LZ_MODEL_OPS    5000
+#define LZ_MODEL_SEED   0x9e3779b9u
+
+static uint32_t lz_rand(uint32_t *state)
+{
+    *state = *state * 1664525u + 1013904223u;
+    return *state >> 8;
+}
+
+/* a run of 30 tables, some of which carry intervals reaching across several of their neighbours,
+ * beneath two overlapping L1 tables with versions, tombstones and intervals of their own */
+static void lz_model_build(lz_db_t *db, lz_model_t *m)
+{
+    uint64_t ids[LZ_MODEL_TABLES];
+    for (int f = 0; f < LZ_MODEL_TABLES; f++)
+    {
+        for (int i = 0; i < LZ_MODEL_PER; i++)
+        {
+            const int key = (f * LZ_MODEL_PER + i) * LZ_MODEL_STRIDE;
+            lz_put(db, m, key, 1000 + (uint64_t)key, key % 14 == 6);
+        }
+        /* intervals newer than every run version, each spanning tables other than its carrier */
+        if (f == 5) lz_range(db, m, 170, 290, 5000);   /* tables 4 to 7 */
+        if (f == 20) lz_range(db, m, 720, 1006, 5001); /* tables 18 to 25 */
+        if (f == 2) lz_range(db, m, 1101, 1113, 5002); /* inside table 27, carried by table 2 */
+        if (f == 29) lz_range(db, m, 1180, -1, 5003);  /* the tail, unbounded */
+        ids[f] = lz_flush(db);
+    }
+    lz_move(db, ids, LZ_MODEL_TABLES, LZ_RUN_LEVEL);
+
+    /* the first L1 table: odd keys of its own, newer versions of some deleted run keys, and
+     * tombstones over some live ones */
+    for (int k = 1; k < LZ_MODEL_KEYS - 100; k += 18) lz_put(db, m, k, 9000 + (uint64_t)k, 0);
+    for (int k = 180; k < 280; k += 10) lz_put(db, m, k, 9000 + (uint64_t)k, 0);
+    for (int k = 400; k < 460; k += 6) lz_put(db, m, k, 9000 + (uint64_t)k, 1);
+    lz_put(db, m, 1190, 9500, 0); /* past the unbounded interval, newer than it */
+    lz_flush(db);
+
+    /* the second, newest: an interval hiding part of the first's keys and the run's, then versions
+     * newer than it inside it */
+    lz_range(db, m, 500, 560, 11000);
+    for (int k = 510; k < 540; k += 8) lz_put(db, m, k, 11100 + (uint64_t)k, 0);
+    for (int k = 600; k < 700; k += 4) lz_put(db, m, k, 11100 + (uint64_t)k, 0);
+    lz_flush(db);
+    ASSERT_EQ(level_set_count(db->cf->levels, LEVEL_SET_L1), 2);
+    lz_model_settle(m);
+    ASSERT_TRUE(m->n_visible > 100);
+}
+
+static void lz_matches_model(int lz4)
+{
+    lz_db_t db;
+    lz_db_open(&db, lz4);
+    lz_model_t *m = calloc(1, sizeof(*m));
+    ASSERT_TRUE(m != NULL);
+    lz_model_build(&db, m);
+    lz_assert_codec(&db, LZ_RUN_LEVEL);
+
+    cf_iter_t *it = NULL;
+    ASSERT_EQ(cf_iter_new(db.cf, db.l0, UINT64_MAX, NULL, &it), TDB_SUCCESS);
+    uint32_t state = LZ_MODEL_SEED;
+    int pos = -1; /* the model's position, -1 or n_visible off an end */
+    int valid = 0;
+    for (int op = 0; op < LZ_MODEL_OPS; op++)
+    {
+        /* steps when positioned, else the seek of the same direction in their place */
+        const uint32_t pick = lz_rand(&state) % 10;
+        const int key = (int)(lz_rand(&state) % (LZ_MODEL_KEYS + 20));
+        int rc;
+        if (pick < 4 && valid)
+        {
+            rc = cf_iter_next(it);
+            pos++;
+        }
+        else if (pick >= 4 && pick < 7 && valid)
+        {
+            rc = cf_iter_prev(it);
+            pos--;
+        }
+        else if (pick < 4 || pick == 7)
+        {
+            rc = lz_seek(it, key);
+            pos = lz_model_seek(m, key);
+        }
+        else if (pick < 9)
+        {
+            rc = lz_seek_for_prev(it, key);
+            pos = lz_model_seek(m, key + 1) - 1;
+        }
+        else if (lz_rand(&state) & 1)
+        {
+            rc = cf_iter_seek_first(it);
+            pos = 0;
+        }
+        else
+        {
+            rc = cf_iter_seek_last(it);
+            pos = m->n_visible - 1;
+        }
+        lz_assert_at(it, rc, m, pos);
+        valid = pos >= 0 && pos < m->n_visible;
+    }
+
+    /* and a whole walk each way */
+    int n = 0;
+    for (int rc = cf_iter_seek_first(it); rc == TDB_SUCCESS; rc = cf_iter_next(it))
+        ASSERT_EQ(lz_current(it), m->visible[n++]);
+    ASSERT_EQ(n, m->n_visible);
+    for (int rc = cf_iter_seek_last(it); rc == TDB_SUCCESS; rc = cf_iter_prev(it))
+        ASSERT_EQ(lz_current(it), m->visible[--n]);
+    ASSERT_EQ(n, 0);
+
+    cf_iter_free(it);
+    free(m);
+    lz_db_close(&db);
+}
+
+static void test_lazy_matches_model(void)
+{
+    lz_matches_model(0);
+}
+
+static void test_lazy_matches_model_lz4(void)
+{
+    if (!lz4_available()) return;
+    lz_matches_model(1);
+}
+
+/* ---- CoversWithoutCursor ---- */
+
+#define LZ_COVER_TABLES  32
+#define LZ_COVER_PER     20
+#define LZ_COVER_CARRIER 3
+#define LZ_COVER_HELD    30
+
+/* an interval table 3 carries deletes keys table 30 holds. a seek onto one of them lands on the
+ * first key past the interval, and only table 30's cursor is opened to get there -- the carrier is
+ * asked through the intervals it holds in memory, not through a cursor */
+static void lz_covers_without_cursor(int lz4)
+{
+    lz_db_t db;
+    lz_db_open(&db, lz4);
+    uint64_t ids[LZ_COVER_TABLES];
+    const int held = LZ_COVER_HELD * LZ_COVER_PER;
+    for (int f = 0; f < LZ_COVER_TABLES; f++)
+    {
+        for (int i = 0; i < LZ_COVER_PER; i++)
+        {
+            const int key = f * LZ_COVER_PER + i;
+            lz_put(&db, NULL, key, 1000 + (uint64_t)key, 0);
+        }
+        if (f == LZ_COVER_CARRIER) lz_range(&db, NULL, held + 4, held + 9, 5000);
+        ids[f] = lz_flush(&db);
+    }
+    lz_move(&db, ids, LZ_COVER_TABLES, LZ_RUN_LEVEL);
+    lz_assert_codec(&db, LZ_RUN_LEVEL);
+
+    const int64_t before = sstable_iters_opened();
+    cf_iter_t *it = NULL;
+    ASSERT_EQ(cf_iter_new(db.cf, db.l0, UINT64_MAX, NULL, &it), TDB_SUCCESS);
+    ASSERT_EQ(lz_seek(it, held + 5), TDB_SUCCESS);
+    ASSERT_EQ(lz_current(it), held + 9);
+    ASSERT_EQ(lz_seek_for_prev(it, held + 8), TDB_SUCCESS);
+    ASSERT_EQ(lz_current(it), held + 3);
+    ASSERT_EQ(cf_iter_next(it), TDB_SUCCESS);
+    ASSERT_EQ(lz_current(it), held + 9);
+    const int64_t opened = sstable_iters_opened() - before;
+    printf("(opened %lld of %d) ", (long long)opened, LZ_COVER_TABLES);
+    ASSERT_EQ(opened, 1);
+    cf_iter_free(it);
+    lz_db_close(&db);
+}
+
+static void test_covers_without_cursor(void)
+{
+    lz_covers_without_cursor(0);
+}
+
+static void test_covers_without_cursor_lz4(void)
+{
+    if (!lz4_available()) return;
+    lz_covers_without_cursor(1);
+}
+
+/* ---- TombstoneOnlyTableInRun ---- */
+
+#define LZ_TOMB_PER 20
+
+/* a run holding a table with an interval and no keys: walks either way skip what it covers, and
+ * the keyless table is stepped over like any other */
+static void lz_tombstone_only_table(int lz4)
+{
+    lz_db_t db;
+    lz_db_open(&db, lz4);
+    lz_model_t *m = calloc(1, sizeof(*m));
+    ASSERT_TRUE(m != NULL);
+    uint64_t ids[5];
+    int n = 0;
+    for (int f = 0; f < 2; f++)
+    {
+        for (int i = 0; i < LZ_TOMB_PER; i++) lz_put(&db, m, f * LZ_TOMB_PER + i, 1000, 0);
+        ids[n++] = lz_flush(&db);
+    }
+    lz_range(&db, m, 25, 55, 5000); /* across the second table and the third */
+    ids[n++] = lz_flush(&db);
+    for (int f = 2; f < 4; f++)
+    {
+        for (int i = 0; i < LZ_TOMB_PER; i++) lz_put(&db, m, f * LZ_TOMB_PER + i, 1000, 0);
+        ids[n++] = lz_flush(&db);
+    }
+    lz_move(&db, ids, n, LZ_RUN_LEVEL);
+    lz_model_settle(m);
+    ASSERT_EQ(m->n_visible, 4 * LZ_TOMB_PER - 30);
+
+    cf_iter_t *it = NULL;
+    ASSERT_EQ(cf_iter_new(db.cf, db.l0, UINT64_MAX, NULL, &it), TDB_SUCCESS);
+    int seen = 0;
+    for (int rc = cf_iter_seek_first(it); rc == TDB_SUCCESS; rc = cf_iter_next(it))
+        ASSERT_EQ(lz_current(it), m->visible[seen++]);
+    ASSERT_EQ(seen, m->n_visible);
+    for (int rc = cf_iter_seek_last(it); rc == TDB_SUCCESS; rc = cf_iter_prev(it))
+        ASSERT_EQ(lz_current(it), m->visible[--seen]);
+    ASSERT_EQ(seen, 0);
+    ASSERT_EQ(lz_seek(it, 30), TDB_SUCCESS);
+    ASSERT_EQ(lz_current(it), 55);
+    ASSERT_EQ(cf_iter_prev(it), TDB_SUCCESS);
+    ASSERT_EQ(lz_current(it), 24);
+    ASSERT_EQ(lz_seek_for_prev(it, 50), TDB_SUCCESS);
+    ASSERT_EQ(lz_current(it), 24);
+    ASSERT_EQ(cf_iter_next(it), TDB_SUCCESS);
+    ASSERT_EQ(lz_current(it), 55);
+    cf_iter_free(it);
+    free(m);
+    lz_db_close(&db);
+}
+
+static void test_tombstone_only_table_in_run(void)
+{
+    lz_tombstone_only_table(0);
+}
