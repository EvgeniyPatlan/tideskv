+static void test_tombstone_only_table_in_run_lz4(void)
+{
+    if (!lz4_available()) return;
+    lz_tombstone_only_table(1);
+}
+
+/* ---- LazyOpenFailureIsIo ---- */
+
+#define LZ_FAIL_TABLES 10
+#define LZ_FAIL_PER    20
+#define LZ_FAIL_TABLE  6
+
+/* a table whose klog cannot be reopened when a walk first reaches it. the iterator reports io --
+ * at the seek or step that reached it, or, opening every cursor up front, when it is built -- and
+ * frees cleanly either way; a seek elsewhere after the failure still reads */
+static void lz_open_failure_is_io(int lz4)
+{
+    lz_db_t db;
+    lz_db_open(&db, lz4);
+    lz_build_run(&db, NULL, LZ_FAIL_TABLES, LZ_FAIL_PER, 1, 1000);
+
+    sstable_t *t[LZ_FAIL_TABLES];
+    ASSERT_EQ(lz_level_tables(&db, LZ_RUN_LEVEL, t, LZ_FAIL_TABLES), LZ_FAIL_TABLES);
+    sstable_t *victim = t[LZ_FAIL_TABLE];
+    /* the level set's reference and the one taken here are the only ones held */
+    if (sstable_klog_resident(victim))
+        ASSERT_EQ(sstable_evict_klog(victim, SSTABLE_IDLE_BASELINE + 1), 1);
+    ASSERT_FALSE(sstable_klog_resident(victim));
+    char moved[1024];
+    snprintf(moved, sizeof(moved), "%s.moved", victim->klog_path);
+    ASSERT_EQ(rename(victim->klog_path, moved), 0);
+    /* a directory in its place, so the reopen fails rather than creating an empty klog */
+    ASSERT_EQ(mkdir(victim->klog_path, 0755), 0);
+
+    cf_iter_t *it = NULL;
+    const int built = cf_iter_new(db.cf, db.l0, UINT64_MAX, NULL, &it);
+    printf("(io %s) ", built == TDB_SUCCESS ? "where reached" : "when built");
+    if (built == TDB_SUCCESS)
+    {
+        /* a table before the broken one reads */
+        ASSERT_EQ(lz_seek(it, 2 * LZ_FAIL_PER + 3), TDB_SUCCESS);
+        ASSERT_EQ(lz_current(it), 2 * LZ_FAIL_PER + 3);
+        /* a seek onto the broken one fails as io, and leaves the iterator invalid */
+        ASSERT_EQ(lz_seek(it, LZ_FAIL_TABLE * LZ_FAIL_PER + 3), TDB_ERR_IO);
+        ASSERT_FALSE(cf_iter_valid(it));
+        /* so does a backward seek and a walk that steps onto it */
+        ASSERT_EQ(lz_seek_for_prev(it, LZ_FAIL_TABLE * LZ_FAIL_PER + 3), TDB_ERR_IO);
+        /* the merge reads one entry ahead of where it stands, so the step onto a table's last key
+         * is the one that reaches into the next table */
+        ASSERT_EQ(lz_seek(it, LZ_FAIL_TABLE * LZ_FAIL_PER - 3), TDB_SUCCESS);
+        ASSERT_EQ(cf_iter_next(it), TDB_SUCCESS);
+        ASSERT_EQ(lz_current(it), LZ_FAIL_TABLE * LZ_FAIL_PER - 2);
+        ASSERT_EQ(cf_iter_next(it), TDB_ERR_IO);
+        ASSERT_FALSE(cf_iter_valid(it));
+        ASSERT_EQ(lz_seek_for_prev(it, (LZ_FAIL_TABLE + 1) * LZ_FAIL_PER + 2), TDB_SUCCESS);
+        ASSERT_EQ(cf_iter_prev(it), TDB_SUCCESS);
+        ASSERT_EQ(lz_current(it), (LZ_FAIL_TABLE + 1) * LZ_FAIL_PER + 1);
+        ASSERT_EQ(cf_iter_prev(it), TDB_ERR_IO);
+        ASSERT_FALSE(cf_iter_valid(it));
+        /* a whole walk cannot pass it either way */
+        int rc = cf_iter_seek_first(it);
+        while (rc == TDB_SUCCESS) rc = cf_iter_next(it);
+        ASSERT_EQ(rc, TDB_ERR_IO);
+        rc = cf_iter_seek_last(it);
+        while (rc == TDB_SUCCESS) rc = cf_iter_prev(it);
+        ASSERT_EQ(rc, TDB_ERR_IO);
+        /* and a seek elsewhere afterwards reads again */
+        ASSERT_EQ(lz_seek(it, 9 * LZ_FAIL_PER), TDB_SUCCESS);
+        ASSERT_EQ(lz_current(it), 9 * LZ_FAIL_PER);
+        cf_iter_free(it);
+    }
+    else
+    {
+        ASSERT_EQ(built, TDB_ERR_IO);
+        ASSERT_TRUE(it == NULL);
+    }
+
+    ASSERT_EQ(rmdir(victim->klog_path), 0);
+    ASSERT_EQ(rename(moved, victim->klog_path), 0);
+    lz_unref_all(t, LZ_FAIL_TABLES);
+    lz_db_close(&db);
+}
+
+static void test_lazy_open_failure_is_io(void)
+{
+    lz_open_failure_is_io(0);
+}
+
+static void test_lazy_open_failure_is_io_lz4(void)
+{
+    if (!lz4_available()) return;
+    lz_open_failure_is_io(1);
+}
+
+int main(int argc, char **argv)
+{
+    INIT_TEST_FILTER(argc, argv);
+    RUN_TEST_HANDLE_BALANCED(test_lazy_cursors_open_only_touched_tables, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_lazy_cursors_open_only_touched_tables_lz4, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_lazy_matches_model, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_lazy_matches_model_lz4, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_covers_without_cursor, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_covers_without_cursor_lz4, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_tombstone_only_table_in_run, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_tombstone_only_table_in_run_lz4, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_lazy_open_failure_is_io, tests_passed);
+    RUN_TEST_HANDLE_BALANCED(test_lazy_open_failure_is_io_lz4, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
