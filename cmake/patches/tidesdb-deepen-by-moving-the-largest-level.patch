+/* put moved inputs back at the levels they came from and commit that, after a failed move */
+static void ce_rollback_move(const compaction_ctx_t *cx, sstable_t *const *inputs, const int *from,
+                             int n_moved)
+{
+    int restored = 1;
+    for (int i = 0; i < n_moved; i++)
+        if (tidesdb_manifest_move_sstable(cx->manifest, cx->cf->cf_id, inputs[i]->id, from[i]) != 0)
+            restored = 0;
+    const int durable = cx->sync_mode != BLOCK_MANAGER_SYNC_NONE;
+    if (!restored || tidesdb_manifest_commit(cx->manifest, cx->manifest_path, durable) != 0)
+        TDB_DEBUG_LOG(TDB_LOG_WARN,
+                      "could not roll a failed level move back on cf %s; the next open reads the "
+                      "files at the moved level, where they are equally valid",
+                      cx->cf->name);
+}
+
+int ce_commit_move(const compaction_ctx_t *cx, const compaction_job_t *job, sstable_t *const *inputs,
+                   const uint64_t *in_sizes, int n_inputs)
+{
+    if (level_set_count(cx->cf->levels, job->target_level) != 0) return TDB_SUCCESS;
+
+    int *from = calloc((size_t)n_inputs, sizeof(int));
+    int *to = malloc((size_t)n_inputs * sizeof(int));
+    if (!from || !to)
+    {
+        free(from);
+        free(to);
+        return TDB_ERR_MEMORY;
+    }
+    int rc = TDB_SUCCESS;
+    int moved = 0;
+    for (; moved < n_inputs; moved++)
+    {
+        from[moved] = tidesdb_manifest_find_level_by_id(cx->manifest, cx->cf->cf_id,
+                                                        inputs[moved]->id);
+        to[moved] = job->target_level;
+        if (from[moved] <= 0 || tidesdb_manifest_move_sstable(cx->manifest, cx->cf->cf_id,
+                                                              inputs[moved]->id,
+                                                              job->target_level) != 0)
+        {
+            rc = TDB_ERR_IO;
+            break;
+        }
+    }
+    const int durable = cx->sync_mode != BLOCK_MANAGER_SYNC_NONE;
+    if (rc == TDB_SUCCESS && tidesdb_manifest_commit(cx->manifest, cx->manifest_path, durable) != 0)
+        rc = TDB_ERR_IO;
+    if (rc == TDB_SUCCESS &&
+        level_set_swap(cx->cf->levels, inputs, n_inputs, inputs, to, in_sizes, n_inputs) != 0)
+        rc = TDB_ERR_MEMORY;
+    if (rc != TDB_SUCCESS) ce_rollback_move(cx, inputs, from, moved);
+    free(from);
+    free(to);
+    return rc;
+}
