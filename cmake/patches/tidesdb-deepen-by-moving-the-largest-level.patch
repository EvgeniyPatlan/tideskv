+/* emit a move of the largest level's files one level down, which adds a level without rewriting
+ * anything: the files are one non-overlapping run already, and every level above stays as it is */
+static int ce_emit_move(compaction_plan_t *p, const compaction_snapshot_t *snap, int target)
+{
+    if (snap->n_sstables == 0) return TDB_SUCCESS;
+    uint64_t *ids = malloc((size_t)snap->n_sstables * sizeof(*ids));
+    if (!ids) return TDB_ERR_MEMORY;
+    const int cnt = ce_ids_in_range(snap, snap->num_levels, snap->num_levels, ids);
+    if (cnt == 0)
+    {
+        free(ids);
+        return TDB_SUCCESS;
+    }
+    uint64_t *kept = ce_plan_keep_ids(p, ids, cnt);
+    free(ids);
+    if (!kept) return TDB_ERR_MEMORY;
+    compaction_job_t job = {0};
+    job.input_ids = kept;
+    job.n_inputs = cnt;
+    job.target_level = target;
+    job.is_largest_level = 1;
+    job.split = COMPACTION_SPLIT_NONE;
+    job.is_move = 1;
+    return ce_plan_add(p, &job);
+}
