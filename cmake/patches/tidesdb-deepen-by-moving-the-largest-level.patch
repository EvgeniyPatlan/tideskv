+/* a move job re-points its inputs at the target level: no file is written, the ids stay, reads find
+ * the keys at the new level, and the manifest on disk names the new level */
+void test_compaction_move_relevels_without_rewriting(void)
+{
+    ce_db_t db;
+    ce_db_open(&db);
+    const ce_entry_t a[] = {{"a", "v-a", 1, 0}, {"c", "v-c", 2, 0}};
+    const uint64_t id0 = ce_flush(&db, a, 2, 1);
+    const compaction_ctx_t cx = {.cf = db.cf,
+                                 .manifest = db.manifest,
+                                 .manifest_path = db.manifest_path,
+                                 .next_sstable_id = &db.next_id,
+                                 .gc_floor = UINT64_MAX,
+                                 .sync_mode = BLOCK_MANAGER_SYNC_NONE,
+                                 .value_threshold = db.value_threshold};
+    const uint64_t inputs[1] = {id0};
+    const compaction_job_t move = {.input_ids = inputs,
+                                   .n_inputs = 1,
+                                   .target_level = 3,
+                                   .is_largest_level = 1,
+                                   .split = COMPACTION_SPLIT_NONE,
+                                   .is_move = 1};
+    const uint64_t next_before = atomic_load(&db.next_id);
+    ASSERT_EQ(compaction_exec(&cx, &move), TDB_SUCCESS);
+
+    ASSERT_EQ(level_set_count(db.cf->levels, 1), 0);
+    ASSERT_EQ(level_set_count(db.cf->levels, 3), 1);
+    ASSERT_EQ(atomic_load(&db.next_id), next_before); /* no output was created */
+    ASSERT_EQ(atomic_load(&db.cf->compaction_bytes_written), 0);
+    ASSERT_EQ(tidesdb_manifest_find_level_by_id(db.manifest, 0, id0), 3);
+    ce_assert_read(db.cf, 3, "a", "v-a");
+    ce_assert_read(db.cf, 3, "c", "v-c");
+
+    /* the move is durable: a manifest reopened from disk names the new level */
+    tidesdb_manifest_t *again = tidesdb_manifest_open(db.manifest_path);
+    ASSERT_TRUE(again != NULL);
+    ASSERT_EQ(tidesdb_manifest_find_level_by_id(again, 0, id0), 3);
+    tidesdb_manifest_close(again);
+
+    ce_db_close(&db);
+}
+
+/* a move whose target level already holds files is stale and changes nothing */
+void test_compaction_move_into_occupied_level_is_skipped(void)
+{
+    ce_db_t db;
+    ce_db_open(&db);
+    const ce_entry_t a[] = {{"a", "v-a", 1, 0}};
+    const ce_entry_t b[] = {{"b", "v-b", 2, 0}};
+    const uint64_t id0 = ce_flush(&db, a, 1, 1);
+    const uint64_t id1 = ce_flush(&db, b, 1, 2);
+    const compaction_ctx_t cx = {.cf = db.cf,
+                                 .manifest = db.manifest,
+                                 .manifest_path = db.manifest_path,
+                                 .next_sstable_id = &db.next_id,
+                                 .gc_floor = UINT64_MAX,
+                                 .sync_mode = BLOCK_MANAGER_SYNC_NONE,
+                                 .value_threshold = db.value_threshold};
+    const uint64_t first[1] = {id0};
+    const compaction_job_t to_l2 = {.input_ids = first,
+                                    .n_inputs = 1,
+                                    .target_level = 2,
+                                    .split = COMPACTION_SPLIT_NONE,
+                                    .is_move = 1};
+    ASSERT_EQ(compaction_exec(&cx, &to_l2), TDB_SUCCESS);
+    const uint64_t second[1] = {id1};
+    const compaction_job_t again = {.input_ids = second,
+                                    .n_inputs = 1,
+                                    .target_level = 2,
+                                    .split = COMPACTION_SPLIT_NONE,
+                                    .is_move = 1};
+    ASSERT_EQ(compaction_exec(&cx, &again), TDB_SUCCESS);
+    ASSERT_EQ(level_set_count(db.cf->levels, 1), 1); /* id1 stayed */
+    ASSERT_EQ(level_set_count(db.cf->levels, 2), 1);
+    ASSERT_EQ(tidesdb_manifest_find_level_by_id(db.manifest, 0, id1), 1);
+
+    ce_db_close(&db);
+}
