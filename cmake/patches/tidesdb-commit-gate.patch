     pthread_mutex_destroy(&l0->aborted_lock);
     pthread_mutex_destroy(&l0->admit_mtx);
     pthread_cond_destroy(&l0->admit_cv);
@@ -299,6 +317,47 @@ static int l0_wal_append_kv(block_manager_t *wal, const uint8_t *pkey, size_t pk
 
 static void l0_hold_vlog_floor(tidesdb_l0_t *l0, tidesdb_memtable_t *mt);
 
+/* one more than the generation of the memtable whose log this thread last appended a commit record
+ * to, or 0 when unknown (no record yet, or the commit has left the gate). generations start at 0,
+ * hence the offset. the apply that follows on the same thread checks its memtable against it */
+static _Thread_local uint64_t l0_appended_generation = 0;
+
+/* count an apply that breaks the commit gate's invariants: an entry landing in another generation
+ * than its record's (G1), or at a sequence the previous memtable already reached (G2). counted, not
+ * refused -- the entry is durable in some log already, and these exist to prove the gate holds */
+static void l0_check_commit_order(tidesdb_l0_t *l0, const tidesdb_memtable_t *mt,
+                                  const uint64_t seq)
+{
+    const uint64_t appended = l0_appended_generation;
+    if (appended != 0 && appended != mt->generation + 1)
+        atomic_fetch_add_explicit(&l0->gate_split_applies, 1, memory_order_relaxed);
+    const uint64_t floor = atomic_load_explicit(&mt->seq_floor, memory_order_acquire);
+    if (floor != 0 && seq <= floor)
+        atomic_fetch_add_explicit(&l0->gate_seq_inversions, 1, memory_order_relaxed);
+}
+
+void tidesdb_l0_commit_enter(tidesdb_l0_t *l0)
+{
+    if (l0) tdb_commit_gate_enter(&l0->commit_gate);
+}
+
+void tidesdb_l0_commit_leave(tidesdb_l0_t *l0)
+{
+    l0_appended_generation = 0;
+    if (l0) tdb_commit_gate_leave(&l0->commit_gate);
+}
+
+void tidesdb_l0_gate_stats(const tidesdb_l0_t *l0, tidesdb_l0_gate_stats_t *out)
+{
+    if (!out) return;
+    memset(out, 0, sizeof(*out));
+    if (!l0) return;
+    out->split_applies = atomic_load_explicit(&l0->gate_split_applies, memory_order_relaxed);
+    out->seq_inversions = atomic_load_explicit(&l0->gate_seq_inversions, memory_order_relaxed);
+    uint64_t max_us = 0;
+    tdb_wait_read(&l0->commit_gate.enter_wait, &out->enter_waits, &out->enter_wait_us, &max_us);
+}
+
 /* raise the memtable's high sequence to seq if it is higher; a concurrent raise past it ends the
  * loop just as a successful swap does */
 static void l0_note_seq(tidesdb_memtable_t *mt, const uint64_t seq)
@@ -394,6 +453,7 @@ static int l0_apply_entry(tidesdb_l0_t *l0, uint32_t cf_index, const uint8_t *ke
 
     tidesdb_memtable_t *mt = l0_pin_active_write(l0);
     if (!mt) return TDB_ERR_BUSY;
+    l0_check_commit_order(l0, mt, seq);
 
     const size_t pkey_size = TDB_CF_PREFIX_SIZE + key_size;
     uint8_t stack_key[TDB_L0_KEY_STACK_BUF];
@@ -466,6 +526,7 @@ int tidesdb_l0_apply_range_tombstone(tidesdb_l0_t *l0, const uint32_t cf_index,
 
     tidesdb_memtable_t *mt = l0_pin_active_write(l0);
     if (!mt) return TDB_ERR_BUSY;
+    l0_check_commit_order(l0, mt, seq);
 
     /* the interval is stored over the prefixed keyspace the skip list is already sorted in, so one
      * set covers every family. an upper bound left open ends where the next family begins, which is
@@ -603,6 +664,8 @@ int tidesdb_l0_wal_append_one(tidesdb_l0_t *l0, const uint8_t *batch, size_t siz
      * still be the one waited on */
     block_manager_t *wal = atomic_load_explicit(&mt->wal, memory_order_acquire);
     int rc = TDB_SUCCESS;
+    /* the generation this commit's entries must land in, which its apply checks */
+    l0_appended_generation = mt->generation + 1;
     if (wal)
     {
         l0_pace_against_ring(l0, wal);
@@ -713,11 +776,26 @@ int tidesdb_l0_rotate(tidesdb_l0_t *l0, tidesdb_memtable_t *new_mt)
      * new_mt also sees the enqueue. the queue takes over the sealed memtable's structural
      * reference, so an enqueue OOM leaves it in the active slot untouched and the data stays
      * durable in its WAL for recovery. */
-    if (queue_enqueue(l0->queue, sealed) != 0) return TDB_ERR_MEMORY;
+    /* closed around the swap only, so no commit is between its sequence draw and its apply while
+     * the active slot changes: its record and its entries land in one generation (G1), and every
+     * sequence drawn after the swap is above every one the sealed memtable holds (G2). the caller
+     * holds rotate_lock, so this is the only closer */
