diff --git a/src/memtable/commit_gate.c b/src/memtable/commit_gate.c
new file mode 100644
--- /dev/null
+++ b/src/memtable/commit_gate.c
@@ -0,0 +1,97 @@
+/**
+ *
+ * Copyright (c) 2022-2026 TidesDB Corp. and/or its affiliates.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+#include "commit_gate.h"
+
+/* the closer re-reads inflight on this cadence even unwoken, a net under a wake the slow path
+ * could miss; the leaver's wake is what normally ends the wait */
+#define TDB_COMMIT_GATE_CLOSE_RECHECK_US 200
+
+int tdb_commit_gate_init(tdb_commit_gate_t *g)
+{
+    atomic_init(&g->inflight, 0);
+    atomic_init(&g->closed, 0);
+    tdb_wait_init(&g->enter_wait);
+    if (pthread_mutex_init(&g->mtx, NULL) != 0) return -1;
+    /* on the clock the closer's deadline is built from, so a wall clock step cannot stretch the
+     * recheck */
+    if (tdb_cond_init_monotonic(&g->cv) != 0)
+    {
+        pthread_mutex_destroy(&g->mtx);
+        return -1;
+    }
+    return 0;
+}
+
+void tdb_commit_gate_destroy(tdb_commit_gate_t *g)
+{
+    pthread_cond_destroy(&g->cv);
+    pthread_mutex_destroy(&g->mtx);
+}
+
+void tdb_commit_gate_enter(tdb_commit_gate_t *g)
+{
+    uint64_t held_from = 0;
+    for (;;)
+    {
+        /* seq_cst both, against the closer's seq_cst store of closed and load of inflight: either
+         * the closer sees this add and waits for it, or this load sees closed and backs out */
+        atomic_fetch_add_explicit(&g->inflight, 1, memory_order_seq_cst);
+        if (!atomic_load_explicit(&g->closed, memory_order_seq_cst)) break;
+
+        if (held_from == 0) held_from = tdb_monotonic_us();
+        pthread_mutex_lock(&g->mtx);
+        /* undone under the lock, so the closer, which reads inflight under it, cannot read the
+         * add and then miss the wake that follows its removal */
+        if (atomic_fetch_sub_explicit(&g->inflight, 1, memory_order_seq_cst) == 1)
+            pthread_cond_broadcast(&g->cv);
+        while (atomic_load_explicit(&g->closed, memory_order_seq_cst))
+            pthread_cond_wait(&g->cv, &g->mtx);
+        pthread_mutex_unlock(&g->mtx);
+    }
+    if (held_from != 0) tdb_wait_note(&g->enter_wait, tdb_monotonic_us() - held_from);
+}
+
+void tdb_commit_gate_leave(tdb_commit_gate_t *g)
+{
+    /* the last one out of a closing gate wakes the closer. an open gate costs the one subtract and
+     * one load, since no one is waiting */
+    if (atomic_fetch_sub_explicit(&g->inflight, 1, memory_order_seq_cst) == 1 &&
+        atomic_load_explicit(&g->closed, memory_order_seq_cst))
+    {
+        pthread_mutex_lock(&g->mtx);
+        pthread_cond_broadcast(&g->cv);
+        pthread_mutex_unlock(&g->mtx);
+    }
+}
+
+void tdb_commit_gate_close(tdb_commit_gate_t *g)
+{
+    pthread_mutex_lock(&g->mtx);
+    atomic_store_explicit(&g->closed, 1, memory_order_seq_cst);
+    while (atomic_load_explicit(&g->inflight, memory_order_seq_cst) != 0)
+    {
+        struct timespec deadline;
+        tdb_wait_deadline(&deadline, TDB_COMMIT_GATE_CLOSE_RECHECK_US);
+        (void)pthread_cond_timedwait(&g->cv, &g->mtx, &deadline);
+    }
+    pthread_mutex_unlock(&g->mtx);
+}
+
+void tdb_commit_gate_open(tdb_commit_gate_t *g)
+{
+    pthread_mutex_lock(&g->mtx);
+    atomic_store_explicit(&g->closed, 0, memory_order_seq_cst);
+    pthread_cond_broadcast(&g->cv);
+    pthread_mutex_unlock(&g->mtx);
+}
+
+int64_t tdb_commit_gate_inflight(tdb_commit_gate_t *g)
+{
+    return atomic_load_explicit(&g->inflight, memory_order_seq_cst);
+}
diff --git a/src/memtable/commit_gate.h b/src/memtable/commit_gate.h
new file mode 100644
--- /dev/null
+++ b/src/memtable/commit_gate.h
@@ -0,0 +1,125 @@
+/**
+ *
+ * Copyright (c) 2022-2026 TidesDB Corp. and/or its affiliates.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+#ifndef __TIDESDB_COMMIT_GATE_H__
+#define __TIDESDB_COMMIT_GATE_H__
+
+#include "../compat.h"
+#include "base/waitstat.h" /* tdb_wait_stat_t for the time arrivals spend held off */
+
+/* the commit gate. a commit enters before it draws its sequence and leaves once its entries are
+ * applied; a rotation closes the gate around the swap of the active memtable. without it a
+ * rotation could land between a commit's log append and its apply, putting the record in WAL g and
+ * some or all of the entries in memtable g+1. the flush of g then drains only g's writers, builds
+ * an sstable without those entries and unlinks WAL g, and a kill before g+1 flushes loses or tears
+ * an acknowledged commit.
+ *
+ * invariants:
+ * G1 generation atomicity -- every WRITE_BATCH record in WAL g has all its entries in memtable g,
+ *    and memtable g holds no entry whose record is in another WAL (single-phase commits and 2PC
+ *    phase two alike: commit_prepared draws, appends COMMIT and applies inside the gate).
+ * G2 sequence separation -- every sequence in memtable g is below every sequence in memtable g+1.
+ *    the draw and the apply are both inside the gate and the swap is exclusive, so once a close
+ *    returns every drawn sequence is applied (or decided aborted), and every later draw is higher.
+ *    the one exception is a prepare, which leaves before marking its sequence aborted; that
+ *    sequence never carries a version, and the mark after the leave never blocks.
+ * G3 no wait cycle -- a holder waits only on the WAL flush thread (ring space, durability), the
+ *    value log, the skip list and validation's source reads; never on rotate_lock, a flush,
+ *    admission pacing or the visibility watermark. admission pacing and the claims come before
+ *    enter, wait_visible after leave, and nothing inside the gate takes rotate_lock (the
+ *    commit-path rotation runs after the commit returns). the rotator holds rotate_lock and then
+ *    closes the gate, so there is one closer.
+ * G4 unchanged contract -- a commit still returns only once durable per the sync mode and visible.
+ *
+ * caveats:
+ * - ring pacing (l0_pace_against_ring, a usleep inside the WAL append) runs inside the gate. it is
+ *   not a cycle, since the ring drains on its own thread, but a rotation can wait out a paced
+ *   commit. validation (txn_validate, txn_validate_writes) also runs inside and may read sstables,
+ *   which a rotation likewise waits out.
+ * - a prepare leaves right after its PREPARE record (and the reads record ahead of it), since no
+ *   apply follows in that call. its sequence never carries a version, so G2 is not at stake.
+ *
+ * the fast path is one seq_cst add on inflight and one seq_cst load of closed, a Dekker pairing
+ * with the closer's seq_cst store of closed and load of inflight. an arrival that finds the gate
+ * closed undoes its add, wakes the closer if it was the last one in, and waits for the open. this
+ * is writer-preferring by construction: a plain pthread rwlock prefers readers and would starve the
+ * rotator under continuous commits, and tdb_wprwlock_t takes a mutex on every enter. arrivals get
+ * no fairness: one woken by an open can be turned away by the next close, which is bounded by the
+ * rotation rate, since rotations are serialised and each needs a full memtable or a forced flush */
+
+/**
+ * tdb_commit_gate_t
+ * @param inflight commits between their sequence draw and their apply, plus arrivals still deciding
+ * whether the gate is open
+ * @param closed set while a rotation waits for the holders to leave and swaps the memtable
+ * @param mtx guards the slow path: the closer's wait, the arrivals' wait and their wakes
+ * @param cv where the closer waits for inflight to reach zero and arrivals wait for the open
+ * @param enter_wait how often and how long arrivals were held off by a closed gate
+ */
+typedef struct
+{
+    _Atomic(int64_t) inflight;
+    _Atomic(int) closed;
+    pthread_mutex_t mtx;
+    pthread_cond_t cv;
+    tdb_wait_stat_t enter_wait;
+} tdb_commit_gate_t;
+
+/**
+ * tdb_commit_gate_init
+ * initialise an open gate with nobody inside
+ * @param g the gate
+ * @return 0, or -1 when the mutex or condition variable could not be created
+ */
+int tdb_commit_gate_init(tdb_commit_gate_t *g);
+
+/**
+ * tdb_commit_gate_destroy
+ * release the gate's mutex and condition variable; nobody may be inside or waiting
+ * @param g the gate
+ */
+void tdb_commit_gate_destroy(tdb_commit_gate_t *g);
+
+/**
+ * tdb_commit_gate_enter
+ * enter the gate, waiting while a rotation holds it closed. not reentrant
+ * @param g the gate
+ */
+void tdb_commit_gate_enter(tdb_commit_gate_t *g);
+
+/**
+ * tdb_commit_gate_leave
+ * leave the gate, waking a waiting closer when this was the last holder
+ * @param g the gate
+ */
+void tdb_commit_gate_leave(tdb_commit_gate_t *g);
+
+/**
+ * tdb_commit_gate_close
+ * close the gate and wait until nobody is inside; returns with arrivals held off until
+ * tdb_commit_gate_open. one closer at a time (the caller serialises closers)
+ * @param g the gate
+ */
+void tdb_commit_gate_close(tdb_commit_gate_t *g);
+
+/**
+ * tdb_commit_gate_open
+ * reopen a closed gate and release every arrival waiting on it
+ * @param g the gate
+ */
+void tdb_commit_gate_open(tdb_commit_gate_t *g);
+
+/**
+ * tdb_commit_gate_inflight
+ * how many are inside the gate (or deciding whether to enter) right now
+ * @param g the gate
+ * @return the count
+ */
+int64_t tdb_commit_gate_inflight(tdb_commit_gate_t *g);
+
+#endif /* __TIDESDB_COMMIT_GATE_H__ */
