+#include "../src/engine/engine_types.h" /* db->l0 */
+#include "../src/memtable/commit_gate.h"
+#include "../src/memtable/memtable.h"
+#include "../src/txn/txn.h"
+#include "../src/txn/txn_internal.h"
+#include "db.h"
+#include "test_utils.h"
+
+static int tests_passed = 0;
+static int tests_failed = 0;
+
+#define CG_FAST_PATH_PAIRS 1000000
+/* how long a thread that should be held is given to show it is not */
+#define CG_HELD_US 50000
+/* how long a thread that should be released is given to show it is */
+#define CG_RELEASE_US 1000000
+#define CG_POLL_US    100
+
+#define CG_PREF_THREADS  8
+#define CG_PREF_HOLD_US  50
+#define CG_PREF_CLOSES   100
+#define CG_PREF_RUN_US   2000000
+#define CG_PREF_CLOSE_US 100000
+
+#define CG_SKIP_LEVEL 12
+#define CG_SKIP_PROB  0.25f
+
+#define CG_DB_DIR      "." PATH_SEPARATOR "test_commit_gate_db"
+#define CG_WRITERS     8
+#define CG_TXNS        2000
+#define CG_PUTS        16
+#define CG_KEY_SIZE    10
+#define CG_VALUE_SIZE  100
+#define CG_BUFFER      (64u * 1024u)
+#define CG_FLUSH_US    1000
+#define CG_MIN_FLUSHES 20
+
+/* wait for a flag to read non-zero, up to a bound; returns whether it did */
+static int cg_wait_flag(_Atomic(int) *flag, const uint64_t bound_us)
+{
+    for (uint64_t waited = 0; waited < bound_us; waited += CG_POLL_US)
+    {
+        if (atomic_load(flag)) return 1;
+        usleep(CG_POLL_US);
+    }
+    return atomic_load(flag) != 0;
+}
+
+static uint64_t cg_enter_waits(tdb_commit_gate_t *g)
+{
+    uint64_t count = 0, total = 0, max = 0;
+    tdb_wait_read(&g->enter_wait, &count, &total, &max);
+    return count;
+}
+
+/* an uncontended gate is one atomic add and one load each way, and never counts a wait */
+void test_gate_fast_path(void)
+{
+    tdb_commit_gate_t g;
+    ASSERT_EQ(tdb_commit_gate_init(&g), 0);
+    for (int i = 0; i < CG_FAST_PATH_PAIRS; i++)
+    {
+        tdb_commit_gate_enter(&g);
+        tdb_commit_gate_leave(&g);
+    }
+    ASSERT_EQ(tdb_commit_gate_inflight(&g), 0);
+    ASSERT_EQ(cg_enter_waits(&g), 0);
+    tdb_commit_gate_destroy(&g);
+}
+
+typedef struct
+{
+    tdb_commit_gate_t *gate;
+    _Atomic(int) done;
+} cg_thread_arg_t;
+
+static void *cg_closer(void *arg)
+{
+    cg_thread_arg_t *a = (cg_thread_arg_t *)arg;
+    tdb_commit_gate_close(a->gate);
+    atomic_store(&a->done, 1);
+    return NULL;
+}
+
+static void *cg_arrival(void *arg)
+{
+    cg_thread_arg_t *a = (cg_thread_arg_t *)arg;
+    tdb_commit_gate_enter(a->gate);
+    atomic_store(&a->done, 1);
+    tdb_commit_gate_leave(a->gate);
+    return NULL;
+}
+
+/* a close does not return while a commit is inside, and returns promptly once it leaves */
+void test_close_waits_for_inflight(void)
+{
+    tdb_commit_gate_t g;
+    ASSERT_EQ(tdb_commit_gate_init(&g), 0);
+    tdb_commit_gate_enter(&g);
+
+    cg_thread_arg_t a = {.gate = &g};
+    atomic_init(&a.done, 0);
+    pthread_t t;
+    ASSERT_EQ(pthread_create(&t, NULL, cg_closer, &a), 0);
+    usleep(CG_HELD_US);
+    ASSERT_EQ(atomic_load(&a.done), 0);
+
+    tdb_commit_gate_leave(&g);
+    ASSERT_TRUE(cg_wait_flag(&a.done, CG_RELEASE_US));
+    ASSERT_EQ(pthread_join(t, NULL), 0);
+    ASSERT_EQ(tdb_commit_gate_inflight(&g), 0);
+    tdb_commit_gate_open(&g);
+    tdb_commit_gate_destroy(&g);
+}
+
+/* a closed gate holds a new commit off until it opens, and the hold is counted as a wait */
+void test_closed_gate_turns_arrivals_away(void)
+{
+    tdb_commit_gate_t g;
+    ASSERT_EQ(tdb_commit_gate_init(&g), 0);
+    tdb_commit_gate_close(&g);
+
+    cg_thread_arg_t b = {.gate = &g};
+    atomic_init(&b.done, 0);
+    pthread_t t;
+    ASSERT_EQ(pthread_create(&t, NULL, cg_arrival, &b), 0);
+    usleep(CG_HELD_US);
+    ASSERT_EQ(atomic_load(&b.done), 0);
+
+    tdb_commit_gate_open(&g);
+    ASSERT_TRUE(cg_wait_flag(&b.done, CG_RELEASE_US));
+    ASSERT_EQ(pthread_join(t, NULL), 0);
+    ASSERT_EQ(cg_enter_waits(&g), 1);
+    ASSERT_EQ(tdb_commit_gate_inflight(&g), 0);
+    tdb_commit_gate_destroy(&g);
+}
+
+typedef struct
+{
+    tdb_commit_gate_t *gate;
+    _Atomic(int) *stop;
+    _Atomic(int) *holders; /* loopers past enter and not yet at leave */
+} cg_looper_arg_t;
+
+static void *cg_looper(void *arg)
+{
+    cg_looper_arg_t *a = (cg_looper_arg_t *)arg;
+    while (!atomic_load(a->stop))
+    {
+        tdb_commit_gate_enter(a->gate);
+        atomic_fetch_add(a->holders, 1);
+        usleep(CG_PREF_HOLD_US);
+        atomic_fetch_sub(a->holders, 1);
+        tdb_commit_gate_leave(a->gate);
+    }
+    return NULL;
+}
+
+/* commits arriving without pause never starve a rotation: the closed flag turns them away, so a
+ * close waits only for the ones already inside. what a close guarantees is that no one is past the
+ * gate, counted here by the loopers themselves -- inflight may still hold an arrival that has seen
+ * the closed flag and is backing out */
+void test_writer_preference(void)
+{
+    tdb_commit_gate_t g;
+    ASSERT_EQ(tdb_commit_gate_init(&g), 0);
+    _Atomic(int) stop;
+    atomic_init(&stop, 0);
+    _Atomic(int) holders;
+    atomic_init(&holders, 0);
+    cg_looper_arg_t arg = {.gate = &g, .stop = &stop, .holders = &holders};
+    pthread_t t[CG_PREF_THREADS];
+    for (int i = 0; i < CG_PREF_THREADS; i++)
+        ASSERT_EQ(pthread_create(&t[i], NULL, cg_looper, &arg), 0);
+
+    uint64_t worst = 0;
+    for (int i = 0; i < CG_PREF_CLOSES; i++)
+    {
+        usleep(CG_PREF_RUN_US / CG_PREF_CLOSES);
+        const uint64_t from = tdb_monotonic_us();
+        tdb_commit_gate_close(&g);
+        const uint64_t took = tdb_monotonic_us() - from;
+        ASSERT_EQ(atomic_load(&holders), 0);
+        tdb_commit_gate_open(&g);
+        if (took > worst) worst = took;
+        ASSERT_TRUE(took < CG_PREF_CLOSE_US);
+    }
+    printf("(slowest close %llu us) ", (unsigned long long)worst);
+
+    atomic_store(&stop, 1);
+    for (int i = 0; i < CG_PREF_THREADS; i++) ASSERT_EQ(pthread_join(t[i], NULL), 0);
+    ASSERT_EQ(tdb_commit_gate_inflight(&g), 0);
+    tdb_commit_gate_destroy(&g);
+}
+
+typedef struct
+{
+    tidesdb_l0_t *l0;
+    tidesdb_memtable_t *mt;
+    _Atomic(int) done;
+    int rc;
+} cg_rotate_arg_t;
+
+static void *cg_rotator(void *arg)
+{
+    cg_rotate_arg_t *a = (cg_rotate_arg_t *)arg;
+    a->rc = tidesdb_l0_rotate(a->l0, a->mt);
+    atomic_store(&a->done, 1);
+    return NULL;
+}
+
+/* a rotation does not swap the active memtable while a commit is inside the gate */
+void test_rotation_waits_for_commit_inside_gate(void)
+{
+    tidesdb_l0_t *l0 = tidesdb_l0_create(CG_BUFFER, 0, CG_SKIP_LEVEL, CG_SKIP_PROB, NULL, NULL);
+    ASSERT_TRUE(l0 != NULL);
+    tidesdb_memtable_t *old_mt =
+        tidesdb_memtable_create(NULL, 1, 1, CG_SKIP_LEVEL, CG_SKIP_PROB, NULL, NULL);
+    ASSERT_TRUE(old_mt != NULL);
+    ASSERT_TRUE(tidesdb_l0_set_active(l0, old_mt) == NULL);
+    tidesdb_memtable_t *new_mt =
+        tidesdb_memtable_create(NULL, 2, 2, CG_SKIP_LEVEL, CG_SKIP_PROB, NULL, NULL);
+    ASSERT_TRUE(new_mt != NULL);
+
+    tidesdb_l0_commit_enter(l0);
+    cg_rotate_arg_t a = {.l0 = l0, .mt = new_mt, .rc = -1};
+    atomic_init(&a.done, 0);
+    pthread_t t;
+    ASSERT_EQ(pthread_create(&t, NULL, cg_rotator, &a), 0);
+    usleep(CG_HELD_US);
+    ASSERT_EQ(atomic_load(&a.done), 0);
+    ASSERT_TRUE(atomic_load(&l0->active) == old_mt);
+
+    tidesdb_l0_commit_leave(l0);
+    ASSERT_TRUE(cg_wait_flag(&a.done, CG_RELEASE_US));
+    ASSERT_EQ(pthread_join(t, NULL), 0);
+    ASSERT_EQ(a.rc, TDB_SUCCESS);
+    ASSERT_TRUE(atomic_load(&l0->active) == new_mt);
+    tidesdb_l0_destroy(l0); /* frees the active memtable and the sealed one in the queue */
+}
+
+/* a mock commit backend counting the gate calls and able to fail the log append or the apply */
+typedef struct
+{
+    int enters;
+    int leaves;
+    int fail_wal;
+    int fail_apply;
+} cg_backend_t;
+
+static int cg_be_wal(void *ctx, const uint8_t *batch, size_t size)
+{
+    (void)batch;
+    (void)size;
+    return ((cg_backend_t *)ctx)->fail_wal ? -1 : 0;
+}
+
+static int cg_be_apply(void *ctx, const tidesdb_wal_entry_t *entries, int count)
+{
+    (void)entries;
+    (void)count;
+    return ((cg_backend_t *)ctx)->fail_apply ? -1 : 0;
+}
+
+static void cg_be_enter(void *ctx)
+{
+    cg_backend_t *m = (cg_backend_t *)ctx;
+    /* the gate is not reentrant: a commit path entering twice would deadlock a rotation */
+    ASSERT_EQ(m->enters, m->leaves);
+    m->enters++;
+}
+
+static void cg_be_leave(void *ctx)
+{
+    cg_backend_t *m = (cg_backend_t *)ctx;
+    m->leaves++;
+    ASSERT_EQ(m->enters, m->leaves);
+}
+
+static tdb_txn_backend_t cg_backend(cg_backend_t *m)
+{
+    tdb_txn_backend_t b = {.wal_append = cg_be_wal,
+                           .apply = cg_be_apply,
+                           .commit_enter = cg_be_enter,
+                           .commit_leave = cg_be_leave,
+                           .ctx = m};
+    return b;
+}
+
+static tdb_txn_t *cg_writing_txn(tidesdb_mvcc_t *clock)
+{
+    tdb_txn_t *t = tdb_txn_begin(clock, TDB_ISOLATION_READ_COMMITTED, NULL, 0, NULL);
+    ASSERT_TRUE(t != NULL);
+    ASSERT_EQ(tdb_txn_put(t, 0, (const uint8_t *)"k", 1, (const uint8_t *)"v", 1, -1), TDB_SUCCESS);
+    return t;
+}
+
+/* every way a commit ends leaves the gate it entered, once: a commit that did not would hang the
+ * next rotation for good */
+void test_every_commit_path_balances_the_gate(void)
+{
+    tidesdb_mvcc_t *clock = tidesdb_mvcc_create();
+    ASSERT_TRUE(clock != NULL);
+    const uint8_t xid[] = {7, 7};
+
+    /* (a) success */
+    cg_backend_t m = {0};
+    tdb_txn_backend_t be = cg_backend(&m);
+    tdb_txn_t *t = cg_writing_txn(clock);
+    ASSERT_EQ(tdb_txn_commit(t, &be, NULL, 0), TDB_SUCCESS);
+    ASSERT_EQ(m.enters, 1);
+    ASSERT_EQ(m.leaves, 1);
+    tdb_txn_free(t);
+
+    /* (b) the log append fails */
+    memset(&m, 0, sizeof(m));
+    m.fail_wal = 1;
+    t = cg_writing_txn(clock);
+    ASSERT_EQ(tdb_txn_commit(t, &be, NULL, 0), TDB_ERR_IO);
+    ASSERT_EQ(m.enters, 1);
+    ASSERT_EQ(m.leaves, 1);
+    tdb_txn_free(t);
+
+    /* (c) the apply fails after the record is durable */
+    memset(&m, 0, sizeof(m));
+    m.fail_apply = 1;
+    t = cg_writing_txn(clock);
+    ASSERT_EQ(tdb_txn_commit(t, &be, NULL, 0), TDB_ERR_IO);
+    ASSERT_EQ(m.enters, 1);
+    ASSERT_EQ(m.leaves, 1);
+    tdb_txn_free(t);
+
+    /* (d) prepare, then phase two: each call holds the gate once */
+    memset(&m, 0, sizeof(m));
+    t = cg_writing_txn(clock);
+    ASSERT_EQ(tdb_txn_prepare(t, &be, NULL, 0, xid, sizeof(xid)), TDB_SUCCESS);
+    ASSERT_EQ(m.enters, 1);
+    ASSERT_EQ(m.leaves, 1);
+    ASSERT_EQ(tdb_txn_commit_prepared(t, &be), TDB_SUCCESS);
+    ASSERT_EQ(m.enters, 2);
+    ASSERT_EQ(m.leaves, 2);
+    tdb_txn_free(t);
+
+    /* (e) prepare, then a phase two whose COMMIT record fails, which stays prepared */
+    memset(&m, 0, sizeof(m));
+    t = cg_writing_txn(clock);
+    ASSERT_EQ(tdb_txn_prepare(t, &be, NULL, 0, xid, sizeof(xid)), TDB_SUCCESS);
+    m.fail_wal = 1;
+    ASSERT_EQ(tdb_txn_commit_prepared(t, &be), TDB_ERR_IO);
+    ASSERT_EQ(m.enters, 2);
+    ASSERT_EQ(m.leaves, 2);
+    ASSERT_EQ(tdb_txn_state(t), TDB_TXN_PREPARED);
+    m.fail_wal = 0;
+    ASSERT_EQ(tdb_txn_rollback_prepared(t, &be), TDB_SUCCESS);
+    ASSERT_EQ(m.enters, 2); /* a rollback draws nothing and applies nothing */
+    tdb_txn_free(t);
+
+    /* (f) a read-only commit has nothing durable to do and never enters */
+    memset(&m, 0, sizeof(m));
+    t = tdb_txn_begin(clock, TDB_ISOLATION_READ_COMMITTED, NULL, 0, NULL);
+    ASSERT_TRUE(t != NULL);
+    ASSERT_EQ(tdb_txn_commit(t, &be, NULL, 0), TDB_SUCCESS);
+    ASSERT_EQ(m.enters, 0);
+    ASSERT_EQ(m.leaves, 0);
+    tdb_txn_free(t);
+
+    tidesdb_mvcc_destroy(clock);
+}
+
+typedef struct
+{
+    tidesdb_t *db;
+    tidesdb_column_family_t *cf;
+    int id;
+    _Atomic(int) *stop;
+} cg_writer_arg_t;
+
+static void *cg_writer(void *arg)
+{
+    cg_writer_arg_t *a = (cg_writer_arg_t *)arg;
+    uint8_t value[CG_VALUE_SIZE];
+    memset(value, 'v', sizeof(value));
+    for (int i = 0; i < CG_TXNS; i++)
+    {
+        tidesdb_txn_t *txn = NULL;
+        ASSERT_EQ(tidesdb_txn_begin_with_isolation(a->db, TDB_ISOLATION_READ_COMMITTED, &txn),
+                  TDB_SUCCESS);
+        for (int j = 0; j < CG_PUTS; j++)
+        {
+            char key[CG_KEY_SIZE + 1];
+            snprintf(key, sizeof(key), "%02d%08d", a->id, i * CG_PUTS + j);
+            ASSERT_EQ(tidesdb_txn_put(txn, a->cf, (const uint8_t *)key, CG_KEY_SIZE, value,
+                                      sizeof(value), -1),
+                      TDB_SUCCESS);
+        }
+        ASSERT_EQ(tidesdb_txn_commit(txn), TDB_SUCCESS);
+        tidesdb_txn_free(txn);
+    }
+    return NULL;
+}
+
+static void *cg_flusher(void *arg)
+{
+    cg_writer_arg_t *a = (cg_writer_arg_t *)arg;
+    while (!atomic_load(a->stop))
+    {
+        /* a queue writers keep refilling may not drain in the wait, which is not this test's
+         * concern: the rotation it forces is */
+        (void)tidesdb_flush_memtable(a->db);
+        usleep(CG_FLUSH_US);
+    }
+    return NULL;
+}
+
+/* concurrent commits against rotations from the commit path and from a flushing thread: no entry
+ * lands outside the generation its record went to, and no younger memtable takes a sequence an
+ * older one already passed */
+void test_concurrent_commits_keep_g1_g2(void)
+{
+    (void)remove_directory(CG_DB_DIR);
+    tidesdb_config_t cfg = tidesdb_default_config();
+    cfg.db_path = CG_DB_DIR;
+    cfg.memtable_sync_mode = TDB_SYNC_NONE;
+    cfg.memtable_write_buffer_size = CG_BUFFER;
+    cfg.memtable_idle_flush_seconds = 0;
+    /* thousands of 64 KiB flushes deepen the flush tier faster than it merges, and the tier stall
+     * would hold each commit for the admission ceiling. the rotations are what is under test */
+    cfg.memtable_l0_queue_stall_threshold = 0;
+    tidesdb_t *db = NULL;
+    ASSERT_EQ(tidesdb_open(&cfg, &db), TDB_SUCCESS);
+    tidesdb_column_family_config_t cc = tidesdb_default_column_family_config();
+    ASSERT_EQ(tidesdb_create_column_family(db, "cf0", &cc), TDB_SUCCESS);
+    tidesdb_column_family_t *cf = tidesdb_get_column_family(db, "cf0");
+    ASSERT_TRUE(cf != NULL);
+
+    _Atomic(int) stop;
+    atomic_init(&stop, 0);
+    cg_writer_arg_t args[CG_WRITERS + 1];
+    pthread_t threads[CG_WRITERS + 1];
+    for (int i = 0; i <= CG_WRITERS; i++)
+    {
+        args[i] = (cg_writer_arg_t){.db = db, .cf = cf, .id = i, .stop = &stop};
+        ASSERT_EQ(
+            pthread_create(&threads[i], NULL, i < CG_WRITERS ? cg_writer : cg_flusher, &args[i]),
+            0);
+    }
+    for (int i = 0; i < CG_WRITERS; i++) ASSERT_EQ(pthread_join(threads[i], NULL), 0);
+    atomic_store(&stop, 1);
+    ASSERT_EQ(pthread_join(threads[CG_WRITERS], NULL), 0);
+
+    tidesdb_l0_gate_stats_t gs;
+    tidesdb_l0_gate_stats(db->l0, &gs);
+    tidesdb_db_stats_t st;
+    memset(&st, 0, sizeof(st));
+    ASSERT_EQ(tidesdb_get_db_stats(db, &st), TDB_SUCCESS);
+    printf("(flushes %llu, split applies %llu, seq inversions %llu) ",
+           (unsigned long long)st.flush_count, (unsigned long long)gs.split_applies,
+           (unsigned long long)gs.seq_inversions);
+    fflush(stdout); /* the counts are the diagnosis when the assertion below aborts */
+    ASSERT_TRUE(gs.split_applies == 0 && gs.seq_inversions == 0);
+    ASSERT_TRUE(st.flush_count > CG_MIN_FLUSHES);
+
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(CG_DB_DIR);
+}
+
+void test_stall_reason_named(void)
+{
+    ASSERT_TRUE(strcmp(tidesdb_stall_reason_name(TDB_STALL_COMMIT_GATE), "commit_gate") == 0);
+}
+
+int main(int argc, char **argv)
+{
+    INIT_TEST_FILTER(argc, argv);
+    RUN_TEST(test_gate_fast_path, tests_passed);
+    RUN_TEST(test_close_waits_for_inflight, tests_passed);
+    RUN_TEST(test_closed_gate_turns_arrivals_away, tests_passed);
+    RUN_TEST(test_writer_preference, tests_passed);
+    RUN_TEST(test_rotation_waits_for_commit_inside_gate, tests_passed);
+    RUN_TEST(test_every_commit_path_balances_the_gate, tests_passed);
+    RUN_TEST(test_concurrent_commits_keep_g1_g2, tests_passed);
+    RUN_TEST(test_stall_reason_named, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
