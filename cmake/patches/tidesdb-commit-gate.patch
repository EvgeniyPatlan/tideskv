+/* the commit gate. a commit holds the gate from before it draws its sequence until its entries are
+ * applied, and a rotation closes it around the swap of the active memtable, so a commit's log
+ * record and its entries always land in the same generation (G1) and every sequence in a younger
+ * memtable is above every one in an older memtable (G2). the primitive is checked on its own, then
+ * the l0 rotation against it, then every txn commit path for a balanced enter and leave, and last a
+ * database under concurrent commits and forced rotations, read through the l0's order counters */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
