+/* an exact arena serves what it was sized for from its block, and an allocation past that from a
+ * block of its own, counted, accounted and freed with the arena */
+static void test_exact_arena_overflow_falls_back(void)
+{
+    arena_t *a = arena_create_exact(100);
+    ASSERT_TRUE(a != NULL);
+    const size_t reserved = arena_bytes_reserved(a);
+    ASSERT_TRUE(reserved >= 100 && reserved <= 100 + 64);
+
+    const int64_t before = arena_exact_overflows();
+    uint8_t *p = arena_alloc(a, 60, 8);
+    uint8_t *q = arena_alloc(a, 40, 1);
+    ASSERT_TRUE(p != NULL && q != NULL);
+    memset(p, 1, 60);
+    memset(q, 2, 40);
+    ASSERT_EQ(arena_exact_overflows() - before, 0);
+    ASSERT_EQ(arena_bytes_reserved(a), reserved);
+
+    uint8_t *r = arena_alloc(a, 4000, 0);
+    ASSERT_TRUE(r != NULL);
+    memset(r, 3, 4000);
+    ASSERT_EQ(arena_exact_overflows() - before, 1);
+    ASSERT_TRUE(arena_bytes_reserved(a) >= reserved + 4000);
+    ASSERT_EQ(arena_bytes_allocated(a), (size_t)4100);
+    ASSERT_EQ(p[59], 1);
+    ASSERT_EQ(q[39], 2);
+
+    /* a reset empties the block and drops the overflow, and the block serves again */
+    arena_reset(a);
+    ASSERT_EQ(arena_bytes_reserved(a), reserved);
+    ASSERT_EQ(arena_bytes_allocated(a), (size_t)0);
+    ASSERT_TRUE(arena_alloc(a, 100, 1) != NULL);
+    ASSERT_EQ(arena_exact_overflows() - before, 1);
+    arena_destroy(a);
+
+    /* a zero-byte arena is valid and overflows on its first allocation */
+    a = arena_create_exact(0);
+    ASSERT_TRUE(a != NULL);
+    ASSERT_TRUE(arena_alloc(a, 8, 0) != NULL);
+    ASSERT_EQ(arena_exact_overflows() - before, 2);
+    arena_destroy(a);
+}
+
+/* a decode into a caller's buffer gives the allocating decode's bytes, and refuses a buffer too
+ * short for them, for every codec and for a stacked chain */
+static void test_decode_into_matches_and_refuses_short(void)
+{
+    uint8_t src[5000];
+    for (size_t i = 0; i < sizeof(src); i++) src[i] = (uint8_t)((i * 31) % 7 + (i / 100));
+    for (int mi = 0; mi < g_mode_count + 1; mi++)
+    {
+        tidesdb_encoding_stage_t stacked[2];
+        const tidesdb_encoding_stage_t *codec;
+        int count;
+        if (mi < g_mode_count)
+        {
+            codec = g_modes[mi].codec;
+            count = g_modes[mi].codec_count;
+        }
+        else
+        {
+            /* the last mode stacks the first real codec over none, which takes the copying path */
+            const uint8_t ids[2] = {TDB_COMPRESS_NONE,
+                                    g_mode_count > 1 ? TDB_COMPRESS_LZ4 : TDB_COMPRESS_NONE};
+            ASSERT_EQ(tidesdb_encoding_resolve(&g_reg, ids, 2, stacked, 2), 2);
+            codec = stacked;
+            count = 2;
+        }
+        uint8_t *enc = NULL;
+        size_t enc_size = 0;
+        ASSERT_EQ(tidesdb_encoding_stages_encode(codec, count, src, sizeof(src), &enc, &enc_size),
+                  TDB_SUCCESS);
+        uint8_t dst[sizeof(src) + 16];
+        size_t got = 0;
+        ASSERT_EQ(tidesdb_encoding_stages_decode_into(codec, count, enc, enc_size, dst, sizeof(dst),
+                                                      &got),
+                  TDB_SUCCESS);
+        ASSERT_EQ(got, sizeof(src));
+        ASSERT_EQ(memcmp(dst, src, sizeof(src)), 0);
+        ASSERT_EQ(tidesdb_encoding_stages_decode_into(codec, count, enc, enc_size, dst,
+                                                      sizeof(src) - 1, &got),
+                  TDB_ERR_INVALID_ARGS);
+        if (count == 1 && enc_size > 16)
+        {
+            /* damaged compressed bytes do not decode */
+            uint8_t *bad = malloc(enc_size);
+            ASSERT_TRUE(bad != NULL);
+            memcpy(bad, enc, enc_size);
+            for (size_t i = 12; i < enc_size; i++) bad[i] ^= 0x5a;
+            const int rc = tidesdb_encoding_stages_decode_into(codec, count, bad, enc_size, dst,
+                                                               sizeof(dst), &got);
+            if (g_modes[mi].codec_count > 0)
+                ASSERT_TRUE(rc != TDB_SUCCESS || got != sizeof(src) ||
+                            memcmp(dst, src, sizeof(src)) != 0);
+            free(bad);
+        }
+        free(enc);
+    }
+}
+
+/* point gets, both cursors and absent keys read what was written, for every codec and node size */
+static void test_round_trip_unchanged(void)
+{
+    for (int mi = 0; mi < g_mode_count; mi++)
+    {
+        for (size_t si = 0; si < NA_NODE_SIZE_COUNT; si++)
+        {
+            na_table_t t;
+            na_build(&t, &g_modes[mi], g_node_sizes[si], NA_KEYS);
+            na_point_gets(t.tree, NA_KEYS, 1);
+            na_scan(t.tree, NA_KEYS, 0);
+            na_scan(t.tree, NA_KEYS, 1);
+
+            /* the same reads with no cache, each node decoded and freed per use */
+            btree_set_node_cache(t.tree, NULL, 0);
+            na_point_gets(t.tree, NA_KEYS, 11);
+            na_scan(t.tree, NA_KEYS, 0);
+            na_scan(t.tree, NA_KEYS, 1);
+            na_drop(&t);
+        }
+    }
+}
+
+int main(int argc, char **argv)
+{
+    ASSERT_TRUE(na_init_codecs());
+    INIT_TEST_FILTER(argc, argv);
+    RUN_TEST(test_exact_arena_holds_whole_node, tests_passed);
+    RUN_TEST(test_reserved_near_allocated, tests_passed);
+    RUN_TEST(test_cache_charges_under_six_kib_per_leaf, tests_passed);
+#ifdef NODE_ARENA_COUNT_ALLOCS
+    RUN_TEST(test_decode_mallocs_per_miss, tests_passed);
+#else
+    printf("skipped: test_decode_mallocs_per_miss (a sanitizer owns the allocator)\n");
+#endif
+    RUN_TEST(test_round_trip_unchanged, tests_passed);
+    RUN_TEST(test_exact_arena_overflow_falls_back, tests_passed);
+    RUN_TEST(test_decode_into_matches_and_refuses_short, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
