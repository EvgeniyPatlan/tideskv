+/* a decoded btree node is sized before it is built: the decode walks the node into thread-local
+ * scratch, adds up what the node keeps, and carves it all out of one exact arena block, so the node
+ * cache, which charges what the arena reserved, is charged about what the node holds rather than a
+ * pooled chunk twice its size. a compressed node is decompressed into a thread-local buffer rather
+ * than a fresh allocation per read. these cases check that the sizing is right (nothing spills out
+ * of the block, reserved is within a few bytes of allocated), that the cache now holds more nodes
+ * per byte, that a miss allocates about once, and that every read returns what it did before, for
+ * each codec this build has and three node sizes */
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "../src/base/arena.h"
+#include "../src/base/encoding/compress.h"
+#include "../src/base/encoding/encoding.h"
+#include "../src/base/errors.h"
+#include "../src/cache/cache.h"
+#include "../src/io/block_manager.h"
+#include "../src/sstable/btree/btree.h"
+#include "../src/sstable/btree/btree_internal.h"
+#include "test_utils.h"
+
+static int tests_passed = 0;
+static int tests_failed = 0;
+
+#define NA_DIR        "." PATH_SEPARATOR "test_btree_node_arena"
+#define NA_DIR_MODE   0755
+#define NA_KLOG       NA_DIR PATH_SEPARATOR "1.klog"
+#define NA_KEYS       50000
+#define NA_KEY_MAX    32
+#define NA_VALUE_MIN  10
+#define NA_VALUE_MAX  300
+#define NA_CACHE      (64u << 20)
+#define NA_POOL_CHUNK (2 * 4096) /* what the engine's node pool uses for 4 KiB nodes */
+
+/* allocation counting, as in the builder arena suite: the binary's own malloc family forwards to
+ * glibc and counts while enabled. a sanitizer owns the allocator, so the override and the case that
+ * needs it exist only when NODE_ARENA_COUNT_ALLOCS is defined, which the build does without one */
+#ifdef NODE_ARENA_COUNT_ALLOCS
+extern void *__libc_malloc(size_t);
+extern void *__libc_calloc(size_t, size_t);
+extern void *__libc_realloc(void *, size_t);
+extern void __libc_free(void *);
+
+static volatile int g_counting = 0;
+static volatile uint64_t g_allocs = 0;
+
+void *malloc(size_t n)
+{
+    if (g_counting) g_allocs++;
+    return __libc_malloc(n);
+}
+
+void *calloc(size_t a, size_t b)
+{
+    if (g_counting) g_allocs++;
+    return __libc_calloc(a, b);
+}
+
+void *realloc(void *p, size_t n)
+{
+    if (g_counting) g_allocs++;
+    return __libc_realloc(p, n);
+}
+
+void free(void *p)
+{
+    __libc_free(p);
+}
+#endif
+
+static tidesdb_encoding_registry_t g_reg;
+static tidesdb_encoding_stage_t g_lz4[1];
+static tidesdb_encoding_stage_t g_zstd[1];
+
+typedef struct
+{
+    const char *name;
+    const tidesdb_encoding_stage_t *codec;
+    int codec_count;
+} na_mode_t;
+
+static na_mode_t g_modes[3];
+static int g_mode_count = 0;
+
+static const size_t g_node_sizes[] = {4096, 16384, 65536};
+#define NA_NODE_SIZE_COUNT (sizeof(g_node_sizes) / sizeof(g_node_sizes[0]))
+
+/* the codecs this build can run: none always, lz4 and zstd when built with compression */
+static int na_init_codecs(void)
+{
+    if (tidesdb_encoding_registry_init(&g_reg) != TDB_SUCCESS) return 0;
+    g_modes[g_mode_count++] = (na_mode_t){"none", NULL, 0};
+    const uint8_t lz4[1] = {TDB_COMPRESS_LZ4};
+    if (tidesdb_encoding_resolve(&g_reg, lz4, 1, g_lz4, 1) == 1)
+        g_modes[g_mode_count++] = (na_mode_t){"lz4", g_lz4, 1};
+    else
+        printf("lz4 unavailable in this build\n");
+    const uint8_t zstd[1] = {TDB_COMPRESS_ZSTD};
+    if (tidesdb_encoding_resolve(&g_reg, zstd, 1, g_zstd, 1) == 1)
+        g_modes[g_mode_count++] = (na_mode_t){"zstd", g_zstd, 1};
+    else
+        printf("zstd unavailable in this build\n");
+    return 1;
+}
+
+static const na_mode_t *na_mode(const char *name)
+{
+    for (int i = 0; i < g_mode_count; i++)
+        if (strcmp(g_modes[i].name, name) == 0) return &g_modes[i];
+    return NULL;
+}
+
+static uint32_t na_hash(uint64_t i)
+{
+    uint64_t x = i * 0x9E3779B97F4A7C15ULL + 0x7654321ULL;
+    x ^= x >> 29;
+    x *= 0xBF58476D1CE4E5B9ULL;
+    x ^= x >> 32;
+    return (uint32_t)x;
+}
+
+/* entry i: a key that sorts by i, and a value of 10-300 bytes */
+static size_t na_key(uint8_t *buf, uint64_t i)
+{
+    return (size_t)snprintf((char *)buf, NA_KEY_MAX, "node%010" PRIu64, i);
+}
+
+static size_t na_value(uint8_t *buf, uint64_t i)
+{
+    const size_t n = NA_VALUE_MIN + na_hash(i) % (NA_VALUE_MAX - NA_VALUE_MIN + 1);
+    for (size_t j = 0; j < n; j++) buf[j] = (uint8_t)(i * 7 + j * 13);
+    return n;
+}
+
+static void na_check_entry(const uint8_t *k, size_t ks, const uint8_t *v, size_t vs, uint64_t i)
+{
+    uint8_t wk[NA_KEY_MAX], wv[NA_VALUE_MAX];
+    const size_t wks = na_key(wk, i);
+    const size_t wvs = na_value(wv, i);
+    ASSERT_EQ(ks, wks);
+    ASSERT_EQ(memcmp(k, wk, ks), 0);
+    ASSERT_EQ(vs, wvs);
+    ASSERT_EQ(memcmp(v, wv, vs), 0);
+}
+
+/* one table on disk with its builder's tree */
+typedef struct
+{
+    block_manager_t *bm;
+    btree_builder_t *builder;
+    btree_t *tree;
+    cache_t *cache;
+    arena_pool_t *pool;
+    btree_config_t cfg;
+} na_table_t;
+
+static void na_build(na_table_t *t, const na_mode_t *m, size_t node_size, uint64_t n)
+{
+    memset(t, 0, sizeof(*t));
+    (void)remove_directory(NA_DIR);
+    ASSERT_EQ(mkdir(NA_DIR, NA_DIR_MODE), 0);
+    ASSERT_EQ(block_manager_open(&t->bm, NA_KLOG, BLOCK_MANAGER_SYNC_NONE), 0);
+    t->pool = arena_pool_create(NA_POOL_CHUNK, NA_CACHE);
+    ASSERT_TRUE(t->pool != NULL);
+    t->cfg = (btree_config_t){.target_node_size = node_size,
+                              .codec = m->codec,
+                              .codec_count = m->codec_count,
+                              .arena_pool = t->pool};
+    ASSERT_EQ(btree_builder_new(&t->builder, t->bm, &t->cfg), 0);
+    uint8_t k[NA_KEY_MAX], v[NA_VALUE_MAX];
+    for (uint64_t i = 0; i < n; i++)
+    {
+        const size_t ks = na_key(k, i);
+        const size_t vs = na_value(v, i);
+        ASSERT_EQ(btree_builder_add(t->builder, k, ks, v, vs, 0, i + 1, 0, 0), 0);
+    }
+    ASSERT_EQ(btree_builder_finish(t->builder, &t->tree), 0);
+    t->tree->config.arena_pool = t->pool;
+
+    const cache_config_t cc = {.capacity_bytes = NA_CACHE};
+    t->cache = cache_create(&cc);
+    ASSERT_TRUE(t->cache != NULL);
+    btree_set_node_cache(t->tree, t->cache, 0x5eed);
+}
+
+static void na_drop(na_table_t *t)
+{
+    btree_free(t->tree);
+    btree_builder_free(t->builder);
+    (void)block_manager_close(t->bm);
+    cache_destroy(t->cache);
+    arena_pool_destroy(t->pool);
+    (void)remove_directory(NA_DIR);
+}
+
+static void na_point_gets(btree_t *tree, uint64_t n, uint64_t step)
+{
+    uint8_t k[NA_KEY_MAX + 1];
+    for (uint64_t i = 0; i < n; i += step)
+    {
+        const size_t ks = na_key(k, i);
+        uint8_t *gv = NULL;
+        size_t gvs = 0;
+        uint64_t vlog = 0, seq = 0;
+        int64_t ttl = 0;
+        uint8_t del = 0;
+        ASSERT_EQ(btree_get(tree, k, ks, &gv, &gvs, &vlog, &seq, &ttl, &del), 0);
+        na_check_entry(k, ks, gv, gvs, i);
+        ASSERT_EQ(seq, i + 1);
+        ASSERT_EQ(del, 0);
+        free(gv);
+
+        /* a key just past this one is absent */
+        k[ks] = '!';
+        gv = NULL;
+        ASSERT_TRUE(btree_get(tree, k, ks + 1, &gv, &gvs, &vlog, &seq, &ttl, &del) != 0);
+        free(gv);
+    }
+}
+
+static void na_scan(btree_t *tree, uint64_t n, int backward)
+{
+    btree_cursor_t *c = NULL;
+    ASSERT_EQ(btree_cursor_init(&c, tree), 0);
+    ASSERT_EQ(backward ? btree_cursor_goto_last(c) : btree_cursor_goto_first(c), 0);
+    uint64_t seen = 0;
+    while (btree_cursor_valid(c))
+    {
+        uint8_t *k = NULL, *v = NULL;
+        size_t ks = 0, vs = 0;
+        uint64_t vlog = 0, seq = 0;
+        int64_t ttl = 0;
+        uint8_t del = 0;
+        ASSERT_EQ(btree_cursor_get(c, &k, &ks, &v, &vs, &vlog, &seq, &ttl, &del), 0);
+        const uint64_t i = backward ? n - 1 - seen : seen;
+        na_check_entry(k, ks, v, vs, i);
+        ASSERT_EQ(seq, i + 1);
+        seen++;
+        if ((backward ? btree_cursor_prev(c) : btree_cursor_next(c)) != 0) break;
+    }
+    ASSERT_EQ(seen, n);
+    ASSERT_EQ(btree_cursor_read_failed(c), 0);
+    btree_cursor_free(c);
+}
+
+/* the offsets of up to max leaves, first to last, read without the cache */
+static size_t na_leaf_offsets(const na_table_t *t, int64_t *out, size_t max)
+{
+    size_t got = 0;
+    int64_t off = t->tree->first_leaf_offset;
+    while (off >= 0 && got < max)
+    {
+        btree_node_t *node = NULL;
+        ASSERT_EQ(btree_node_read_with_codec(t->bm, off, &node, t->cfg.codec, t->cfg.codec_count,
+                                             t->pool, (uint32_t)t->cfg.target_node_size),
+                  0);
+        ASSERT_EQ(node->type, BTREE_NODE_LEAF);
+        out[got++] = off;
+        off = node->next_offset;
+        btree_node_free(node);
+    }
+    return got;
+}
+
+/* every allocation a node decode makes fits the exact block it sized: none spills, for point
+ * gets and both cursors over every codec and node size */
+static void test_exact_arena_holds_whole_node(void)
+{
+    for (int mi = 0; mi < g_mode_count; mi++)
+    {
+        for (size_t si = 0; si < NA_NODE_SIZE_COUNT; si++)
+        {
+            na_table_t t;
+            na_build(&t, &g_modes[mi], g_node_sizes[si], NA_KEYS);
+            const int64_t before = arena_exact_overflows();
+            na_point_gets(t.tree, NA_KEYS, 3);
+            na_scan(t.tree, NA_KEYS, 0);
+            na_scan(t.tree, NA_KEYS, 1);
+            ASSERT_EQ(arena_exact_overflows() - before, 0);
+            na_drop(&t);
+        }
+    }
+}
+
+/* a cached node's arena reserves what it allocated plus the block header and alignment: within
+ * 64 bytes, for leaves and for the root */
+static void test_reserved_near_allocated(void)
+{
+    int64_t offs[500];
+    for (int mi = 0; mi < g_mode_count; mi++)
+    {
+        for (size_t si = 0; si < NA_NODE_SIZE_COUNT; si++)
+        {
+            na_table_t t;
+            na_build(&t, &g_modes[mi], g_node_sizes[si], NA_KEYS);
+            const size_t n = na_leaf_offsets(&t, offs, 500);
+            ASSERT_TRUE(n >= 20);
+            size_t worst = 0;
+            for (size_t i = 0; i <= n; i++)
+            {
+                const int64_t off = i < n ? offs[i] : t.tree->root_offset;
+                btree_node_t *node = NULL;
+                cache_entry_t *pin = NULL;
+                ASSERT_EQ(btree_node_read_cached(t.tree, off, &node, &pin), 0);
+                ASSERT_TRUE(pin != NULL);
+                const size_t res = arena_bytes_reserved(node->arena);
+                const size_t alloc = arena_bytes_allocated(node->arena);
+                ASSERT_TRUE(res >= alloc);
+                if (res - alloc > worst) worst = res - alloc;
+                btree_node_done(node, pin);
+            }
+            printf("\n  %s %zu: worst reserved - allocated %zu over %zu leaves and the root",
+                   g_modes[mi].name, g_node_sizes[si], worst, n);
+            fflush(stdout);
+            ASSERT_TRUE(worst <= 64);
+            na_drop(&t);
+        }
+    }
+    printf("\n");
+}
+
+/* 4 KiB lz4 leaves: 2000 distinct leaves read into a 64 MiB cache are charged under 6 KiB each,
+ * where a pooled 8 KiB chunk per node charged over 8 KiB */
+static void test_cache_charges_under_six_kib_per_leaf(void)
+{
+    const na_mode_t *m = na_mode("lz4");
+    if (!m)
+    {
+        printf("  skipped: lz4 unavailable\n");
+        return;
+    }
+    enum
+    {
+        LEAVES = 2000
+    };
+    static int64_t offs[LEAVES];
+    na_table_t t;
+    na_build(&t, m, 4096, 3 * NA_KEYS / 2);
+    ASSERT_EQ(na_leaf_offsets(&t, offs, LEAVES), (size_t)LEAVES);
+    for (size_t i = 0; i < LEAVES; i++)
+    {
+        btree_node_t *node = NULL;
+        cache_entry_t *pin = NULL;
+        ASSERT_EQ(btree_node_read_cached(t.tree, offs[i], &node, &pin), 0);
+        btree_node_done(node, pin);
+    }
+    cache_stats_t st;
+    cache_get_stats(t.cache, &st);
+    ASSERT_EQ(st.entries, (uint64_t)LEAVES);
+    const uint64_t per_leaf = st.bytes_used / st.entries;
+    printf("\n  %" PRIu64 " bytes charged per cached 4 KiB lz4 leaf (%" PRIu64 " leaves)\n",
+           per_leaf, st.entries);
+    fflush(stdout);
+    ASSERT_TRUE(per_leaf < 6144);
+    na_drop(&t);
+}
