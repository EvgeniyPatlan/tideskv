+#ifdef NODE_ARENA_COUNT_ALLOCS
+/* 1000 cache-miss reads of compressed 4 KiB leaves allocate about once each: the node's arena,
+ * where the decompressed copy and a separate arena chunk each cost one more */
+static void test_decode_mallocs_per_miss(void)
+{
+    enum
+    {
+        READS = 1000
+    };
+    static int64_t offs[READS];
+    int ran = 0;
+    for (int mi = 0; mi < g_mode_count; mi++)
+    {
+        const na_mode_t *m = &g_modes[mi];
+        if (m->codec_count == 0) continue;
+        ran = 1;
+        na_table_t t;
+        na_build(&t, m, 4096, NA_KEYS);
+        ASSERT_EQ(na_leaf_offsets(&t, offs, READS), (size_t)READS);
+
+        btree_node_t *nodes[1];
+        g_allocs = 0;
+        g_counting = 1;
+        for (size_t i = 0; i < READS; i++)
+        {
+            nodes[0] = NULL;
+            const int rc =
+                btree_node_read_with_codec(t.bm, offs[i], &nodes[0], t.cfg.codec, t.cfg.codec_count,
+                                           t.pool, (uint32_t)t.cfg.target_node_size);
+            if (rc != 0) g_counting = 0;
+            ASSERT_EQ(rc, 0);
+            btree_node_free(nodes[0]);
+        }
+        g_counting = 0;
+        printf("\n  %s: %" PRIu64 " allocations for %d leaf reads\n", m->name, g_allocs, READS);
+        fflush(stdout);
+        ASSERT_TRUE(g_allocs <= 1100);
+        na_drop(&t);
+    }
+    if (!ran) printf("  skipped: no compression codec in this build\n");
+}
+#endif
