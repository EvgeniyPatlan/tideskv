+/**
+ * tidesdb_backpressure_bytes_throttle
+ * tighten a verdict for the queued immutables' bytes, which the count cannot show: at a large write
+ * buffer a count that leaves writers room through a merge is more memory than the host has
+ * @param pressure the snapshot, whose byte budget is 0 when the producer sets none
+ * @param decision the verdict so far, raised in place and never lowered
+ */
+static void tidesdb_backpressure_bytes_throttle(const tidesdb_l0_pressure_t *pressure,
+                                                tidesdb_backpressure_decision_t *decision)
+{
+    const size_t limit = pressure->queued_bytes_limit;
+    if (limit == 0 || decision->action == TDB_BACKPRESSURE_BLOCK) return;
+
+    if (pressure->queued_bytes >= limit)
+    {
+        decision->action = TDB_BACKPRESSURE_BLOCK;
+        decision->throttle_us = 0;
+        return;
+    }
+    const size_t high = limit / TDB_BACKPRESSURE_HIGHWATER_DEN * TDB_BACKPRESSURE_HIGHWATER_NUM +
+                        limit % TDB_BACKPRESSURE_HIGHWATER_DEN * TDB_BACKPRESSURE_HIGHWATER_NUM /
+                            TDB_BACKPRESSURE_HIGHWATER_DEN;
+    if (pressure->queued_bytes < high) return;
+
+    /* a step for the band's first write buffer and one more for each after it, the count band's
+     * slot measured in the bytes a slot holds */
+    const size_t over = pressure->queued_bytes - high;
+    const uint64_t steps = pressure->buffer_size > 0 ? over / pressure->buffer_size + 1 : 1;
+    const uint64_t dwell = steps * TDB_BACKPRESSURE_THROTTLE_STEP_US;
+    if (dwell > decision->throttle_us)
+    {
+        decision->action = TDB_BACKPRESSURE_THROTTLE;
+        decision->throttle_us = dwell;
+    }
