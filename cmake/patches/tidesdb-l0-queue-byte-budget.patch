+
+/* the byte budget beside the queue's count limit (memtable_l0_queue_max_bytes). the count bounds
+ * how many immutables may wait for flush, which at a large write buffer is a great deal of memory;
+ * the budget bounds what they hold. the policy blocks at the budget and throttles from three
+ * quarters of it, the L0 keeps the bytes of every queued immutable as it was sealed, and a writer
+ * outrunning a flush that has stopped waits at the budget rather than filling memory */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "../src/engine/engine.h"       /* tdb_test_flush_hold */
+#include "../src/engine/engine_types.h" /* db->l0 */
+#include "../src/memtable/backpressure.h"
+#include "../src/memtable/l0_internal.h"
+#include "../src/memtable/memtable.h"
+#include "db.h"
+#include "test_utils.h"
+
+static int tests_passed = 0;
+static int tests_failed = 0;
+
+static const char *qb_exe = NULL;
+
+#define QB_STEP_US 200 /* the policy's per-step dwell, TDB_BACKPRESSURE_THROTTLE_STEP_US */
+#define QB_LIMIT   (64u << 20)
+#define QB_BUFFER  (4u << 20)
+
+#define QB_DB_DIR     "." PATH_SEPARATOR "test_l0_queue_bytes_db"
+#define QB_CF         "cf0"
+#define QB_CHILD_FLAG "--l0-queue-bytes-child"
+#define QB_PHASE_FILL "fill"
+
+#define QB_VALUE_SIZE 256
+#define QB_PER_TXN    100
+/* waits a test makes on a background effect, in 10 ms polls */
+#define QB_POLL_US    10000
+#define QB_POLL_LIMIT 3000
+
+/* the policy alone: a snapshot with the count well under its band and the bytes where the case puts
+ * them */
+static tidesdb_l0_pressure_t qb_bytes_at(const size_t bytes, const size_t limit)
+{
+    tidesdb_l0_pressure_t p = {.queue_depth = 2,
+                               .queue_limit = 64,
+                               .buffer_size = QB_BUFFER,
+                               .queued_bytes = bytes,
+                               .queued_bytes_limit = limit};
+    return p;
+}
+
+/* at the budget a writer waits, however few immutables hold it */
+void test_byte_limit_blocks_at_limit(void)
+{
+    tidesdb_l0_pressure_t p = qb_bytes_at(QB_LIMIT, QB_LIMIT);
+    tidesdb_backpressure_decision_t d = tidesdb_backpressure_default_policy(&p, NULL);
+    ASSERT_EQ(d.action, TDB_BACKPRESSURE_BLOCK);
+    p = qb_bytes_at(QB_LIMIT + 1, QB_LIMIT);
+    d = tidesdb_backpressure_default_policy(&p, NULL);
+    ASSERT_EQ(d.action, TDB_BACKPRESSURE_BLOCK);
+}
+
+/* from three quarters of the budget a writer dwells one step, and one more for each write buffer
+ * the queue holds past that mark */
+void test_byte_limit_throttles_from_three_quarters(void)
+{
+    const size_t high = (size_t)QB_LIMIT * 3 / 4;
+    tidesdb_l0_pressure_t p = qb_bytes_at(high, QB_LIMIT);
+    tidesdb_backpressure_decision_t d = tidesdb_backpressure_default_policy(&p, NULL);
+    ASSERT_EQ(d.action, TDB_BACKPRESSURE_THROTTLE);
+    ASSERT_EQ(d.throttle_us, (uint64_t)QB_STEP_US);
+
+    p = qb_bytes_at(high + 2 * (size_t)QB_BUFFER, QB_LIMIT);
+    d = tidesdb_backpressure_default_policy(&p, NULL);
+    ASSERT_EQ(d.action, TDB_BACKPRESSURE_THROTTLE);
+    ASSERT_EQ(d.throttle_us, (uint64_t)(3 * QB_STEP_US));
+
+    p = qb_bytes_at(high - 1, QB_LIMIT);
+    d = tidesdb_backpressure_default_policy(&p, NULL);
+    ASSERT_EQ(d.action, TDB_BACKPRESSURE_ADMIT);
+    ASSERT_EQ(d.throttle_us, (uint64_t)0);
+}
+
+/* a count-band dwell larger than the bytes band's is kept, never traded down */
+void test_byte_band_never_lowers_a_larger_dwell(void)
+{
+    const size_t high = (size_t)QB_LIMIT * 3 / 4;
+    tidesdb_l0_pressure_t p = qb_bytes_at(high, QB_LIMIT);
+    p.queue_depth = 60; /* (60 - 48 + 1) steps from the count band */
+    const tidesdb_backpressure_decision_t d = tidesdb_backpressure_default_policy(&p, NULL);
+    ASSERT_EQ(d.action, TDB_BACKPRESSURE_THROTTLE);
+    ASSERT_EQ(d.throttle_us, (uint64_t)(13 * QB_STEP_US));
+}
+
+/* a budget of zero leaves the count band deciding exactly as it did before the budget existed:
+ * admit below 3/4 of the count, a step per slot from there, block at the count */
+void test_zero_byte_limit_is_count_only(void)
+{
+    const struct
+    {
+        int depth;
+        tidesdb_backpressure_action_t action;
+        uint64_t dwell;
+    } cases[] = {{0, TDB_BACKPRESSURE_ADMIT, 0},
+                 {47, TDB_BACKPRESSURE_ADMIT, 0},
+                 {48, TDB_BACKPRESSURE_THROTTLE, QB_STEP_US},
+                 {63, TDB_BACKPRESSURE_THROTTLE, 16 * QB_STEP_US},
+                 {64, TDB_BACKPRESSURE_BLOCK, 0}};
+    for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); i++)
+    {
+        /* whatever the bytes read, a zero budget does not weigh them */
+        tidesdb_l0_pressure_t p = qb_bytes_at((size_t)1 << 40, 0);
+        p.queue_depth = cases[i].depth;
+        const tidesdb_backpressure_decision_t d = tidesdb_backpressure_default_policy(&p, NULL);
+        ASSERT_EQ(d.action, cases[i].action);
+        ASSERT_EQ(d.throttle_us, cases[i].dwell);
+    }
+}
+
+/* the flush tier's band stays on runs: a budget the bytes are under changes nothing about it */
+void test_tier_band_ignores_byte_limit(void)
+{
+    tidesdb_l0_pressure_t p = qb_bytes_at((size_t)QB_LIMIT / 2, QB_LIMIT);
+    p.tier_depth = 40;
+    p.tier_slow = 32;
+    p.tier_stall = 64;
+    const tidesdb_backpressure_decision_t d = tidesdb_backpressure_default_policy(&p, NULL);
+    ASSERT_EQ(d.action, TDB_BACKPRESSURE_THROTTLE);
+    ASSERT_EQ(d.throttle_us, (uint64_t)(9 * QB_STEP_US));
+}
+
+/* the bytes band holds with the count unbounded too, since the two bound different things */
+void test_byte_limit_applies_with_unbounded_count(void)
+{
+    tidesdb_l0_pressure_t p = qb_bytes_at(QB_LIMIT, QB_LIMIT);
+    p.queue_limit = 0;
+    const tidesdb_backpressure_decision_t d = tidesdb_backpressure_default_policy(&p, NULL);
+    ASSERT_EQ(d.action, TDB_BACKPRESSURE_BLOCK);
+}
+
+/* an in-memory memtable holding about a mebibyte of entries */
+static void qb_fill_active(tidesdb_l0_t *l0, const uint64_t seq_base)
+{
+    char value[QB_VALUE_SIZE];
+    memset(value, 'v', sizeof(value));
+    for (int i = 0; i < 3000; i++)
+    {
+        char key[32];
+        snprintf(key, sizeof(key), "k%08llu", (unsigned long long)(seq_base + (uint64_t)i));
+        ASSERT_EQ(tidesdb_l0_put(l0, 0, (const uint8_t *)key, strlen(key), (const uint8_t *)value,
+                                 sizeof(value), -1, seq_base + (uint64_t)i + 1, 0),
+                  TDB_SUCCESS);
+    }
+}
+
+static tidesdb_memtable_t *qb_fresh_mt(const uint64_t id)
+{
+    return tidesdb_memtable_create(NULL, id, id, 12, 0.25f, NULL, NULL);
+}
+
+/* every immutable's bytes are counted from its rotation until it leaves the queue -- by a flush
+ * that retires it, or by the drain a close makes -- and only then */
+void test_queued_bytes_track_rotate_and_retire(void)
+{
+    tidesdb_l0_t *l0 = tidesdb_l0_create(QB_BUFFER, 64, 12, 0.25f, NULL, NULL);
+    ASSERT_TRUE(l0 != NULL);
+    ASSERT_TRUE(tidesdb_l0_set_active(l0, qb_fresh_mt(0)) == NULL);
+    ASSERT_EQ(tidesdb_l0_queued_bytes(l0), (size_t)0);
+
+    size_t recorded[3];
+    for (int r = 0; r < 3; r++)
+    {
+        tidesdb_memtable_t *sealing = atomic_load(&l0->active);
+        qb_fill_active(l0, (uint64_t)r * 10000);
+        const size_t held = tidesdb_l0_active_bytes(l0);
+        ASSERT_TRUE(held >= (size_t)(1u << 20));
+        ASSERT_EQ(tidesdb_l0_rotate(l0, qb_fresh_mt((uint64_t)r + 1)), TDB_SUCCESS);
+        recorded[r] = sealing->queued_bytes;
+        ASSERT_EQ(recorded[r], held);
+    }
+    ASSERT_EQ(tidesdb_l0_queued_bytes(l0), recorded[0] + recorded[1] + recorded[2]);
+
+    /* a flush claims and retires the two oldest */
+    for (int r = 0; r < 2; r++)
+    {
+        tidesdb_memtable_t *imm = tidesdb_l0_claim_immutable(l0);
+        ASSERT_TRUE(imm != NULL);
+        tidesdb_l0_retire_immutable(l0, imm);
+    }
+    ASSERT_EQ(tidesdb_l0_queued_bytes(l0), recorded[2]);
+
+    /* a claim that fails to install releases without leaving the queue, so its bytes stay */
+    tidesdb_memtable_t *imm = tidesdb_l0_claim_immutable(l0);
+    ASSERT_TRUE(imm != NULL);
+    tidesdb_l0_release_immutable(l0, imm);
+    ASSERT_EQ(tidesdb_l0_queued_bytes(l0), recorded[2]);
+
+    /* the close drain dequeues; the flush it then runs retires the dequeued memtable, which must
+     * not take its bytes a second time */
+    imm = tidesdb_l0_dequeue_immutable(l0);
+    ASSERT_TRUE(imm != NULL);
+    ASSERT_EQ(tidesdb_l0_queued_bytes(l0), (size_t)0);
+    atomic_fetch_add(&l0->flushes_in_flight, 1); /* as a claim would have */
+    tidesdb_l0_retire_immutable(l0, imm);
+    ASSERT_EQ(tidesdb_l0_queued_bytes(l0), (size_t)0);
+    ASSERT_TRUE(tidesdb_l0_dequeue_immutable(l0) == NULL);
+
+    tidesdb_l0_destroy(l0);
+}
+
+/* the budget is set on the L0 the engine opens, and reported */
+void test_budget_reaches_the_l0(void)
+{
+    tidesdb_l0_t *l0 = tidesdb_l0_create(QB_BUFFER, 64, 12, 0.25f, NULL, NULL);
+    ASSERT_TRUE(l0 != NULL);
+    ASSERT_EQ(l0->queue_max_bytes, (size_t)0);
+    tidesdb_l0_set_queue_max_bytes(l0, 12u << 20);
+    ASSERT_EQ(l0->queue_max_bytes, (size_t)(12u << 20));
+    tidesdb_l0_destroy(l0);
+    ASSERT_EQ(tidesdb_default_config().memtable_l0_queue_max_bytes, (size_t)0);
+}
+
+static tidesdb_config_t qb_config(void)
+{
+    tidesdb_config_t cfg = tidesdb_default_config();
+    cfg.db_path = QB_DB_DIR;
+    cfg.memtable_sync_mode = TDB_SYNC_NONE;
+    cfg.memtable_write_buffer_size = QB_BUFFER;
+    cfg.memtable_l0_queue_stall_threshold = 64;
+    cfg.memtable_idle_flush_seconds = 0;
+    cfg.num_flush_threads = 2;
+    return cfg;
+}
+
+static void qb_wait_drained(tidesdb_t *db)
+{
+    for (int i = 0; i < QB_POLL_LIMIT && tidesdb_l0_queue_depth(db->l0) > 0; i++)
+        usleep(QB_POLL_US);
+    ASSERT_EQ(tidesdb_l0_queue_depth(db->l0), (size_t)0);
+}
+
+typedef struct
+{
+    tidesdb_t *db;
+    tidesdb_column_family_t *cf;
+    int from;
+    int to;
+    _Atomic(int) done;
+} qb_writer_t;
+
+/* commit keys [from, to) QB_PER_TXN a transaction */
+static void qb_fill(tidesdb_t *db, tidesdb_column_family_t *cf, const int from, const int to)
+{
+    char value[QB_VALUE_SIZE];
+    memset(value, 'v', sizeof(value));
+    for (int i = from; i < to;)
+    {
+        tidesdb_txn_t *txn = NULL;
+        ASSERT_EQ(tidesdb_txn_begin(db, &txn), TDB_SUCCESS);
+        for (int j = 0; j < QB_PER_TXN && i < to; j++, i++)
+        {
+            char key[32];
+            snprintf(key, sizeof(key), "k%08d", i);
+            ASSERT_EQ(tidesdb_txn_put(txn, cf, (const uint8_t *)key, strlen(key),
+                                      (const uint8_t *)value, sizeof(value), -1),
+                      TDB_SUCCESS);
+        }
+        ASSERT_EQ(tidesdb_txn_commit(txn), TDB_SUCCESS);
+        tidesdb_txn_free(txn);
+    }
+}
+
+static void *qb_writer_main(void *arg)
+{
+    qb_writer_t *w = (qb_writer_t *)arg;
+    qb_fill(w->db, w->cf, w->from, w->to);
+    atomic_store(&w->done, 1);
+    return NULL;
+}
+
+static tidesdb_t *qb_open(const tidesdb_config_t *cfg, const int create_cf,
+                          tidesdb_column_family_t **cf)
+{
+    tidesdb_t *db = NULL;
+    ASSERT_EQ(tidesdb_open(cfg, &db), TDB_SUCCESS);
+    if (create_cf)
+    {
+        tidesdb_column_family_config_t cc = tidesdb_default_column_family_config();
+        ASSERT_EQ(tidesdb_create_column_family(db, QB_CF, &cc), TDB_SUCCESS);
+    }
+    *cf = tidesdb_get_column_family(db, QB_CF);
+    ASSERT_TRUE(*cf != NULL);
+    return db;
+}
+
+/* with flush stopped, a writer fills the queue up to the budget and waits there instead of going on
+ * to the count limit; once flush resumes the queue drains, the writer finishes, and the bytes
+ * return to zero */
+void test_writes_wait_at_byte_budget(void)
+{
+    (void)remove_directory(QB_DB_DIR);
+    tidesdb_config_t cfg = qb_config();
+    cfg.memtable_l0_queue_max_bytes = 12u << 20;
+    tidesdb_column_family_t *cf = NULL;
+    tidesdb_t *db = qb_open(&cfg, 1, &cf);
+
+    atomic_store(&tdb_test_flush_hold, 1);
+    /* about 40 MiB of entries: ten write buffers, far past the 12 MiB the queue may hold */
+    qb_writer_t w = {.db = db, .cf = cf, .from = 0, .to = 60000};
+    atomic_init(&w.done, 0);
+    pthread_t th;
+    ASSERT_EQ(pthread_create(&th, NULL, qb_writer_main, &w), 0);
+
+    tidesdb_db_stats_t st;
+    memset(&st, 0, sizeof(st));
+    for (int i = 0; i < QB_POLL_LIMIT; i++)
+    {
+        ASSERT_EQ(tidesdb_get_db_stats(db, &st), TDB_SUCCESS);
+        if (st.writes_blocked > 0) break;
+        usleep(QB_POLL_US);
+    }
+    printf("(blocked %llu, queued %zu bytes in %d memtables) ",
+           (unsigned long long)st.writes_blocked, st.immutable_memtable_bytes,
+           st.immutable_memtable_count);
+    fflush(stdout);
+    ASSERT_TRUE(st.writes_blocked > 0);
+    ASSERT_TRUE(st.immutable_memtable_bytes >= (size_t)(12u << 20));
+    ASSERT_TRUE(st.immutable_memtable_bytes <= (size_t)(16u << 20));
+    ASSERT_EQ(atomic_load(&w.done), 0);
+
+    atomic_store(&tdb_test_flush_hold, 0);
+    ASSERT_EQ(pthread_join(th, NULL), 0);
+    ASSERT_EQ(atomic_load(&w.done), 1);
+    ASSERT_EQ(tidesdb_flush_memtable(db), TDB_SUCCESS);
+    qb_wait_drained(db);
+    ASSERT_EQ(tidesdb_get_db_stats(db, &st), TDB_SUCCESS);
+    ASSERT_EQ(st.immutable_memtable_bytes, (size_t)0);
+
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(QB_DB_DIR);
+}
+
+/* the child of the recovery case: rotate several memtables with flush stopped and die without a
+ * close, so every one of them comes back from its log on the next open */
+static void qb_child_fill(void)
+{
+    atomic_store(&tdb_test_flush_hold, 1);
+    const tidesdb_config_t cfg = qb_config();
+    tidesdb_t *db = NULL;
+    if (tidesdb_open(&cfg, &db) != TDB_SUCCESS) _exit(1);
+    tidesdb_column_family_config_t cc = tidesdb_default_column_family_config();
+    if (tidesdb_create_column_family(db, QB_CF, &cc) != TDB_SUCCESS) _exit(1);
+    tidesdb_column_family_t *cf = tidesdb_get_column_family(db, QB_CF);
+    if (!cf) _exit(1);
+    qb_fill(db, cf, 0, 30000);
+    if (tidesdb_l0_queue_depth(db->l0) < 2) _exit(3);
+    _exit(0);
+}
+
+/* the generations a reopen replays are queued through the same rotation a live write takes, so
+ * their bytes are counted, and the flush that retires them takes them back to zero rather than
+ * below */
+void test_recovered_generations_are_counted(void)
+{
+    (void)remove_directory(QB_DB_DIR);
+    int exit_code = -1;
+    ASSERT_EQ(test_spawn_self(qb_exe, QB_CHILD_FLAG, QB_PHASE_FILL, "0", &exit_code), 0);
+    ASSERT_EQ(exit_code, 0);
+
+    atomic_store(&tdb_test_flush_hold, 1);
+    const tidesdb_config_t cfg = qb_config();
+    tidesdb_column_family_t *cf = NULL;
+    tidesdb_t *db = qb_open(&cfg, 0, &cf);
+
+    tidesdb_memtable_t *pinned[64];
+    int n = 0;
+    ASSERT_EQ(tidesdb_l0_pin_memtables(db->l0, pinned, 64, &n), TDB_SUCCESS);
+    size_t sum = 0;
+    for (int i = 1; i < n; i++) sum += pinned[i]->queued_bytes; /* pinned[0] is the active */
+    tidesdb_l0_unpin_memtables(pinned, n);
+    const size_t queued = tidesdb_l0_queued_bytes(db->l0);
+    printf("(%zu recovered generations, %zu bytes) ", tidesdb_l0_queue_depth(db->l0), queued);
+    fflush(stdout);
+    ASSERT_TRUE(tidesdb_l0_queue_depth(db->l0) >= 2);
+    ASSERT_TRUE(queued > (size_t)(4u << 20));
+    ASSERT_EQ(queued, sum);
+
+    atomic_store(&tdb_test_flush_hold, 0);
+    qb_wait_drained(db);
+    ASSERT_EQ(tidesdb_l0_queued_bytes(db->l0), (size_t)0);
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(QB_DB_DIR);
+}
+
+int main(int argc, char **argv)
+{
+    qb_exe = argv[0];
+    if (argc >= 3 && strcmp(argv[1], QB_CHILD_FLAG) == 0)
+    {
+        if (strcmp(argv[2], QB_PHASE_FILL) == 0) qb_child_fill();
+        return 2;
+    }
+    INIT_TEST_FILTER(argc, argv);
+    RUN_TEST(test_byte_limit_blocks_at_limit, tests_passed);
+    RUN_TEST(test_byte_limit_throttles_from_three_quarters, tests_passed);
+    RUN_TEST(test_byte_band_never_lowers_a_larger_dwell, tests_passed);
+    RUN_TEST(test_zero_byte_limit_is_count_only, tests_passed);
+    RUN_TEST(test_tier_band_ignores_byte_limit, tests_passed);
+    RUN_TEST(test_byte_limit_applies_with_unbounded_count, tests_passed);
+    RUN_TEST(test_queued_bytes_track_rotate_and_retire, tests_passed);
+    RUN_TEST(test_budget_reaches_the_l0, tests_passed);
+    RUN_TEST(test_writes_wait_at_byte_budget, tests_passed);
+    RUN_TEST(test_recovered_generations_are_counted, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
