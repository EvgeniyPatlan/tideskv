@@ -698,12 +723,13 @@ int tidesdb_l0_seq_aborted(const tidesdb_l0_t *l0, uint64_t seq);
 /**
  * tidesdb_l0_admit_write
  * pace one writer against current L0 fill before its write is made durable -- snapshot the
- * pressure, ask the backpressure policy, and dwell or wait out a full queue as it decides. an
- * unbounded queue limit admits immediately, so the whole mechanism is opt-in through configuration.
- * a writer that waits out the ceiling without the queue draining is admitted anyway, so a wedged
- * flush degrades ingestion instead of hanging it. an empty immutable queue also admits without
- * consulting the policy, since this paces against the unflushed backlog and there is none -- a
- * policy pacing on active memtable fill alone is therefore not driven from here
+ * pressure, ask the backpressure policy, and dwell or wait out a full queue as it decides. a queue
+ * with neither a count limit nor a byte budget is not paced on its backlog, so that pacing is
+ * opt-in through configuration. a writer that waits out the ceiling without the queue draining is
+ * admitted anyway, so a wedged flush degrades ingestion instead of hanging it. an empty immutable
+ * queue also admits without consulting the policy, since this paces against the unflushed backlog
+ * and there is none -- a policy pacing on active memtable fill alone is therefore not driven from
+ * here
  * @param l0 the subsystem
  * @return TDB_SUCCESS once the writer may proceed, or TDB_ERR_INVALID_ARGS if l0 is NULL
  */
diff --git a/test/l0_queue_bytes__tests.c b/test/l0_queue_bytes__tests.c
new file mode 100644
index 0000000..7251395
--- /dev/null
+++ b/test/l0_queue_bytes__tests.c
@@ -0,0 +1,430 @@
+/**
