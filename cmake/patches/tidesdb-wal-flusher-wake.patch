+
+/* the buffered WAL's flush thread under each sync mode. outside sync-full a commit does not wait
+ * for its record to reach the file, so the flush thread lets staged records gather for a short
+ * window (or until the ring is half full) instead of being woken by every append; a committer that
+ * does wait (sync-interval, an fsync barrier, ring backpressure) asks for the flush itself. the
+ * signal count and the synced extent are observed by interposing libc in this binary
+ * (pthread_cond_signal, pwrite, fdatasync), so those checks run only on Linux without a sanitizer,
+ * whose runtime owns those symbols; elsewhere they pass without checking, saying so */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <dirent.h>
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "../src/base/waitstat.h"
+#include "../src/io/block_manager.h"
+#include "../src/io/block_manager_internal.h" /* BM_FLUSH_GATHERING, BM_BUF_GATHER_* */
+#include "db.h"
+#include "test_utils.h"
+
+static int tests_passed = 0;
+static int tests_failed = 0;
+
+#define WF_FILE    "test_wal_flusher.log"
+#define WF_DB_DIR  "." PATH_SEPARATOR "test_wal_flusher_db"
+#define WF_RING    (1024u * 1024u)
+#define WF_APPENDS 10000
+/* between appends, about a client round trip, so each lands on a parked flusher */
+#define WF_GAP_US 20
+
+#if defined(__linux__) && defined(WAL_FLUSHER_INTERPOSE)
+#include <sys/syscall.h>
+
+static pthread_cond_t *_Atomic g_watch_cv = NULL;
+static _Atomic uint64_t g_signals = 0;
+static int (*g_real_signal)(pthread_cond_t *) = NULL;
+
+static _Atomic int g_watch_fd = -1;
+static _Atomic uint64_t g_written_end = 0; /* furthest byte pwritten to the watched fd */
+static _Atomic uint64_t g_synced_end = 0;  /* furthest byte a completed fdatasync covered */
+static _Atomic int g_watch_wal_syncs = 0;
+static _Atomic uint64_t g_wal_sync_count = 0;
+static _Atomic uint64_t g_wal_sync_last_us = 0;
+
+static void wf_raise(_Atomic uint64_t *at, const uint64_t v)
+{
+    uint64_t cur = atomic_load(at);
+    while (cur < v && !atomic_compare_exchange_weak(at, &cur, v));
+}
+
+int pthread_cond_signal(pthread_cond_t *c)
+{
+    if (c == atomic_load(&g_watch_cv)) atomic_fetch_add(&g_signals, 1);
+    return g_real_signal(c);
+}
+
+ssize_t pwrite(int fd, const void *buf, size_t n, off_t off)
+{
+    const ssize_t w = (ssize_t)syscall(SYS_pwrite64, fd, buf, n, off);
+    if (w > 0 && fd == atomic_load(&g_watch_fd))
+    {
+        wf_raise(&g_written_end, (uint64_t)off + (uint64_t)w);
+        /* a descriptor opened O_DSYNC is synced by the write itself, and sync-full skips the
+         * fdatasync on one */
+        if (fcntl(fd, F_GETFL) & O_DSYNC) wf_raise(&g_synced_end, (uint64_t)off + (uint64_t)w);
+    }
+    return w;
+}
+
+/* whether fd is a write-ahead log, by the name it was opened under */
+static int wf_fd_is_wal(const int fd)
+{
+    char link[64], target[512];
+    snprintf(link, sizeof(link), "/proc/self/fd/%d", fd);
+    const ssize_t n = readlink(link, target, sizeof(target) - 1);
+    if (n < 4) return 0;
+    target[n] = '\0';
+    return strcmp(target + n - 4, ".log") == 0;
+}
+
+int fdatasync(int fd)
+{
+    /* read before the sync: every byte written before it started is covered once it returns */
+    const uint64_t written = atomic_load(&g_written_end);
+    const int rc = (int)syscall(SYS_fdatasync, fd);
+    if (rc == 0 && fd == atomic_load(&g_watch_fd)) wf_raise(&g_synced_end, written);
+    if (rc == 0 && atomic_load(&g_watch_wal_syncs) && wf_fd_is_wal(fd))
+    {
+        atomic_store(&g_wal_sync_last_us, tdb_monotonic_us());
+        atomic_fetch_add(&g_wal_sync_count, 1);
+    }
+    return rc;
+}
+
+static void wf_interpose_init(void)
+{
+    g_real_signal = (int (*)(pthread_cond_t *))dlsym(RTLD_NEXT, "pthread_cond_signal");
+    ASSERT_TRUE(g_real_signal != NULL);
+}
