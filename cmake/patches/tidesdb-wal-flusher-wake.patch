+static void wf_spin_us(const uint64_t us)
+{
+    const uint64_t until = tdb_monotonic_us() + us;
+    while (tdb_monotonic_us() < until);
+}
+
+static block_manager_t *wf_open(const int sync_mode)
+{
+    (void)remove(WF_FILE);
+    block_manager_t *bm = NULL;
+    ASSERT_EQ(block_manager_open_buffered(&bm, WF_FILE, sync_mode, WF_RING), 0);
+    ASSERT_EQ(bm->buffered, 1);
+    return bm;
+}
+
+static uint64_t wf_flushed(block_manager_t *bm)
+{
+    uint64_t size = 0;
+    ASSERT_EQ(block_manager_get_size(bm, &size), 0);
+    return size;
+}
+
+/* reopen the file and count the records a reader sees, checking each one's payload */
+static int wf_count_records(const uint32_t payload)
+{
+    block_manager_t *bm = NULL;
+    ASSERT_EQ(block_manager_open(&bm, WF_FILE, BLOCK_MANAGER_SYNC_NONE), 0);
+    block_manager_cursor_t cursor;
+    ASSERT_EQ(block_manager_cursor_init_stack(&cursor, bm), 0);
+    int n = 0;
+    block_manager_block_t *block;
+    while ((block = block_manager_cursor_read_and_advance(&cursor)) != NULL)
+    {
+        ASSERT_EQ(block->size, payload);
+        ASSERT_EQ(((const unsigned char *)block->data)[0], (unsigned char)(n & 0xff));
+        block_manager_block_free(block);
+        n++;
+    }
+    ASSERT_EQ(block_manager_close(bm), 0);
+    return n;
+}
+
+/* sync-none acknowledges a commit once its record is staged, so nothing waits on the flush thread
+ * and waking it per append is pure cost: 10k appends spaced like commits from a client (each one
+ * finding the flush thread parked, which a tight loop would not) cost at most one signal per 64 of
+ * them, and every record still reaches the file */
+static void test_no_wake_per_append_in_sync_none(void)
+{
+    if (!WF_OBSERVABLE)
+    {
+        printf("(signals not observable in this build, skipped) ");
+        return;
+    }
+#if WF_OBSERVABLE
+    block_manager_t *bm = wf_open(BLOCK_MANAGER_SYNC_NONE);
+    unsigned char payload[16];
+    memset(payload, 0, sizeof(payload));
+    atomic_store(&g_signals, 0);
+    atomic_store(&g_watch_cv, &bm->buf_work_cv);
+    for (int i = 0; i < WF_APPENDS; i++)
+    {
+        payload[0] = (unsigned char)(i & 0xff);
+        ASSERT_TRUE(block_manager_write_raw(bm, payload, sizeof(payload)) >= 0);
+        wf_spin_us(WF_GAP_US);
+    }
+    const uint64_t signals = atomic_load(&g_signals);
+    atomic_store(&g_watch_cv, NULL);
+    printf("(%llu signals for %d appends) ", (unsigned long long)signals, WF_APPENDS);
+    ASSERT_TRUE(signals <= WF_APPENDS / 64);
+    ASSERT_EQ(block_manager_close(bm), 0);
+    ASSERT_EQ(wf_count_records(sizeof(payload)), WF_APPENDS);
+    (void)remove(WF_FILE);
+#endif
+}
+
+/* the durable appends of one sync-full handle: each returns only once its bytes are synced */
+static void wf_full_appends(block_manager_t *bm)
+{
+#if WF_OBSERVABLE
+    atomic_store(&g_written_end, 0);
+    atomic_store(&g_synced_end, 0);
+    atomic_store(&g_watch_fd, bm->fd);
+#endif
+    unsigned char payload[64];
+    memset(payload, 0, sizeof(payload));
+    for (int i = 0; i < 200; i++)
+    {
+        payload[0] = (unsigned char)(i & 0xff);
+        block_manager_block_t block = {.size = sizeof(payload), .data = payload, .inline_data = 0};
+        const int64_t off = block_manager_block_write_durable(bm, &block);
+        ASSERT_TRUE(off >= 0);
+        const uint64_t end = (uint64_t)off + block_manager_framed_size(sizeof(payload));
+        ASSERT_TRUE(wf_flushed(bm) >= end);
+#if WF_OBSERVABLE
+        ASSERT_TRUE(atomic_load(&g_synced_end) >= end);
+#endif
+    }
+#if WF_OBSERVABLE
+    atomic_store(&g_watch_fd, -1);
+#endif
+}
+
+/* sync-full: an append that waits returns only once a completed sync covers its bytes -- the
+ * O_DSYNC write of a handle opened sync-full, or the fdatasync of one switched to it at runtime --
+ * and the flush thread's sync failing fails the wait rather than reporting it durable */
+static void test_full_mode_still_durable(void)
+{
+    block_manager_t *bm = wf_open(BLOCK_MANAGER_SYNC_FULL);
+    wf_full_appends(bm);
+    ASSERT_EQ(block_manager_close(bm), 0);
+
+    bm = wf_open(BLOCK_MANAGER_SYNC_NONE);
+    block_manager_set_sync_mode(bm, BLOCK_MANAGER_SYNC_FULL);
+    wf_full_appends(bm);
+
+    /* the existing durability assertion (block_manager__tests.c, runtime_full_syncs_buffered):
+     * fdatasync on /dev/null fails with EINVAL, so a wait that returned without syncing would pass
+     */
+    const int null_fd = open("/dev/null", O_RDWR);
+    ASSERT_TRUE(null_fd >= 0);
+    ASSERT_TRUE(dup2(null_fd, bm->fd) >= 0);
+    close(null_fd);
+    const char payload[] = "full-mode-still-durable";
+    const int64_t off = block_manager_write_raw(bm, payload, sizeof(payload));
+    ASSERT_TRUE(off >= 0);
+    ASSERT_EQ(
+        block_manager_wait_durable(bm, (uint64_t)off + block_manager_framed_size(sizeof(payload))),
+        -1);
+    ASSERT_EQ(block_manager_last_errno(bm), EINVAL);
+    ASSERT_EQ(block_manager_close(bm), 0);
+    (void)remove(WF_FILE);
+}
+
+/* poll for cond for up to limit_us, returning how long it took or UINT64_MAX on timing out */
+#define WF_POLL(cond, limit_us)                                   \
+    ({                                                            \
+        const uint64_t wf_from = tdb_monotonic_us();              \
+        uint64_t wf_took = UINT64_MAX;                            \
+        for (;;)                                                  \
+        {                                                         \
+            if (cond)                                             \
+            {                                                     \
+                wf_took = tdb_monotonic_us() - wf_from;           \
+                break;                                            \
+            }                                                     \
+            if (tdb_monotonic_us() - wf_from > (limit_us)) break; \
+            usleep(100);                                          \
+        }                                                         \
+        wf_took;                                                  \
+    })
+
+#define WF_LONG_GATHER_US 10000000u /* ten seconds: anything that drains sooner was woken */
+#define WF_BIG_PAYLOAD    (64u * 1024u)
+
+/* a sync-none handle whose flush thread gathers for ten seconds, with one record already drained so
+ * the thread sits in its gathering park; returns the flushed frontier */
+static block_manager_t *wf_open_gathering(uint64_t *flushed)
+{
+    block_manager_t *bm = wf_open(BLOCK_MANAGER_SYNC_NONE);
+    atomic_store(&bm->flush_gather_us, WF_LONG_GATHER_US);
+    const unsigned char first[16] = {0};
+    const int64_t off = block_manager_write_raw(bm, first, sizeof(first));
+    ASSERT_TRUE(off >= 0);
+    const uint64_t end = (uint64_t)off + block_manager_framed_size(sizeof(first));
+    /* the first record after a quiet spell wakes the thread, which drains it and then gathers */
+    ASSERT_TRUE(WF_POLL(wf_flushed(bm) >= end, 2000000) != UINT64_MAX);
+    ASSERT_TRUE(WF_POLL(atomic_load(&bm->flush_sleeping) == BM_FLUSH_GATHERING, 2000000) !=
+                UINT64_MAX);
+    *flushed = end;
+    return bm;
+}
+
+/* filling the ring past half drains it at once, long before the gathering window ends; below half
+ * the records wait for the window, which also shows no append below the watermark woke the thread
+ */
+static void test_watermark_drains(void)
+{
+    uint64_t fl = 0;
+    block_manager_t *bm = wf_open_gathering(&fl);
+    unsigned char *payload = calloc(1, WF_BIG_PAYLOAD);
+    ASSERT_TRUE(payload != NULL);
+    const uint64_t framed = block_manager_framed_size(WF_BIG_PAYLOAD);
+    const int below = (int)((WF_RING / BM_BUF_GATHER_WATERMARK_DIV) / framed) - 1;
+    uint64_t end = fl;
+    for (int i = 0; i < below; i++)
+    {
+        const int64_t off = block_manager_write_raw(bm, payload, WF_BIG_PAYLOAD);
+        ASSERT_TRUE(off >= 0);
+        end = (uint64_t)off + framed;
+    }
+    ASSERT_TRUE(end - fl < WF_RING / BM_BUF_GATHER_WATERMARK_DIV);
+    usleep(20000);
+    ASSERT_EQ(wf_flushed(bm), fl);
+
+    /* two more cross the watermark */
+    for (int i = 0; i < 2; i++)
+    {
+        const int64_t off = block_manager_write_raw(bm, payload, WF_BIG_PAYLOAD);
+        ASSERT_TRUE(off >= 0);
+        end = (uint64_t)off + framed;
+    }
+    ASSERT_TRUE(end - fl >= WF_RING / BM_BUF_GATHER_WATERMARK_DIV);
+    const uint64_t took = WF_POLL(wf_flushed(bm) >= end, 2000000);
+    printf("(drained %llu bytes %llu us after the watermark) ", (unsigned long long)(end - fl),
+           (unsigned long long)took);
+    ASSERT_TRUE(took != UINT64_MAX);
+    free(payload);
+    ASSERT_EQ(block_manager_close(bm), 0);
+    (void)remove(WF_FILE);
+}
+
+/* the newest record in the database's logs holds key, by scanning every log file under dir */
+static int wf_logs_hold(const char *dir, const char *key)
+{
+    DIR *d = opendir(dir);
+    ASSERT_TRUE(d != NULL);
+    int found = 0;
+    struct dirent *ent;
+    while (!found && (ent = readdir(d)) != NULL)
+    {
+        const size_t n = strlen(ent->d_name);
+        if (n < 4 || strcmp(ent->d_name + n - 4, ".log") != 0) continue;
+        char path[1024];
+        snprintf(path, sizeof(path), "%s%s%s", dir, PATH_SEPARATOR, ent->d_name);
+        const int fd = open(path, O_RDONLY);
+        if (fd < 0) continue;
+        char buf[65536];
+        const ssize_t r = pread(fd, buf, sizeof(buf), 0);
+        close(fd);
+        if (r > 0 && memmem(buf, (size_t)r, key, strlen(key)) != NULL) found = 1;
+    }
+    closedir(d);
+    return found;
+}
+
+#define WF_INTERVAL_US 50000u
+#define WF_SCHED_US    20000u /* allowance for the ticker thread being scheduled late */
+
+/* sync-interval: a commit waits for its record to reach the file, and that wait does not sit out
+ * the gathering window -- the waiter asks for the flush. the interval tick's fsync barrier
+ * likewise, and the database's WAL is synced within the interval (plus the batching window and a
+ * scheduling allowance) of a commit */
+static void test_interval_mode_still_syncs(void)
+{
+    /* the block manager half: a durable append and a barrier on a ten-second gathering window */
+    uint64_t fl = 0;
+    block_manager_t *bm = wf_open_gathering(&fl);
+    const unsigned char payload[32] = {1};
+    block_manager_block_t block = {
+        .size = sizeof(payload), .data = (void *)payload, .inline_data = 0};
+    uint64_t from = tdb_monotonic_us();
+    int64_t off = block_manager_block_write_durable(bm, &block);
+    uint64_t took = tdb_monotonic_us() - from;
+    ASSERT_TRUE(off >= 0);
+    ASSERT_TRUE(wf_flushed(bm) >= (uint64_t)off + block_manager_framed_size(sizeof(payload)));
+    printf("(durable append %llu us, ", (unsigned long long)took);
+    ASSERT_TRUE(took < 1000000);
+
+    ASSERT_TRUE(WF_POLL(atomic_load(&bm->flush_sleeping) == BM_FLUSH_GATHERING, 2000000) !=
+                UINT64_MAX);
+#if WF_OBSERVABLE
+    atomic_store(&g_written_end, 0);
+    atomic_store(&g_synced_end, 0);
+    atomic_store(&g_watch_fd, bm->fd);
+#endif
+    off = block_manager_write_raw(bm, payload, sizeof(payload));
+    ASSERT_TRUE(off >= 0);
+    const uint64_t end = (uint64_t)off + block_manager_framed_size(sizeof(payload));
+    from = tdb_monotonic_us();
+    ASSERT_EQ(block_manager_escalate_fsync(bm), 0);
+    took = tdb_monotonic_us() - from;
+    ASSERT_TRUE(wf_flushed(bm) >= end);
+#if WF_OBSERVABLE
+    ASSERT_TRUE(atomic_load(&g_synced_end) >= end);
+    atomic_store(&g_watch_fd, -1);
+#endif
+    printf("barrier %llu us, ", (unsigned long long)took);
+    ASSERT_TRUE(took < 1000000);
+    ASSERT_EQ(block_manager_close(bm), 0);
+    (void)remove(WF_FILE);
+
+    /* the database half */
+    (void)remove_directory(WF_DB_DIR);
+    tidesdb_config_t cfg = tidesdb_default_config();
+    cfg.db_path = WF_DB_DIR;
+    cfg.memtable_sync_mode = TDB_SYNC_INTERVAL;
+    cfg.memtable_sync_interval_us = WF_INTERVAL_US;
+    tidesdb_t *db = NULL;
+    ASSERT_EQ(tidesdb_open(&cfg, &db), TDB_SUCCESS);
+    tidesdb_column_family_config_t cc = tidesdb_default_column_family_config();
+    ASSERT_EQ(tidesdb_create_column_family(db, "cf0", &cc), TDB_SUCCESS);
+    tidesdb_column_family_t *cf = tidesdb_get_column_family(db, "cf0");
+    ASSERT_TRUE(cf != NULL);
+
+    for (int i = 0; i < 5; i++)
+    {
+        char key[32];
+        snprintf(key, sizeof(key), "wal-flusher-key-%d", i);
+#if WF_OBSERVABLE
+        const uint64_t syncs_before = atomic_load(&g_wal_sync_count);
+        atomic_store(&g_watch_wal_syncs, 1);
+#endif
+        tidesdb_txn_t *txn = NULL;
+        ASSERT_EQ(tidesdb_txn_begin(db, &txn), TDB_SUCCESS);
+        ASSERT_EQ(tidesdb_txn_put(txn, cf, (const uint8_t *)key, strlen(key), (const uint8_t *)"v",
+                                  1, -1),
+                  TDB_SUCCESS);
+        ASSERT_EQ(tidesdb_txn_commit(txn), TDB_SUCCESS);
+        const uint64_t committed = tdb_monotonic_us();
+        tidesdb_txn_free(txn);
+        /* the commit returned, so its record is in the file already, not only in the ring */
+        ASSERT_TRUE(wf_logs_hold(WF_DB_DIR, key));
+#if WF_OBSERVABLE
+        const uint64_t synced = WF_POLL(atomic_load(&g_wal_sync_count) > syncs_before &&
+                                            atomic_load(&g_wal_sync_last_us) >= committed,
+                                        2 * (WF_INTERVAL_US + BM_BUF_GATHER_US + WF_SCHED_US));
+        atomic_store(&g_watch_wal_syncs, 0);
+        if (i == 0) printf("WAL synced %llu us after a commit) ", (unsigned long long)synced);
+        ASSERT_TRUE(synced <= WF_INTERVAL_US + BM_BUF_GATHER_US + WF_SCHED_US);
+#else
+        (void)committed;
+        if (i == 0) printf("WAL sync timing not observable in this build) ");
+#endif
+    }
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(WF_DB_DIR);
+}
+
+int main(int argc, char **argv)
+{
+    INIT_TEST_FILTER(argc, argv);
+    wf_interpose_init();
+    RUN_TEST(test_no_wake_per_append_in_sync_none, tests_passed);
+    RUN_TEST(test_watermark_drains, tests_passed);
+    RUN_TEST(test_full_mode_still_durable, tests_passed);
+    RUN_TEST(test_interval_mode_still_syncs, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
