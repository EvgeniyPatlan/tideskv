+#define SP_MANY_KEYS  50000
+#define SP_MANY_SEEKS 1000
+
+static void test_cursor_both_ways_many_leaves(void)
+{
+    char(*keys)[SP_KEY_MAX] = malloc(SP_MANY_KEYS * sizeof(*keys));
+    ASSERT_TRUE(keys != NULL);
+    uint8_t value[200];
+    for (size_t i = 0; i < sizeof(value); i++) value[i] = (uint8_t)(i * 31 + 7);
+
+    for (int mi = 0; mi < 2; mi++)
+    {
+        const sp_mode_t *m = &g_modes[mi];
+        sp_fresh_dir();
+        block_manager_t *bm = NULL;
+        ASSERT_EQ(block_manager_open(&bm, SP_KLOG, BLOCK_MANAGER_SYNC_NONE), 0);
+        const btree_config_t cfg = sp_config(m, BTREE_DEFAULT_NODE_SIZE);
+        btree_builder_t *b = NULL;
+        ASSERT_EQ(btree_builder_new(&b, bm, &cfg), 0);
+
+        /* even keys only, so a seek to an odd one has to land on the next even one */
+        srand(20261110);
+        for (uint64_t i = 0; i < SP_MANY_KEYS; i++)
+        {
+            const size_t ks = sp_key(keys[i], i * 2);
+            const size_t vs = 10 + (size_t)(rand() % 191);
+            ASSERT_EQ(btree_builder_add(b, (uint8_t *)keys[i], ks, value, vs, 0, i + 1, 0, 0), 0);
+        }
+        btree_t *tree = NULL;
+        ASSERT_EQ(btree_builder_finish(b, &tree), 0);
+        ASSERT_TRUE(sp_check_links(tree, m) > 100);
+
+        sp_expect_scan(tree, keys, SP_MANY_KEYS, 0);
+        sp_expect_scan(tree, keys, SP_MANY_KEYS, 1);
+
+        btree_cursor_t *c = NULL;
+        ASSERT_EQ(btree_cursor_init(&c, tree), 0);
+        for (int s = 0; s < SP_MANY_SEEKS; s++)
+        {
+            const uint64_t i = (uint64_t)rand() % SP_MANY_KEYS;
+            const int odd = rand() % 2;
+            if (odd && i == SP_MANY_KEYS - 1) continue; /* past the last key */
+            char target[SP_KEY_MAX];
+            const size_t ts = sp_key(target, i * 2 + (uint64_t)odd);
+            ASSERT_EQ(btree_cursor_seek(c, (uint8_t *)target, ts), 0);
+            ASSERT_EQ(btree_cursor_valid(c), 1);
+            uint8_t *k = NULL, *v = NULL;
+            size_t ks = 0, vs = 0;
+            uint64_t vlog = 0, seq = 0;
+            int64_t ttl = 0;
+            uint8_t del = 0;
+            ASSERT_EQ(btree_cursor_get(c, &k, &ks, &v, &vs, &vlog, &seq, &ttl, &del), 0);
+            const uint64_t want = i + (uint64_t)odd;
+            ASSERT_EQ(ks, strlen(keys[want]));
+            ASSERT_EQ(memcmp(k, keys[want], ks), 0);
+            ASSERT_EQ(seq, want + 1);
+        }
+        btree_cursor_free(c);
+
+        btree_free(tree);
+        btree_builder_free(b);
+        (void)block_manager_close(bm);
+    }
+    free(keys);
+    (void)remove_directory(SP_DIR);
+}
