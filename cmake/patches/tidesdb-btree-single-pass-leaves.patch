+        const btree_config_t cfg = sp_config(m, 512);
+        btree_builder_t *b = NULL;
+        ASSERT_EQ(btree_builder_new(&b, bm, &cfg), 0);
+
+        uint8_t value[64];
+        memset(value, 'v', sizeof(value));
+        uint64_t i = 0;
+        while (b->node_count < 200)
+        {
+            /* a batch, then look: neither a staging file nor anything else may sit beside the klog
+             * while the build runs */
+            for (int j = 0; j < 25; j++, i++)
+            {
+                char key[SP_KEY_MAX];
+                const size_t ks = sp_key(key, i);
+                ASSERT_EQ(
+                    btree_builder_add(b, (uint8_t *)key, ks, value, sizeof(value), 0, i + 1, 0, 0),
+                    0);
+            }
+            int stage = 0, other = 0;
+            sp_scan_dir(&stage, &other);
+            if (stage != 0)
+                printf("\n  %s: staging file beside the klog after %" PRIu64 " keys\n", m->name, i);
+            ASSERT_EQ(stage, 0);
+            ASSERT_EQ(other, 0);
+        }
+
+        btree_t *tree = NULL;
+        ASSERT_EQ(btree_builder_finish(b, &tree), 0);
+        int stage = 0, other = 0;
+        sp_scan_dir(&stage, &other);
+        ASSERT_EQ(stage, 0);
