+static size_t sp_key(char *buf, uint64_t i)
+{
+    return (size_t)snprintf(buf, SP_KEY_MAX, "k%010" PRIu64, i);
+}
+
+/* one leaf as it sits on disk: its links, its framed length in the file, and its plaintext with
+ * the links zeroed so two layouts of the same entries can be compared byte for byte */
+typedef struct
+{
+    int64_t prev;
+    int64_t next;
+    uint64_t framed;
+    uint8_t *plain;
+    size_t plain_size;
+} sp_leaf_t;
+
+static void sp_zero_plain_links(uint8_t *plain, size_t plain_size, int64_t *prev, int64_t *next)
+{
+    ASSERT_TRUE(plain_size > BTREE_NODE_TYPE_BYTES);
+    ASSERT_EQ(plain[0], BTREE_NODE_LEAF);
+    uint64_t num_entries = 0;
+    const size_t adv = btree_varint_decode_bounded(plain + BTREE_NODE_TYPE_BYTES,
+                                                   plain + plain_size, &num_entries);
+    ASSERT_TRUE(adv > 0);
+    const size_t pos = BTREE_NODE_TYPE_BYTES + adv;
+    ASSERT_TRUE(pos + BTREE_LEAF_LINK_PATCH_BYTES <= plain_size);
+    if (prev) *prev = decode_int64_le_compat(plain + pos);
+    if (next) *next = decode_int64_le_compat(plain + pos + BTREE_LEAF_LINK_BYTES);
+    memset(plain + pos, 0, BTREE_LEAF_LINK_PATCH_BYTES);
+}
+
+static void sp_read_leaf(block_manager_t *bm, const sp_mode_t *m, int64_t off, sp_leaf_t *out)
+{
+    uint8_t *data = NULL;
+    uint32_t size = 0;
+    ASSERT_EQ(block_manager_read_block_data_at_offset(bm, (uint64_t)off, &data, &size), 0);
+    out->framed = block_manager_framed_size(size);
+    if (m->codec_count > 0)
+    {
+        ASSERT_TRUE(size > BTREE_COMPRESSED_NODE_HEADER_SIZE);
+        out->prev = decode_int64_le_compat(data + BTREE_COMPRESSED_NODE_PREV_OFF);
+        out->next = decode_int64_le_compat(data + BTREE_COMPRESSED_NODE_NEXT_OFF);
+        ASSERT_EQ(tidesdb_encoding_stages_decode(
+                      m->codec, m->codec_count, data + BTREE_COMPRESSED_NODE_HEADER_SIZE,
+                      size - BTREE_COMPRESSED_NODE_HEADER_SIZE, &out->plain, &out->plain_size),
+                  TDB_SUCCESS);
+        ASSERT_EQ(out->plain_size, decode_uint32_le_compat(data));
+        free(data);
+        sp_zero_plain_links(out->plain, out->plain_size, NULL, NULL);
+    }
+    else
+    {
+        out->plain = data;
+        out->plain_size = size;
+        sp_zero_plain_links(out->plain, out->plain_size, &out->prev, &out->next);
+    }
+}
+
+/* walk the leaf chain from the first leaf, checking every link against the layout: each leaf
+ * starts where the one before it ends, prev names the one before, and the last says there is no
+ * next. returns the number of leaves */
+static uint32_t sp_check_links(const btree_t *tree, const sp_mode_t *m)
+{
+    uint32_t leaves = 0;
+    int64_t off = tree->first_leaf_offset;
+    int64_t prev_off = BTREE_LEAF_LINK_NONE;
+    ASSERT_TRUE(off >= 0);
+    for (;;)
+    {
+        sp_leaf_t leaf;
+        sp_read_leaf(tree->bm, m, off, &leaf);
+        free(leaf.plain);
+        ASSERT_EQ(leaf.prev, prev_off);
+        leaves++;
+        if (leaf.next == BTREE_LEAF_LINK_NONE)
+        {
+            ASSERT_EQ(off, tree->last_leaf_offset);
+            break;
+        }
+        ASSERT_EQ(leaf.next, off + (int64_t)leaf.framed);
+        prev_off = off;
+        off = leaf.next;
+    }
+    return leaves;
+}
+
+/* every entry the cursor yields in one direction, checked against the expected keys */
+static void sp_expect_scan(btree_t *tree, char (*keys)[SP_KEY_MAX], uint64_t n, int backward)
+{
+    btree_cursor_t *c = NULL;
+    ASSERT_EQ(btree_cursor_init(&c, tree), 0);
+    ASSERT_EQ(backward ? btree_cursor_goto_last(c) : btree_cursor_goto_first(c), 0);
+    uint64_t seen = 0;
+    while (btree_cursor_valid(c) == 1)
+    {
+        uint8_t *k = NULL, *v = NULL;
+        size_t ks = 0, vs = 0;
+        uint64_t vlog = 0, seq = 0;
+        int64_t ttl = 0;
+        uint8_t del = 0;
+        ASSERT_EQ(btree_cursor_get(c, &k, &ks, &v, &vs, &vlog, &seq, &ttl, &del), 0);
+        ASSERT_TRUE(seen < n);
+        const uint64_t want = backward ? n - 1 - seen : seen;
+        ASSERT_EQ(ks, strlen(keys[want]));
+        ASSERT_EQ(memcmp(k, keys[want], ks), 0);
+        ASSERT_EQ(seq, want + 1);
+        seen++;
+        if ((backward ? btree_cursor_prev(c) : btree_cursor_next(c)) != 0) break;
+    }
+    ASSERT_EQ(seen, n);
+    ASSERT_EQ(btree_cursor_read_failed(c), 0);
+    btree_cursor_free(c);
+}
