+static void test_links_are_contiguous(void)
+{
+    /* node sizes from one that holds a few entries to the default, so leaf counts range from many
+     * to two */
+    const size_t node_sizes[] = {128, 512, 4096};
+    const uint64_t counts[] = {2000, 2000, 120};
+    for (int mi = 0; mi < 2; mi++)
+    {
+        const sp_mode_t *m = &g_modes[mi];
+        for (size_t s = 0; s < sizeof(node_sizes) / sizeof(node_sizes[0]); s++)
+        {
+            sp_fresh_dir();
+            block_manager_t *bm = NULL;
+            ASSERT_EQ(block_manager_open(&bm, SP_KLOG, BLOCK_MANAGER_SYNC_NONE), 0);
+            const btree_config_t cfg = sp_config(m, node_sizes[s]);
+            btree_builder_t *b = NULL;
+            ASSERT_EQ(btree_builder_new(&b, bm, &cfg), 0);
+            uint8_t value[48];
+            memset(value, 'x', sizeof(value));
+            for (uint64_t i = 0; i < counts[s]; i++)
+            {
+                char key[SP_KEY_MAX];
+                const size_t ks = sp_key(key, i);
+                ASSERT_EQ(
+                    btree_builder_add(b, (uint8_t *)key, ks, value, sizeof(value), 0, i + 1, 0, 0),
