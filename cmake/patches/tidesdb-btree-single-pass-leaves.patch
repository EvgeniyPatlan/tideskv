+/* the fixture's input: tombstones, entries with a ttl and a vlog reference among plain ones */
+static void sp_fixture_entry(int i, char *key, size_t *ks, uint8_t *value, size_t *vs,
+                             uint64_t *vlog, int64_t *ttl, uint8_t *flags)
+{
+    *ks = (size_t)snprintf(key, SP_KEY_MAX, "fx%05d", i);
+    *vs = (size_t)snprintf((char *)value, 64, "value-%05d-%.*s", i, i % 23,
+                           "abcdefghijklmnopqrstuvw");
+    *vlog = (i % 13 == 5) ? (uint64_t)(1000 + i) : 0;
+    *ttl = (i % 7 == 3) ? (int64_t)(1700000000 + i) : 0;
+    *flags = (i % 11 == 4) ? BTREE_ENTRY_FLAG_TOMBSTONE : 0;
+}
+
+static btree_t *sp_build_fixture_input(block_manager_t *bm, btree_builder_t **out_builder)
+{
+    const btree_config_t cfg = sp_config(&g_modes[0], SP_FIXTURE_NODE_SIZE);
+    btree_builder_t *b = NULL;
+    ASSERT_EQ(btree_builder_new(&b, bm, &cfg), 0);
+    for (int i = 0; i < SP_FIXTURE_ENTRIES; i++)
+    {
+        char key[SP_KEY_MAX];
+        uint8_t value[64];
+        size_t ks, vs;
+        uint64_t vlog;
+        int64_t ttl;
+        uint8_t flags;
+        sp_fixture_entry(i, key, &ks, value, &vs, &vlog, &ttl, &flags);
+        ASSERT_EQ(btree_builder_add(b, (uint8_t *)key, ks, value, vs, vlog, (uint64_t)(i + 1), ttl,
+                                    flags),
+                  0);
+    }
+    btree_t *tree = NULL;
+    ASSERT_EQ(btree_builder_finish(b, &tree), 0);
+    *out_builder = b;
+    return tree;
+}
+
+/* every entry of two trees, in order, compared field by field */
+static void sp_expect_same_entries(btree_t *a, btree_t *b)
+{
+    btree_cursor_t *ca = NULL, *cb = NULL;
+    ASSERT_EQ(btree_cursor_init(&ca, a), 0);
+    ASSERT_EQ(btree_cursor_init(&cb, b), 0);
+    ASSERT_EQ(btree_cursor_goto_first(ca), 0);
+    ASSERT_EQ(btree_cursor_goto_first(cb), 0);
+    int n = 0;
+    while (btree_cursor_valid(ca) == 1)
+    {
+        ASSERT_EQ(btree_cursor_valid(cb), 1);
+        uint8_t *ka, *va, *kb, *vb;
+        size_t ksa, vsa, ksb, vsb;
+        uint64_t la, sa, lb, sb;
+        int64_t ta, tb;
+        uint8_t da, db;
+        ASSERT_EQ(btree_cursor_get(ca, &ka, &ksa, &va, &vsa, &la, &sa, &ta, &da), 0);
+        ASSERT_EQ(btree_cursor_get(cb, &kb, &ksb, &vb, &vsb, &lb, &sb, &tb, &db), 0);
+        ASSERT_EQ(ksa, ksb);
+        ASSERT_EQ(memcmp(ka, kb, ksa), 0);
+        ASSERT_EQ(vsa, vsb);
+        if (la == 0 && vsa > 0) ASSERT_EQ(memcmp(va, vb, vsa), 0);
+        ASSERT_EQ(la, lb);
+        ASSERT_EQ(sa, sb);
+        ASSERT_EQ(ta, tb);
+        ASSERT_EQ(da, db);
+        n++;
+        const int ra = btree_cursor_next(ca);
+        const int rb = btree_cursor_next(cb);
+        ASSERT_EQ(ra, rb);
+        if (ra != 0) break;
+    }
+    ASSERT_EQ(n, SP_FIXTURE_ENTRIES);
+    btree_cursor_free(ca);
+    btree_cursor_free(cb);
+}
+
+static void test_old_and_new_layouts_read_identically(void)
+{
+    sp_fresh_dir();
+    FILE *f = fopen(SP_KLOG_OLD, "wb");
+    ASSERT_TRUE(f != NULL);
+    ASSERT_EQ(fwrite(sp_fixture_klog, 1, sizeof(sp_fixture_klog), f), sizeof(sp_fixture_klog));
+    ASSERT_EQ(fclose(f), 0);
+
+    block_manager_t *old_bm = NULL;
+    ASSERT_EQ(block_manager_open(&old_bm, SP_KLOG_OLD, BLOCK_MANAGER_SYNC_NONE), 0);
+    const btree_config_t cfg = sp_config(&g_modes[0], SP_FIXTURE_NODE_SIZE);
+    btree_t *old_tree = NULL;
+    ASSERT_EQ(btree_open(&old_tree, old_bm, &cfg, sp_fixture_root_offset,
+                         sp_fixture_first_leaf_offset, sp_fixture_last_leaf_offset),
+              0);
+
+    block_manager_t *new_bm = NULL;
+    ASSERT_EQ(block_manager_open(&new_bm, SP_KLOG, BLOCK_MANAGER_SYNC_NONE), 0);
+    btree_builder_t *nb = NULL;
+    btree_t *new_tree = sp_build_fixture_input(new_bm, &nb);
+    ASSERT_EQ(new_tree->entry_count, (uint64_t)SP_FIXTURE_ENTRIES);
+
+    /* both layouts hold well-formed contiguous chains of the same length */
+    const uint32_t old_leaves = sp_check_links(old_tree, &g_modes[0]);
+    const uint32_t new_leaves = sp_check_links(new_tree, &g_modes[0]);
+    ASSERT_EQ(old_leaves, new_leaves);
+    ASSERT_TRUE(old_leaves >= 3);
+
+    /* the same entries through the cursor and through point reads */
+    sp_expect_same_entries(old_tree, new_tree);
+    for (int i = 0; i < SP_FIXTURE_ENTRIES; i++)
+    {
+        char key[SP_KEY_MAX];
+        uint8_t value[64];
+        size_t ks, vs;
+        uint64_t vlog;
+        int64_t ttl;
+        uint8_t flags;
+        sp_fixture_entry(i, key, &ks, value, &vs, &vlog, &ttl, &flags);
+        btree_t *trees[2] = {old_tree, new_tree};
+        for (int t = 0; t < 2; t++)
+        {
+            uint8_t *v = NULL;
+            size_t gvs = 0;
+            uint64_t gvlog = 0, seq = 0;
+            int64_t gttl = 0;
+            uint8_t del = 0;
+            ASSERT_EQ(btree_get(trees[t], (uint8_t *)key, ks, &v, &gvs, &gvlog, &seq, &gttl, &del),
+                      0);
+            ASSERT_EQ(seq, (uint64_t)(i + 1));
+            ASSERT_EQ(gvlog, vlog);
+            ASSERT_EQ(gttl, ttl);
+            ASSERT_EQ(del != 0, flags != 0);
+            if (vlog == 0)
+            {
+                ASSERT_EQ(gvs, vs);
+                ASSERT_EQ(memcmp(v, value, vs), 0);
+            }
+            free(v);
+        }
+    }
+
+    /* leaf by leaf, the decoded payloads are the same bytes apart from the links. the old builder
+     * left the staging file's offsets in the plaintext links, so those differ by design; readers
+     * take the links from the block header */
+    int64_t oo = old_tree->first_leaf_offset;
+    int64_t no = new_tree->first_leaf_offset;
+    for (uint32_t i = 0; i < old_leaves; i++)
+    {
+        sp_leaf_t ol, nl;
+        sp_read_leaf(old_bm, &g_modes[0], oo, &ol);
+        sp_read_leaf(new_bm, &g_modes[0], no, &nl);
+        ASSERT_EQ(ol.plain_size, nl.plain_size);
+        ASSERT_EQ(memcmp(ol.plain, nl.plain, ol.plain_size), 0);
+        free(ol.plain);
+        free(nl.plain);
+        oo = ol.next;
+        no = nl.next;
+    }
+    ASSERT_EQ(oo, BTREE_LEAF_LINK_NONE);
+    ASSERT_EQ(no, BTREE_LEAF_LINK_NONE);
+
+    btree_free(old_tree);
+    btree_free(new_tree);
+    btree_builder_free(nb);
+    (void)block_manager_close(old_bm);
+    (void)block_manager_close(new_bm);
+    (void)remove_directory(SP_DIR);
+}
+
+static void test_failed_build_leaves_no_output(void)
+{
+    for (int mi = 0; mi < 2; mi++)
+    {
+        const sp_mode_t *m = &g_modes[mi];
+        sp_fresh_dir();
+        block_manager_t *bm = NULL;
+        ASSERT_EQ(block_manager_open(&bm, SP_KLOG, BLOCK_MANAGER_SYNC_NONE), 0);
+        const btree_config_t cfg = sp_config(m, 512);
+        btree_builder_t *b = NULL;
+        ASSERT_EQ(btree_builder_new(&b, bm, &cfg), 0);
+
+        uint8_t value[64];
+        memset(value, 'f', sizeof(value));
+        int failed = 0;
+        int broken = 0;
+        for (uint64_t i = 0; i < 5000 && !failed; i++)
+        {
+            /* once five leaves are built, every write to the klog fails: its descriptor now names
+             * a file opened read only */
+            if (!broken && b->node_count >= 5)
+            {
+                const int ro = open("/dev/null", O_RDONLY);
+                ASSERT_TRUE(ro >= 0);
+                ASSERT_TRUE(dup2(ro, bm->fd) == bm->fd);
+                (void)close(ro);
+                broken = 1;
+            }
+            char key[SP_KEY_MAX];
+            const size_t ks = sp_key(key, i);
+            if (btree_builder_add(b, (uint8_t *)key, ks, value, sizeof(value), 0, i + 1, 0, 0) != 0)
+                failed = 1;
+        }
+        ASSERT_TRUE(broken);
+        btree_t *tree = NULL;
+        if (!failed)
+        {
+            ASSERT_EQ(btree_builder_finish(b, &tree), -1);
+            failed = 1;
+        }
+        ASSERT_TRUE(tree == NULL);
+        btree_builder_free(b);
+
+        /* the builder leaves nothing of its own behind, so dropping the klog, as the flush and
+         * compaction drivers do on a failed build, leaves the directory empty */
+        int stage = 0, other = 0;
+        sp_scan_dir(&stage, &other);
+        ASSERT_EQ(stage, 0);
+        ASSERT_EQ(other, 0);
+        (void)block_manager_close(bm);
+        ASSERT_EQ(remove(SP_KLOG), 0);
+        DIR *d = opendir(SP_DIR);
+        ASSERT_TRUE(d != NULL);
+        int entries = 0;
+        struct dirent *e;
+        while ((e = readdir(d)) != NULL)
+            if (strcmp(e->d_name, ".") != 0 && strcmp(e->d_name, "..") != 0) entries++;
+        closedir(d);
+        ASSERT_EQ(entries, 0);
+    }
+    (void)remove_directory(SP_DIR);
+}
+
+/* write the fixture header: the klog bytes of the fixture input as this tree's builder lays them
+ * out, and the offsets a reader opens it with. run only on a tree without single-pass leaves */
+static int sp_write_fixture(const char *out_path)
+{
+    sp_fresh_dir();
+    block_manager_t *bm = NULL;
+    ASSERT_EQ(block_manager_open(&bm, SP_KLOG, BLOCK_MANAGER_SYNC_NONE), 0);
+    btree_builder_t *b = NULL;
+    btree_t *tree = sp_build_fixture_input(bm, &b);
+    const int64_t root = tree->root_offset, first = tree->first_leaf_offset,
+                  last = tree->last_leaf_offset;
+    btree_free(tree);
+    btree_builder_free(b);
+    (void)block_manager_close(bm);
+
+    FILE *in = fopen(SP_KLOG, "rb");
+    ASSERT_TRUE(in != NULL);
+    FILE *out = fopen(out_path, "w");
+    ASSERT_TRUE(out != NULL);
+    fprintf(
+        out,
+        "/* generated by btree_single_pass__tests --write-fixture on the tree before\n"
+        " * tidesdb-btree-single-pass-leaves.patch: %d entries, lz4, node size %d. do not edit */\n"
+        "#ifndef BTREE_LZ4_STAGED_LAYOUT_H\n#define BTREE_LZ4_STAGED_LAYOUT_H\n\n"
+        "#include <stdint.h>\n\n",
+        SP_FIXTURE_ENTRIES, SP_FIXTURE_NODE_SIZE);
+    fprintf(out, "static const int64_t sp_fixture_root_offset = %" PRId64 ";\n", root);
+    fprintf(out, "static const int64_t sp_fixture_first_leaf_offset = %" PRId64 ";\n", first);
+    fprintf(out, "static const int64_t sp_fixture_last_leaf_offset = %" PRId64 ";\n\n", last);
+    fprintf(out, "static const unsigned char sp_fixture_klog[] = {");
+    int c;
+    size_t n = 0;
+    while ((c = fgetc(in)) != EOF)
+    {
+        fprintf(out, "%s0x%02x", n == 0 ? "\n    " : (n % 12 == 0 ? ",\n    " : ", "), c);
+        n++;
+    }
+    fprintf(out, "};\n\n#endif\n");
+    fclose(in);
+    ASSERT_EQ(fclose(out), 0);
+    (void)remove_directory(SP_DIR);
+    printf("wrote %zu bytes of klog to %s\n", n, out_path);
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    ASSERT_TRUE(sp_init_codecs());
+    if (argc > 2 && strcmp(argv[1], "--write-fixture") == 0) return sp_write_fixture(argv[2]);
+    INIT_TEST_FILTER(argc, argv);
+    RUN_TEST(test_no_stage_file, tests_passed);
+    RUN_TEST(test_one_leaf_table, tests_passed);
+    RUN_TEST(test_cursor_both_ways_many_leaves, tests_passed);
+    RUN_TEST(test_links_are_contiguous, tests_passed);
+    RUN_TEST(test_old_and_new_layouts_read_identically, tests_passed);
+    RUN_TEST(test_failed_build_leaves_no_output, tests_passed);
+    PRINT_TEST_RESULTS(tests_passed, tests_failed);
+    return tests_failed > 0 ? 1 : 0;
+}
