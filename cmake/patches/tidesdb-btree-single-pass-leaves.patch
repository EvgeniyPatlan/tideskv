+/* how many files the scratch directory holds besides the klog, and how many of them are leaf
+ * staging files */
+static void sp_scan_dir(int *stage_files, int *other_files)
+{
+    *stage_files = 0;
+    *other_files = 0;
+    DIR *d = opendir(SP_DIR);
+    ASSERT_TRUE(d != NULL);
+    const size_t ext_len = strlen(TDB_SSTABLE_KLOG_STAGE_EXT);
+    struct dirent *e;
+    while ((e = readdir(d)) != NULL)
+    {
+        if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
+        if (strcmp(e->d_name, "1.klog") == 0) continue;
+        const size_t len = strlen(e->d_name);
+        if (len >= ext_len && strcmp(e->d_name + len - ext_len, TDB_SSTABLE_KLOG_STAGE_EXT) == 0)
+            (*stage_files)++;
+        else
+            (*other_files)++;
+    }
+    closedir(d);
+}
