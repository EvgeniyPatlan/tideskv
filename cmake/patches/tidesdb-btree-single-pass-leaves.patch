+static int sp_init_codecs(void)
+{
+    if (tidesdb_encoding_registry_init(&g_reg) != TDB_SUCCESS) return 0;
+    const uint8_t lz4[1] = {TDB_COMPRESS_LZ4};
+    if (tidesdb_encoding_resolve(&g_reg, lz4, 1, g_lz4, 1) != 1) return 0;
+    g_modes[0] = (sp_mode_t){"lz4", g_lz4, 1};
+    g_modes[1] = (sp_mode_t){"none", NULL, 0};
+    return 1;
+}
