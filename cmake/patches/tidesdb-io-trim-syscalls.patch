  * extending writes serialize on the per-inode lock (e.g., ext4 i_rwsem) regardless
  * of disjoint offsets, so preallocation happens in chunks and pwrites land in-place. */
 #define BLOCK_MANAGER_PREALLOC_CHUNK (64ull * 1024 * 1024) /* extend by 64 MB at a time */
+/* the unit a sized preallocation rounds up to */
+#define BLOCK_MANAGER_PREALLOC_UNIT (1024ull * 1024)
+
+/**
+ * block_manager_prealloc_round
+ * the preallocation chunk for a file expected to reach expected bytes: that rounded up to a whole
+ * BLOCK_MANAGER_PREALLOC_UNIT and held to BLOCK_MANAGER_PREALLOC_CHUNK, so an output reserves about
+ * what it will write rather than the full default extent. 0 gives the default chunk
+ * @param expected the bytes the file is expected to reach
+ * @return the chunk to pass to block_manager_open_pre
+ */
+static inline uint64_t block_manager_prealloc_round(const uint64_t expected)
+{
+    if (expected == 0 || expected > BLOCK_MANAGER_PREALLOC_CHUNK)
+        return BLOCK_MANAGER_PREALLOC_CHUNK;
+    return (expected + BLOCK_MANAGER_PREALLOC_UNIT - 1) / BLOCK_MANAGER_PREALLOC_UNIT *
+           BLOCK_MANAGER_PREALLOC_UNIT;
+}
