+        ASSERT_EQ(tidesdb_txn_delete(t, cf, (const uint8_t *)key, strlen(key)), TDB_SUCCESS);
+        ASSERT_EQ(tidesdb_txn_commit(t), TDB_SUCCESS);
+        tidesdb_txn_free(t);
+    }
+
+    /* the scan pins the memtable, which the flush then retires behind it */
+    tidesdb_txn_t *rt = NULL;
+    ASSERT_EQ(tidesdb_txn_begin(db, &rt), TDB_SUCCESS);
+    tidesdb_iter_t *it = NULL;
+    ASSERT_EQ(tidesdb_iter_new(rt, cf, &it), TDB_SUCCESS);
+    ASSERT_EQ(tidesdb_iter_seek_to_first(it), TDB_SUCCESS);
+    ASSERT_EQ(tidesdb_flush_memtable(db), TDB_SUCCESS);
+    tidesdb_l0_reclaim_pending(db->l0); /* a sweep while the scan holds the memtable */
+
+    /* the pass marks the shared segments drainable, a compaction rewrites the A values out of them
+     * and retires the flushed table, which no reader holds, and the next pass finds them unnamed */
+    engine_vlog_gc(db);
+    engine_test_put_one(db, cf, "z", 0, buf, alen, 'Z');
+    ASSERT_EQ(tidesdb_flush_memtable(db), TDB_SUCCESS);
+    ASSERT_EQ(engine_test_compact(db, cf), TDB_SUCCESS);
+    tidesdb_db_stats_t st;
+    ASSERT_EQ(tidesdb_get_db_stats(db, &st), TDB_SUCCESS);
+    const uint64_t retired_before = st.vlog_segments_retired;
+    engine_vlog_gc(db);
+
+    int seen_a = 0;
+    while (tidesdb_iter_valid(it))
+    {
+        uint8_t *k = NULL, *v = NULL;
+        size_t ks = 0, vs = 0;
+        ASSERT_EQ(tidesdb_iter_key(it, &k, &ks), TDB_SUCCESS);
+        ASSERT_EQ(tidesdb_iter_value(it, &v, &vs), TDB_SUCCESS);
+        ASSERT_TRUE(ks > 0 && v != NULL);
+        if (k[0] == 'a')
+        {
+            memset(buf, 'A', alen);
+            ASSERT_EQ((int)vs, (int)alen);
+            ASSERT_TRUE(memcmp(v, buf, alen) == 0);
+            seen_a++;
+        }
+        free(k);
+        free(v);
+        if (tidesdb_iter_next(it) != TDB_SUCCESS) break;
+    }
+    ASSERT_EQ(seen_a, n);
+    tidesdb_iter_free(it);
+    ASSERT_EQ(tidesdb_txn_commit(rt), TDB_SUCCESS);
+    tidesdb_txn_free(rt);
+
+    /* unpinned, the memtable's floor goes on the next sweep, and the pass after it drops the
+     * segments the rewrite emptied */
+    tidesdb_l0_reclaim_pending(db->l0);
+    engine_vlog_gc(db);
+    ASSERT_EQ(tidesdb_get_db_stats(db, &st), TDB_SUCCESS);
+    ASSERT_TRUE(st.vlog_segments_retired > retired_before);
+
+    free(buf);
+    ASSERT_EQ(tidesdb_close(db), TDB_SUCCESS);
+    (void)remove_directory(ENGINE_TEST_DB_DIR);
+}
